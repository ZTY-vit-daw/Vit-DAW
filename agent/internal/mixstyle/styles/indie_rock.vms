{
  "schema_version": "vit.mix_style.v1",
  "kind": "mix_style",
  "identity": {
    "id": "indie_rock",
    "name": "Indie Rock",
    "version": "1.0.0",
    "author": "Vit",
    "description": "Band-forward balance with audible harmonic body and natural movement.",
    "tags": [
      "rock",
      "indie",
      "band"
    ]
  },
  "compatibility": {
    "capability_contracts": {
      "static_mix.static_balance": "v1",
      "static_mix.pan_layout": "v1"
    }
  },
  "style_intent": {
    "density": "medium",
    "contrast": "medium",
    "center_focus": "rhythm_and_lead",
    "symmetry": "organic",
    "conservatism": "medium"
  },
  "capabilities": {
    "static_balance": {
      "schema_version": "vit.mix_style.static_balance.v1",
      "foreground_priority": 0.25,
      "rhythm_anchor_weight": 0.65,
      "low_end_anchor_weight": 0.25,
      "harmonic_bed_depth": 0.55,
      "support_layer_distance": -0.2,
      "transient_control_bias": -0.2,
      "density_clearance": 0.1,
      "natural_dynamic_tolerance": 0.75
    },
    "pan_layout": {
      "schema_version": "vit.mix_style.pan_layout.v1",
      "center_density": 0.62,
      "spread_amount": 0.68,
      "symmetry_bias": -0.08,
      "complementary_pair_bias": 0.72,
      "mono_safety": 0.82,
      "stereo_source_conservatism": 0.68,
      "support_layer_spread": 0.62,
      "rhythm_peripheral_allowance": 0.56
    }
  }
}
