 # 过滤（纯函数，探针直断面）
 # ==========================================
diff --git a/tools/probe_rack_sendroute_macro.gd b/tools/probe_rack_sendroute_macro.gd
index 44222d3..9f2449c 100644
--- a/tools/probe_rack_sendroute_macro.gd
+++ b/tools/probe_rack_sendroute_macro.gd
@@ -488,6 +488,7 @@ func _run_scene_suite() -> void:
 	_check("k31 sidebar reapply knob queues set_node_value", bool(rack.vit_sidebar_reapply_control_node("ctrl_knob_1")) and _collect_cmds("control_set_node_value").size() == k31_before_node_apply + 1, "command not queued")
 	_check("k31 sidebar suggest empty without param surface", (rack.vit_sidebar_suggest_control_kind() as Dictionary).is_empty(), "suggest not empty")
 	_suite_k31_sidebar_adapter_contract()
+	_suite_k32_polish(rack)
 
 	# --- 场景 10：Track_Row FX 徽标契约面（3D 场景依赖，DOM 徽标归真栈腿） ---
 	var track_row_script: Variant = load(TRACK_ROW_CONTROLLER_PATH)
@@ -517,6 +518,150 @@ func _suite_k31_sidebar_adapter_contract() -> void:
 	_check("k31 adapter old three-choice constant removed", not source.contains("CONTROL_TYPE_CHOICES"), "old constant still present")
 
 
+## K3.2：复测反馈四点+UX 短板收口（FE-RACK-K32-POLISH-1）。
+## ①位号不渲染（frame 实例断言）②类型选择→payload.kind + 重建后 pref 保持
+## （ViewportFrame 按 view_type 缓存 view_state 的域内补链）③命名行确认按钮
+## ④语义说明在场 ⑤禁用原因 tooltip + send 失败可见反馈（信号/回滚）。
+func _suite_k32_polish(rack: Variant) -> void:
+	# --- K3.2 源码契约（轻量文本钉，防接线回退） ---
+	var adapter_src := FileAccess.get_file_as_string("res://vit_dock/views/graph_rack_dock_adapter.gd")
+	var frame_src := FileAccess.get_file_as_string("res://vit_dock/scenes/viewport_frame.gd")
+	var rack_src := FileAccess.get_file_as_string(RACK_SCRIPT_PATH)
+	var selector_src := FileAccess.get_file_as_string(SELECTOR_PATH)
+	_check("k32 contract adapter default kind unified const", adapter_src.contains("DEFAULT_RACK_CONTROL_KIND") and not adapter_src.contains('str(_view_state.get("rack_control_pref", "slider"))'), "default kind split")
+	_check("k32 contract frame no slot tag text", not frame_src.contains('"位%d"') and not frame_src.contains('位%d" %'), "slot tag text still set")
+	_check("k32 contract rack feedback signal", rack_src.contains("signal send_command_feedback"), "signal missing")
+	_check("k32 contract adapter wires feedback signal", adapter_src.contains("send_command_feedback"), "adapter not wired")
+	_check("k32 contract selector confirm button", selector_src.contains("创建并连接"), "button missing")
+
+	# --- K3.2①+②：ViewportFrame 实例腿（真 frame + 真 adapter 场景，headless 树） ---
+	var frame_scene: Variant = load("res://vit_dock/scenes/ViewportFrame.tscn")
+	if frame_scene == null:
+		_check("k32 frame scene loadable", false, "scene missing")
+		return
+	var frame: Variant = frame_scene.instantiate()
+	if frame == null:
+		_check("k32 frame instantiate", false, "instantiate failed")
+		return
+	frame.setup_from_payload({"viewport_id": "vp_k32", "view_type": "graph_rack", "context": {}})
+	_stage.add_child(frame)
+	var k32_adapter: Variant = frame._loaded_view
+	_check("k32 frame loads graph_rack adapter", k32_adapter != null and is_instance_valid(k32_adapter), "adapter missing")
+	if k32_adapter == null or not is_instance_valid(k32_adapter):
+		return
+
+	# ①位号：槽位头设置后位号文本为空且不可见，视图名+拉下仍在。
+	frame.set_stage_slot_header(1, "机架")
+	var slot_tag: Label = frame._slot_tag
+	var slot_header: Control = frame._slot_header
+	_check("k32 slot tag text empty", slot_tag != null and slot_tag.text.is_empty(), str(slot_tag.text if slot_tag != null else "<null>"))
+	_check("k32 slot tag hidden", slot_tag == null or not slot_tag.visible, "tag visible")
+	_check("k32 slot header still visible with label", slot_header != null and slot_header.visible and str(frame._view_label.text) == "机架", "header/label wrong")
+	frame.clear_stage_slot_header()
+
+	# ②UI 链：OptionButton 选 slider → pref；注入 ProbeRack → 创建 → payload.kind。
+	var k32_option: OptionButton = k32_adapter._rack_control_kind_option
+	var k32_slider_idx := -1
+	for i in range(k32_option.item_count):
+		if str(k32_option.get_item_metadata(i)) == "slider":
+			k32_slider_idx = i
+			break
+	_check("k32 slider item present", k32_slider_idx >= 0, "slider not in option list")
+	if k32_slider_idx >= 0:
+		k32_option.item_selected.emit(k32_slider_idx)
+		_check("k32 pref follows slider selection", str(k32_adapter._rack_control_pref) == "slider", str(k32_adapter._rack_control_pref))
+		var k32_rack2: Variant = _probe_rack_script.new()
+		k32_rack2.fake_client = _fake_client
+		_stage.add_child(k32_rack2)
+		k32_adapter._graph_rack = k32_rack2
+		var k32_before_add := _collect_cmds("control_add_node").size()
+		k32_adapter._on_sidebar_create_control_pressed()
+		var k32_add_cmds := _collect_cmds("control_add_node")
+		var k32_kind_ok := false
+		var k32_kind_detail := "no command"
+		if k32_add_cmds.size() > k32_before_add:
+			var k32_cmd: Dictionary = k32_add_cmds[k32_add_cmds.size() - 1]
+			k32_kind_ok = str(k32_cmd.get("kind", "")) == "slider"
+			k32_kind_detail = str(k32_cmd)
+		_check("k32 create control payload kind slider", k32_add_cmds.size() == k32_before_add + 1 and k32_kind_ok, k32_kind_detail)
+
+	# ②重建保持：frame 切走（空视图）再切回 → 新 adapter pref 仍 slider。
+	frame.activate_view("")
+	frame.activate_view("graph_rack", {})
+	var k32_adapter2: Variant = frame._loaded_view
+	_check("k32 adapter rebuilt after view roundtrip", k32_adapter2 != null and is_instance_valid(k32_adapter2) and k32_adapter2 != k32_adapter, "rebuild failed")
+	if k32_adapter2 != null and is_instance_valid(k32_adapter2):
+		_check("k32 pref survives adapter rebuild", str(k32_adapter2._rack_control_pref) == "slider", str(k32_adapter2._rack_control_pref))
+		var k32_option2: OptionButton = k32_adapter2._rack_control_kind_option
+		var k32_option2_meta := ""
+		if k32_option2 != null and k32_option2.selected >= 0:
+			k32_option2_meta = str(k32_option2.get_item_metadata(k32_option2.selected))
+		_check("k32 option UI synced after rebuild", k32_option2_meta == "slider", k32_option2_meta)
+
+	# ④+⑤A：语义说明在场；禁用原因 tooltip 与启用态语义 tooltip 切换。
+	var k32_semantics_found := false
+	for child in k32_adapter2._rack_tools_content.get_children():
+		if child is Label and str((child as Label).text).contains("宏=混排宏卡"):
+			k32_semantics_found = true
