diff --git a/app/rack/Vit_Graph_Rack.gd b/app/rack/Vit_Graph_Rack.gd
index cadb478..9c800d9 100644
--- a/app/rack/Vit_Graph_Rack.gd
+++ b/app/rack/Vit_Graph_Rack.gd
@@ -1,6 +1,8 @@
 extends GraphEdit
 
 signal plugin_tools_state_changed
+## K3.2⑤：send 创建失败/超时/回滚的用户可见反馈（adapter 转发到状态行；原静默）。
+signal send_command_feedback(message: String)
 
 const _RACK_LAYOUT_RULES_SCRIPT: Variant = preload("res://app/rack/rack_layout_rules.gd")
 const _RACK_NODE_DISPLAY_RULES_SCRIPT: Variant = preload("res://app/rack/rack_node_display_rules.gd")
@@ -2163,6 +2165,21 @@ func _apply_send_topology(topology: Dictionary, source_request_id: String = "")
 				break
 		if confirmed:
 			_pending_send_edges.erase(key)
+	# K3.2⑤：connect 回执已到但普通 send 边仍未确认 → 内核未接受该连接：
+	# 过渡显示立即回滚并给可见反馈（原静默留 TTL 自然消失）。
+	# auto_create（>new:）与侧链（send:sc:）的 pending key 与拓扑 key 不同构，
+	# 不参与该判定（沿用 TTL 兜底），避免把正常连接误报为失败。
+	if source_request_id.begins_with("track_send_connect"):
+		var rejected_keys: Array[String] = []
+		for key_variant in _pending_send_edges.keys():
+			var key := str(key_variant)
+			if key.begins_with("send:") and not key.begins_with("send:sc:") and not key.contains(">new:"):
+				rejected_keys.append(key)
+		if not rejected_keys.is_empty():
+			for key in rejected_keys:
+				_pending_send_edges.erase(key)
+			_rack_ipc_alert("发送连接未被内核确认（可能被拒绝），已回滚过渡显示")
+			_request_send_topology_refresh(true)
 	_expire_pending_send_edges()
 	queue_redraw()
 	# 连接类写回执到达 → aux 插件对需要 project state 刷新才会出现在画布。
@@ -2210,6 +2227,12 @@ func _on_send_control_ipc_timed_out(request_id: String, _cmd: Dictionary) -> voi
 		return
 	if request_id.begins_with("track_send"):
 		_send_topology_refresh_in_flight = false
+		# K3.2⑤：超时=明确失败信号——过渡显示立即回滚并给可见反馈（原静默）。
+		if not _pending_send_edges.is_empty():
+			var rolled_back := _pending_send_edges.size()
+			_pending_send_edges.clear()
+			queue_redraw()
+			_rack_ipc_alert("发送命令超时未回执，已回滚过渡显示（%d 条）" % rolled_back)
 		_expire_pending_send_edges()
 		queue_redraw()
 
@@ -2348,6 +2371,8 @@ func _rack_ipc_alert(message: String) -> void:
 		return
 	_rack_ipc_alert_last_msec = now
 	_rack_diag_log(message)
+	# K3.2⑤：用户可见反馈（原仅诊断日志，静默）。
+	send_command_feedback.emit(message)
 
 
 # ==========================================
diff --git a/app/rack/rack_send_target_selector.gd b/app/rack/rack_send_target_selector.gd
index d280e6c..992bab5 100644
