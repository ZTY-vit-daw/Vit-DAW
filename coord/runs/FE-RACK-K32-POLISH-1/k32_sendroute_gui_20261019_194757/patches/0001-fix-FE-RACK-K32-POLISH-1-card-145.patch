 var _name_edit: LineEdit
 var _name_row: HBoxContainer
+## K3.2③：命名行确认按钮（回车路径保留并存）。
+var _confirm_new_fx_button: Button
 var _rows: Array = []
 var _visible_rows: Array = []
 var _leaf_items: Array = []
@@ -77,6 +79,15 @@ func _ready() -> void:
 	_name_edit.placeholder_text = "Reverb Bus"
 	_name_edit.text_submitted.connect(_on_new_fx_name_submitted)
 	_name_row.add_child(_name_edit)
+	# K3.2③：显式确认按钮（原仅回车提交——用户复测反馈缺确认入口）。
+	_confirm_new_fx_button = Button.new()
+	_confirm_new_fx_button.text = "创建并连接"
+	_confirm_new_fx_button.custom_minimum_size = Vector2(0.0, 28.0)
+	_confirm_new_fx_button.focus_mode = Control.FOCUS_NONE
+	_confirm_new_fx_button.tooltip_text = "按左侧命名新建 FX 轨并连接发送（回车等效）"
+	VitUIButtonStyles.apply_paper_button(_confirm_new_fx_button, Vector2(0.0, 28.0), 11)
+	_confirm_new_fx_button.pressed.connect(_confirm_new_fx)
+	_name_row.add_child(_confirm_new_fx_button)
 	box.add_child(_name_row)
 
 	_footer_label = Label.new()
@@ -125,6 +136,11 @@ func new_fx_name() -> String:
 	return _name_edit.text.strip_edges() if _name_edit != null else ""
 
 
+## K3.2③：确认按钮探针面（存在性+pressed 触发断言）。
+func confirm_new_fx_button() -> Button:
+	return _confirm_new_fx_button
+
+
