+			_update_status_label(focus_text)
+
+
+func _on_existing_control_reapply_pressed(node_id: String) -> void:
+	if _graph_rack == null or not _graph_rack.has_method("vit_sidebar_reapply_control_node"):
+		_update_status_label("施加命令面不可用")
+		return
+	if _graph_rack.call("vit_sidebar_reapply_control_node", node_id) == true:
+		_update_status_label("已施加 %s（当前值重推）" % node_id)
+	else:
+		_update_status_label("施加 %s 失败" % node_id)
 
 
