 			return
 		if bi == MOUSE_BUTTON_RIGHT:
 			if mb.pressed:
-				_rack_begin_right_pan(mb.position, null, mb.position)
+				# K3.1①：popup_on_parent 实测吃主窗口 viewport 坐标（窗口态取证
