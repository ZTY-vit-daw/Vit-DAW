@@ -2228,9 +2231,13 @@ func _build_canvas_action_menu() -> void:
 
 func _open_canvas_action_menu(viewport_pos: Vector2) -> void:
 	_build_canvas_action_menu()
-	_canvas_action_menu_pos = viewport_pos
+	# K3.1①：坐标双轨——popup_on_parent 吃主窗口 viewport 坐标；下游三入口
+	# （装载插件弹窗/发送选择器/新建宏）吃 GraphEdit 局部坐标（锚点换算分流）。
+	var local_anchor: Vector2 = get_global_transform().affine_inverse() * viewport_pos
+	_canvas_action_menu_pos = local_anchor
 	_canvas_action_menu.reset_size()
-	var popup_rect := Rect2i(Vector2i(_clamp_context_menu_viewport_position(viewport_pos).round()), Vector2i(1, 1))
+	var clamped_viewport: Vector2 = get_global_transform() * _clamp_context_menu_viewport_position(local_anchor)
+	var popup_rect := Rect2i(Vector2i(clamped_viewport.round()), Vector2i(1, 1))
 	_canvas_action_menu.popup_on_parent(popup_rect)
 
 
@@ -2730,6 +2737,135 @@ func _create_macro_at(canvas_pos: Vector2) -> void:
 		_rack_diag_log("control_add_macro queued at %s" % str(graph_pos))
 
 
+# ==========================================
+# K3.1③：侧栏宏调取第一入口桥（机架左侧工具栏与画布右键同一
+# control_* 命令面；快照读侧=control_graph，旧 repository 宏文档仅留兼容读）
+# ==========================================
+func vit_sidebar_control_nodes() -> Array:
+	var out: Array = []
+	for node_variant in _control_graph_snapshot.get("nodes", []):
+		if typeof(node_variant) != TYPE_DICTIONARY:
+			continue
+		var snap := node_variant as Dictionary
+		var node_id := str(snap.get("node_id", "")).strip_edges()
+		if node_id.is_empty():
+			continue
+		var kind: String = _RACK_CONTROL_LAYER_RULES_SCRIPT.normalize_control_kind(str(snap.get("kind", "slider")))
+		out.append({
+			"node_id": node_id,
+			"name": str(snap.get("name", node_id)),
+			"kind": kind,
+			"binding_count": _control_binding_count_for_node(node_id),
+		})
+	return out
+
+
+## 类型建议（复用 rack_control_layer_rules 建议表）：选中插件 + 首个选中参数
+## （无选中取首参数行）的特征 → {kind, reason, param_name}；无参数面返回空。
+func vit_sidebar_suggest_control_kind() -> Dictionary:
+	var plugin_id := get_selected_plugin_id()
+	if plugin_id.is_empty():
+		return {}
+	var selected: Dictionary = _selected_param_surface_ids(plugin_id)
+	var rows: Array = _param_port_rows_by_plugin.get(plugin_id, []) as Array
+	var param_row: Dictionary = {}
+	for row_variant in rows:
+		if typeof(row_variant) != TYPE_DICTIONARY:
+			continue
+		var row := row_variant as Dictionary
+		var pid := str(row.get("param_id", row.get("id", "")))
+		if selected.is_empty() or selected.has(pid):
+			param_row = row
+			break
+	if param_row.is_empty():
+		return {}
+	var suggestion: Dictionary = _RACK_CONTROL_LAYER_RULES_SCRIPT.suggest_control_kind(param_row)
+	suggestion["param_name"] = str(param_row.get("param_name", param_row.get("name", param_row.get("param_id", ""))))
+	return suggestion
+
+
+func _sidebar_spawn_canvas_pos() -> Vector2:
+	# 侧栏入口无画布锚点：创建物落当前视野中心（画布逻辑坐标）。
+	return (size * 0.5 + scroll_offset) / maxf(zoom, 0.001)
+
+
+func vit_sidebar_create_macro() -> bool:
+	var macro_count := 0
+	for node_variant in _control_graph_snapshot.get("nodes", []):
+		if typeof(node_variant) == TYPE_DICTIONARY \
+				and _RACK_CONTROL_LAYER_RULES_SCRIPT.normalize_control_kind(str((node_variant as Dictionary).get("kind", ""))) == _RACK_CONTROL_LAYER_RULES_SCRIPT.KIND_MACROPANEL:
+			macro_count += 1
+	var payload: Dictionary = _RACK_IPC_PAYLOAD_RULES_SCRIPT.control_add_macro_payload(
+		"Macro %d" % (macro_count + 1), _sidebar_spawn_canvas_pos(), 1)
+	var rack_client: Variant = _vit_rack_client()
+	if _rack_command_queued(rack_client.control_add_macro(payload), "control_add_macro"):
+		_rack_diag_log("sidebar control_add_macro queued")
+		return true
+	return false
+
+
+func vit_sidebar_create_control(kind: String, display_name: String = "") -> bool:
+	var normalized: String = _RACK_CONTROL_LAYER_RULES_SCRIPT.normalize_control_kind(kind)
+	var name := display_name.strip_edges()
+	if name.is_empty():
+		name = normalized
+	var payload: Dictionary = _RACK_IPC_PAYLOAD_RULES_SCRIPT.control_add_node_payload(
+		normalized, name, _sidebar_spawn_canvas_pos())
+	var rack_client: Variant = _vit_rack_client()
+	if _rack_command_queued(rack_client.control_add_node(payload), "control_add_node"):
+		_rack_diag_log("sidebar control_add_node(%s) queued" % normalized)
+		return true
+	return false
+
+
+func vit_sidebar_focus_control_node(node_id: String) -> bool:
+	var clean := node_id.strip_edges()
+	for c in get_children():
+		if c is GraphNode and str((c as GraphNode).get_meta("control_node_id", "")) == clean:
+			var gn := c as GraphNode
+			gn.selected = true
+			scroll_offset = gn.position_offset * zoom - size * 0.5
+			_rack_clamp_scroll_to_content_x()
+			queue_redraw()
+			return true
+	return false
+
+
+## 施加：以快照当前值重推内核（宏卡=control_set_macro_values 批量；
+## 单控件卡=control_set_node_value 首输出）。
+func vit_sidebar_reapply_control_node(node_id: String) -> bool:
+	var clean := node_id.strip_edges()
+	var snap: Dictionary = {}
+	for node_variant in _control_graph_snapshot.get("nodes", []):
+		if typeof(node_variant) == TYPE_DICTIONARY and str((node_variant as Dictionary).get("node_id", "")) == clean:
+			snap = node_variant as Dictionary
+			break
+	if snap.is_empty():
+		return false
+	var kind: String = _RACK_CONTROL_LAYER_RULES_SCRIPT.normalize_control_kind(str(snap.get("kind", "slider")))
+	var values := _dict_from_snapshot(snap.get("current_values", {}))
+	var rack_client: Variant = _vit_rack_client()
+	if kind == _RACK_CONTROL_LAYER_RULES_SCRIPT.KIND_MACROPANEL:
+		var payload_values: Dictionary = {}
+		for output in _RACK_CONTROL_LAYER_RULES_SCRIPT.macro_output_names(int(snap.get("macro_count", 1))):
+			var value_variant: Variant = values.get(output, snap.get("min", 0.0))
+			if typeof(value_variant) == TYPE_FLOAT or typeof(value_variant) == TYPE_INT:
+				payload_values[output] = float(value_variant)
+		if payload_values.is_empty():
+			return false
+		var macro_payload: Dictionary = _RACK_IPC_PAYLOAD_RULES_SCRIPT.control_set_macro_values_payload(clean, payload_values)
+		return _rack_command_queued(rack_client.control_set_macro_values(macro_payload), "control_set_macro_values")
+	var outputs: Array[String] = _RACK_CONTROL_LAYER_RULES_SCRIPT.outputs_for_kind(kind)
+	var output_name := "value"
+	if not outputs.is_empty():
+		output_name = outputs[0]
+	var current: Variant = values.get("value", values.get(output_name, snap.get("min", 0.0)))
+	if not (typeof(current) == TYPE_FLOAT or typeof(current) == TYPE_INT):
+		current = snap.get("min", 0.0)
+	var node_payload: Dictionary = _RACK_IPC_PAYLOAD_RULES_SCRIPT.control_set_node_value_payload(clean, output_name, float(current))
+	return _rack_command_queued(rack_client.control_set_node_value(node_payload), "control_set_node_value")
+
+
 # ==========================================
 # K3：参数口（效果器卡 ⌗ params 行 + 注册表；SendOut 硬接线口）
 # ==========================================
diff --git a/tools/probe_rack_sendroute_macro.gd b/tools/probe_rack_sendroute_macro.gd
index 09b8801..44222d3 100644
--- a/tools/probe_rack_sendroute_macro.gd
+++ b/tools/probe_rack_sendroute_macro.gd
@@ -420,6 +420,75 @@ func _run_scene_suite() -> void:
 	# --- 场景 9：SEND 槽位（通道条场景） ---
 	_suite_mixer_strip()
 
+	# --- 场景 8.5：K3.1① 空白右键菜单坐标（局部→viewport 换算）+② selector 可见性 ---
+	# 偏移挂载（dock 同构）：rack global=(300,100)，空白右键局部 (400,300)
+	# → popup_on_parent 应收 viewport 坐标（菜单屏幕位置=窗口+viewport 坐标，
+	# 窗口态取证 2026-10-19 亲验）；下游三入口锚点存回局部坐标。
+	rack.size = Vector2(1200, 800)
+	rack.position = Vector2(300, 100)
+	rack._rack_viewport_target_zoom = 1.0
+	rack._canvas_action_menu = null
+	var k31_click_local := Vector2(400.0, 300.0)
+	rack._gui_input(_right_button(k31_click_local, true))
+	rack._gui_input(_right_button(k31_click_local, false))
+	var k31_menu: Node = rack._canvas_action_menu
+	_check("k31 blank right-click menu opened", k31_menu != null and is_instance_valid(k31_menu) and k31_menu.visible, "menu missing/not visible")
+	var k31_anchor: Vector2 = rack._canvas_action_menu_pos
+	_check("k31 blank right-click downstream anchor = mouse local ±2px", k31_anchor.distance_to(k31_click_local) <= 2.0, "anchor=%s expected=%s" % [k31_anchor, k31_click_local])
+	# 菜单窗口态屏幕坐标=主窗口原点+viewport 坐标——headless 读不到窗口原点，
+	# 已由窗口态取证（2026-10-19）亲验；此处钉链路+锚点，窗口原点断言归窗口态取证。
+	rack._canvas_action_menu = null
+	# ② 传导症状复验：动作菜单「新建发送」→ selector 弹于锚点（可见、画布矩形内、近锚点）。
+	rack._on_canvas_action_menu_id_pressed(2)
+	var k31_selector: Node = rack._send_target_selector
+	_check("k31 send selector opened via canvas action menu", k31_selector != null and is_instance_valid(k31_selector) and k31_selector.visible, "selector missing/not visible")
+	if k31_selector != null and is_instance_valid(k31_selector):
+		var k31_sel_pos: Vector2 = k31_selector.position
+		_check("k31 selector position inside graph rect", Rect2(Vector2.ZERO, rack.size).grow(4.0).has_point(k31_sel_pos), "pos=%s rack_size=%s" % [k31_sel_pos, rack.size])
+		_check("k31 selector near click anchor", k31_sel_pos.distance_to(k31_anchor) <= 16.0, "pos=%s anchor=%s" % [k31_sel_pos, k31_anchor])
+	rack.position = Vector2.ZERO
+
+	# --- 场景 11：K3.1③ 侧栏宏调取第一入口桥（control_* 同一命令面） ---
+	var k31_nodes: Array = rack.vit_sidebar_control_nodes()
+	_check("k31 sidebar control nodes listed", k31_nodes.size() == 2, "count=%d" % k31_nodes.size())
+	var k31_macro_listed := false
+	var k31_knob_listed := false
+	for k31_node_variant in k31_nodes:
+		var k31_node: Dictionary = k31_node_variant as Dictionary
+		if str(k31_node.get("node_id", "")) == "ctrl_macro_1" and int(k31_node.get("binding_count", -1)) == 2:
+			k31_macro_listed = true
+		if str(k31_node.get("node_id", "")) == "ctrl_knob_1" and int(k31_node.get("binding_count", -1)) == 0:
+			k31_knob_listed = true
+	_check("k31 sidebar lists macropanel with bindings", k31_macro_listed, "macro row wrong")
+	_check("k31 sidebar lists knob without bindings", k31_knob_listed, "knob row wrong")
+	var k31_before_macro_add := _collect_cmds("control_add_macro").size()
+	_check("k31 sidebar create macro queues control_add_macro", bool(rack.vit_sidebar_create_macro()) and _collect_cmds("control_add_macro").size() == k31_before_macro_add + 1, "command not queued")
+	var k31_macro_add_cmds := _collect_cmds("control_add_macro")
+	if k31_macro_add_cmds.size() > k31_before_macro_add:
+		var k31_macro_cmd: Dictionary = k31_macro_add_cmds[k31_macro_add_cmds.size() - 1]
+		_check("k31 sidebar create macro payload", str(k31_macro_cmd.get("name", "")) == "Macro 2" and int(k31_macro_cmd.get("macro_count", 0)) == 1, str(k31_macro_cmd))
+	var k31_before_node_add := _collect_cmds("control_add_node").size()
+	_check("k31 sidebar create control queues control_add_node", bool(rack.vit_sidebar_create_control("xypad", "XY Pad")) and _collect_cmds("control_add_node").size() == k31_before_node_add + 1, "command not queued")
