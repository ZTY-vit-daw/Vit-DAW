+## K3：FX 轨（EFFECT_RETURN）角色徽标——repository send 拓扑判定，标题行内动态 Label。
+func _refresh_fx_return_role(kernel_track_id: String) -> void:
+	_bind_fx_role_hub_once()
+	var active := false
+	var clean := kernel_track_id.strip_edges()
+	if not clean.is_empty():
+		var tree := get_tree()
+		if tree != null:
+			var repo: Variant = tree.get_first_node_in_group("project_repository")
+			if repo != null and repo.has_method("is_fx_track"):
+				active = bool(repo.call("is_fx_track", clean))
+	set_fx_return_role(active)
+
+
+func set_fx_return_role(active: bool) -> void:
+	if active == _fx_role_active:
+		_ensure_fx_role_badge()
+		return
+	_fx_role_active = active
+	_ensure_fx_role_badge()
+	if _fx_role_badge != null and is_instance_valid(_fx_role_badge):
+		_fx_role_badge.visible = active
+
+
+func _ensure_fx_role_badge() -> void:
+	if _fx_role_badge != null and is_instance_valid(_fx_role_badge):
+		return
+	var row := get_node_or_null("Track_Split/Header_2D/Header_Chrome_Row/Header_VBox/Header_Title_Row")
+	if row == null:
+		return
+	var badge := Label.new()
+	badge.name = "FxReturnBadge"
+	badge.text = "FX"
+	badge.tooltip_text = "FX 总线轨（send return）——湿声经回送总线回流目标轨"
+	badge.add_theme_font_size_override("font_size", 11)
+	badge.add_theme_color_override("font_color", Color("a78bfa"))
+	badge.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	badge.visible = false
+	row.add_child(badge)
+	_fx_role_badge = badge
+
+
+func _bind_fx_role_hub_once() -> void:
+	if _fx_role_hub_bound:
+		return
+	var tree := get_tree()
+	if tree == null:
+		return
+	var hub: Variant = tree.get_first_node_in_group("project_event_hub")
+	if hub == null or not hub.has_signal("send_topology_changed"):
+		return
+	hub.send_topology_changed.connect(_on_send_topology_changed_for_fx_role)
+	_fx_role_hub_bound = true
+
+
+func _on_send_topology_changed_for_fx_role(_topology: Dictionary) -> void:
+	_refresh_fx_return_role(_kernel_id_for_this_row())
+
+
 func _on_track_name_focus_entered() -> void:
 	_select_this_track()
 
