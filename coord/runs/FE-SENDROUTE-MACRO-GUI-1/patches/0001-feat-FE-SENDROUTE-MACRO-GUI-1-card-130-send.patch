+
+func _on_send_slot_break_pressed(source_track_id: String, fx_track_id: String) -> void:
+	var payload: Dictionary = _build_strip_payload("track_send_disconnect_payload", [source_track_id, fx_track_id])
+	if payload.is_empty():
+		return
+	_send_rack_command("track.send.disconnect", payload, "track_send_disconnect_strip")
+
+
+func _build_strip_payload(builder_name: String, args: Array) -> Dictionary:
+	var rules: Variant = _RACK_IPC_PAYLOAD_RULES_FOR_STRIP
+	match builder_name:
+		"track_send_set_amount_payload":
+			return rules.track_send_set_amount_payload(str(args[0]), str(args[1]), float(args[2]))
+		"track_send_disconnect_payload":
+			return rules.track_send_disconnect_payload(str(args[0]), str(args[1]))
+	return {}
+
+
+func _send_rack_command(command_name: String, payload: Dictionary, request_id: String) -> void:
+	if _rack_client == null or not is_instance_valid(_rack_client):
+		_rack_client = _RACK_CLIENT_SCRIPT.new()
+	var queued: String = _rack_client.queue_command(_add_cmd(payload, command_name), request_id)
+	if queued.is_empty():
+		push_warning("Vit-DAW: SEND 槽位命令排队失败 cmd=%s" % command_name)
+
+
+func _add_cmd(payload: Dictionary, command_name: String) -> Dictionary:
+	var wire := payload.duplicate(true)
+	wire["cmd"] = command_name
+	return wire
+
+
 func set_track_group_badges(groups: Array) -> void:
 	_pending_track_groups = groups.duplicate(true)
 	_apply_track_group_badge()
