+## 双击 send 节点 = 跳转目标（FX 轨画布 / 侧链目标轨画布，复用 track_focus_changed 换轨链）。
+func _jump_send_route_node_target(node: GraphNode) -> void:
+	var target_track := str(node.get_meta("vit_send_fx_track_id", "")).strip_edges()
+	if target_track.is_empty():
+		return
+	if _project_event_hub != null:
+		_project_event_hub.track_focus_changed.emit(target_track, "graph_rack_send_jump")
+	_rack_diag_log("send route jump target_track=%s" % target_track)
+
+
+## 右键 send 节点成对移除（§9.0-1）：track.send.disconnect（sidechain 形态走 target 断开）。
+func _remove_send_route_for_node(node: GraphNode) -> void:
+	if node == null or not is_instance_valid(node):
+		return
+	var kernel_item := str(node.get_meta("kernel_plugin_item_id", "")).strip_edges()
+	var payload: Dictionary = {}
+	var request_id := "track_send_disconnect"
+	var is_sidechain := false
+	for sc_variant in _send_topology.get("sidechain", []):
+		var sc: Dictionary = sc_variant
+		if str(sc.get("plugin_item_id", "")) == kernel_item:
+			is_sidechain = true
+			break
+	if is_sidechain:
+		payload = _RACK_IPC_PAYLOAD_RULES_SCRIPT.track_send_disconnect_sidechain_payload(kernel_item)
+		request_id = "track_send_disconnect_sc"
+	else:
+		var source := str(_bound_kernel_track_id).strip_edges()
+		if source.is_empty():
+			source = _resolve_current_kernel_track_id()
+		var fx := str(node.get_meta("vit_send_fx_track_id", "")).strip_edges()
+		if source.is_empty() or fx.is_empty():
+			push_warning("Vit-DAW: send disconnect 缺少 source/fx track_id")
+			return
+		payload = _RACK_IPC_PAYLOAD_RULES_SCRIPT.track_send_disconnect_payload(source, fx)
+	var rack_client: Variant = _vit_rack_client()
+	var queued: String = rack_client.track_send_disconnect(payload, request_id)
+	if not _rack_command_queued(queued, "track.send.disconnect"):
+		return
+	_queue_pending_send_edge_removal(payload)
+
+
+func _queue_pending_send_edge_removal(payload: Dictionary) -> void:
+	var target: Variant = payload.get("target", null)
+	if typeof(target) == TYPE_DICTIONARY:
+		var plugin_item := str((target as Dictionary).get("plugin_item_id", ""))
+		_pending_send_edges[_RACK_SEND_ROUTE_RULES_SCRIPT.sidechain_edge_key("", plugin_item)] = {
+			"label": "断开中…", "expire_msec": Time.get_ticks_msec() + _PENDING_EDGE_TTL_MSEC,
+		}
+		return
+	var source := str(payload.get("source_track_id", ""))
+	var fx := str(payload.get("fx_track_id", ""))
+	if source.is_empty() or fx.is_empty():
+		return
+	_pending_send_edges[_RACK_SEND_ROUTE_RULES_SCRIPT.send_edge_key(source, fx)] = {
+		"label": "断开中…", "expire_msec": Time.get_ticks_msec() + _PENDING_EDGE_TTL_MSEC,
+	}
+	_rack_keep_process_alive(_PENDING_EDGE_TTL_MSEC + 200)
+	queue_redraw()
+
+
+func _expire_pending_send_edges() -> void:
+	if _pending_send_edges.is_empty():
+		return
+	var now := Time.get_ticks_msec()
+	var dirty := false
+	for key in _pending_send_edges.keys():
+		var edge: Dictionary = _pending_send_edges.get(key, {}) as Dictionary
+		if now > int(edge.get("expire_msec", 0)):
+			_pending_send_edges.erase(key)
+			dirty = true
+	if dirty:
+		queue_redraw()
+
