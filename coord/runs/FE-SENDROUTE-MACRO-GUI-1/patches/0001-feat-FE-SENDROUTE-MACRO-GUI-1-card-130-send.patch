+func _on_binding_menu_confirm() -> void:
+	var context := _binding_menu_context.duplicate(true)
+	if context.is_empty():
+		_binding_menu.hide()
+		return
+	_binding_menu.hide()
+	var curve := _binding_menu_curve_option.get_item_text(_binding_menu_curve_option.selected)
+	var range_min := float(_binding_menu_min_edit.value)
+	var range_max := float(_binding_menu_max_edit.value)
+	var mode := str(context.get("mode", ""))
+	var rack_client: Variant = _vit_rack_client()
+	if mode == "edit_binding":
+		var payload: Dictionary = _RACK_IPC_PAYLOAD_RULES_SCRIPT.control_update_binding_payload(str(context.get("binding_id", "")), {
+			"curve": curve,
+			"min": range_min,
+			"max": range_max,
+		})
+		var queued: String = rack_client.control_update_binding(payload)
+		_rack_command_queued(queued, "control_update_binding")
+		return
+	if mode == "create_control":
+		var kind := _binding_menu_kind_option.get_item_text(_binding_menu_kind_option.selected)
+		_create_control_for_param(str(context.get("plugin_id", "")), str(context.get("param_id", "")), kind, range_min, range_max, curve)
+		return
+	# bind：源控制节点输出 → 参数口。
+	var payload: Dictionary = _RACK_IPC_PAYLOAD_RULES_SCRIPT.control_add_binding_payload(
+		str(context.get("source_node_id", "")),
+		str(context.get("source_output", "value")),
+		"plugin_param",
+		str(context.get("plugin_id", "")),
+		str(context.get("param_id", "")),
+		range_min,
+		range_max,
+		curve
+	)
+	var queued: String = rack_client.control_add_binding(payload)
+	_rack_command_queued(queued, "control_add_binding")
