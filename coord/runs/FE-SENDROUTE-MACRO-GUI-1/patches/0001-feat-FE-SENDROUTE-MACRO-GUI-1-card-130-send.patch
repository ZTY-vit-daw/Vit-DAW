+func _suite_mixer_strip() -> void:
+	var strip_scene: Variant = load(STRIP_SCENE_PATH)
+	if strip_scene == null:
+		_check("scene strip scene loadable", false, "scene missing")
+		return
+	var strip: Variant = strip_scene.instantiate()
+	if strip == null:
+		_check("scene strip instantiate", false, "instantiate failed")
+		return
+	strip.bound_kernel_track_id = FIXTURE_SOURCE_TRACK
+	_stage.add_child(strip)
+	strip._rack_client = _fake_client
+	strip._refresh_send_slots()
+	var send_button: Button = strip.get_node_or_null("ChannelColumn/SendSlotButton") as Button
+	_check("scene strip SEND slot button", send_button != null and str(send_button.text).contains("SEND (1)"), str(send_button.text if send_button != null else "<null>"))
+	send_button.set_pressed_no_signal(true)
+	strip._on_send_slot_toggled(true)
+	var panel: VBoxContainer = strip.get_node_or_null("ChannelColumn/SendSlotPanel") as VBoxContainer
+	_check("scene strip SEND panel opens", panel != null and panel.visible, "panel missing")
+	var spin_boxes: Array = _collect_children_of_type(panel, "SpinBox")
+	_check("scene strip amount spinbox", spin_boxes.size() >= 1, "spinbox count=%d" % spin_boxes.size())
+	var break_buttons: Array = _collect_children_of_type(panel, "Button").filter(func(b: Variant) -> bool: return str((b as Button).text) == "断开")
+	_check("scene strip break button", break_buttons.size() >= 1, "break button missing")
+	if spin_boxes.size() >= 1:
+		var before := _collect_cmds("track.send.set_amount").size()
+		strip._on_send_slot_amount_changed(-8.0, FIXTURE_SOURCE_TRACK, FIXTURE_FX_TRACK)
+		_check("scene strip set_amount command", _collect_cmds("track.send.set_amount").size() == before + 1, "count")
+		var amount_cmds := _collect_cmds("track.send.set_amount")
+		var cmd: Dictionary = amount_cmds[amount_cmds.size() - 1]
+		_check("scene strip set_amount payload", str(cmd.get("source_track_id", "")) == FIXTURE_SOURCE_TRACK and str(cmd.get("fx_track_id", "")) == FIXTURE_FX_TRACK and is_equal_approx(float(cmd.get("amount_db", 99.0)), -8.0), str(cmd))
+	if break_buttons.size() >= 1:
+		var before_disc := _collect_cmds("track.send.disconnect").size()
+		strip._on_send_slot_break_pressed(FIXTURE_SOURCE_TRACK, FIXTURE_FX_TRACK)
+		_check("scene strip disconnect command", _collect_cmds("track.send.disconnect").size() == before_disc + 1, "count")
+	strip.queue_free()
