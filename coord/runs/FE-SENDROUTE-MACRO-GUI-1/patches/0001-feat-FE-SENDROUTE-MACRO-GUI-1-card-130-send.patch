+extends RefCounted
+class_name RackControlWidgetFactory
+
+# ==============================================================================
+# FE-SENDROUTE-MACRO-GUI-1 (K3)：控件渲染器组件族（129 定稿第一批七静态类完整交互：
+# knob/slider/numberbox/xypad/toggle/button/range；时变三类 envelope/lfo/stepsequencer
+# 渲染壳先行——无绑定交互，标注后续卡）。双面共用（v2 §4）：机架控制层宏卡与
+# agent 侧面板 macro_panel 共用同一套绘制组件（十词表+别名兼容经
+# RackControlLayerRules.normalize_control_kind 归一）。
+# 交互契约：value_changed=中间帧（本地回显），committed=提交帧（drag_ended/toggle/
+# submit/press——由调用方落 control_set_node_value / control_set_macro_values）。
+# ==============================================================================
+
+const _RULES_SCRIPT: Variant = preload("res://app/rack/rack_control_layer_rules.gd")
+
+const KNOB_MIN_SIZE := Vector2(46, 46)
+const XPAD_MIN_SIZE := Vector2(104, 76)
+const SHELL_MIN_SIZE := Vector2(120, 52)
+
+
+## 构建控件。spec={min,max,step,value,value_y,label}; callbacks={value_changed,committed}。
+## 返回 {root: Control, widget: Control}；壳类返回只读 shell（带「后续卡」标注）。
+static func create_control_widget(kind_raw: String, spec: Dictionary, callbacks: Dictionary = {}) -> Dictionary:
+	var kind: String = _RULES_SCRIPT.normalize_control_kind(kind_raw)
+	match kind:
+		"knob":
+			return {"root": _KnobWidget.new(spec, callbacks)}
+		"slider":
+			return {"root": _make_slider(spec, callbacks)}
+		"numberbox":
+			return {"root": _make_numberbox(spec, callbacks)}
+		"xypad":
+			return {"root": _XYPadWidget.new(spec, callbacks)}
+		"toggle":
+			return {"root": _make_toggle(spec, callbacks)}
+		"button":
+			return {"root": _make_button(spec, callbacks)}
+		"range":
+			return {"root": _make_range(spec, callbacks)}
+		_:
+			return {"root": _make_shell(kind_raw)}
+
+
+static func is_shell_kind(kind_raw: String) -> bool:
+	return _RULES_SCRIPT.is_shell_control_kind(kind_raw)
+
+
+static func _emit_live(callbacks: Dictionary, values: Dictionary) -> void:
+	var cb: Variant = callbacks.get("value_changed", null)
+	if cb != null and cb is Callable and (cb as Callable).is_valid():
+		(cb as Callable).call(values.duplicate())
+
+
+static func _emit_commit(callbacks: Dictionary, values: Dictionary) -> void:
+	var cb: Variant = callbacks.get("committed", null)
+	if cb != null and cb is Callable and (cb as Callable).is_valid():
+		(cb as Callable).call(values.duplicate())
+
+
+static func _norm_params(spec: Dictionary) -> Dictionary:
+	var min_value := float(spec.get("min", 0.0))
+	var max_value := float(spec.get("max", 1.0))
+	if absf(max_value - min_value) < 0.00001:
+		max_value = min_value + 1.0
+	return {"min": min_value, "max": max_value}
+
+
+static func _make_slider(spec: Dictionary, callbacks: Dictionary) -> Control:
+	var params := _norm_params(spec)
+	var slider := HSlider.new()
+	slider.min_value = params["min"]
+	slider.max_value = params["max"]
+	slider.step = maxf(absf(float(spec.get("step", 0.0))), 0.0001) if absf(float(spec.get("step", 0.0))) > 0.0 else 0.001
+	slider.value = clampf(float(spec.get("value", params["min"])), params["min"], params["max"])
+	slider.custom_minimum_size = Vector2(120, 18)
+	slider.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	slider.value_changed.connect(func(value: float) -> void:
+		_emit_live(callbacks, {"value": value})
+	)
+	slider.drag_ended.connect(func(changed: bool) -> void:
+		if changed:
+			_emit_commit(callbacks, {"value": slider.value})
+	)
+	return slider
+
+
+static func _make_numberbox(spec: Dictionary, callbacks: Dictionary) -> Control:
+	var params := _norm_params(spec)
+	var box := SpinBox.new()
+	box.min_value = params["min"]
+	box.max_value = params["max"]
+	var step := absf(float(spec.get("step", 0.0)))
+	box.step = step if step > 0.0 else 0.01
+	box.value = clampf(float(spec.get("value", params["min"])), params["min"], params["max"])
+	box.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	box.value_changed.connect(func(value: float) -> void:
+		_emit_commit(callbacks, {"value": value})
+	)
+	return box
+
+
+static func _make_toggle(spec: Dictionary, callbacks: Dictionary) -> Control:
+	var toggle := CheckButton.new()
+	var min_value := float(spec.get("min", 0.0))
+	var max_value := float(spec.get("max", 1.0))
+	toggle.button_pressed = float(spec.get("value", min_value)) >= (min_value + max_value) * 0.5
+	toggle.toggled.connect(func(pressed: bool) -> void:
+		_emit_live(callbacks, {"value": max_value if pressed else min_value})
+		_emit_commit(callbacks, {"value": max_value if pressed else min_value})
+	)
+	return toggle
+
+
+static func _make_button(spec: Dictionary, callbacks: Dictionary) -> Control:
+	var button := Button.new()
+	button.text = str(spec.get("label", "Trigger")).strip_edges()
+	button.toggle_mode = false
+	var max_value := float(spec.get("max", 1.0))
+	var min_value := float(spec.get("min", 0.0))
+	button.pressed.connect(func() -> void:
+		_emit_live(callbacks, {"value": max_value})
+		_emit_commit(callbacks, {"value": max_value})
+	)
+	button.button_up.connect(func() -> void:
+		_emit_live(callbacks, {"value": min_value})
+	)
+	return button
+
+
+## range=双端成对（v2 §2 双输出）：out_x=下限、out_y=上限，两行滑杆。
+static func _make_range(spec: Dictionary, callbacks: Dictionary) -> Control:
+	var params := _norm_params(spec)
+	var box := VBoxContainer.new()
+	box.add_theme_constant_override("separation", 2)
+	var lower := _make_slider({"min": params["min"], "max": params["max"], "step": spec.get("step", 0.001), "value": spec.get("value", params["min"])}, {
+		"value_changed": func(values: Dictionary) -> void:
+			_emit_live(callbacks, {"out_x": float(values.get("value", params["min"]))}),
+		"committed": func(values: Dictionary) -> void:
+			_emit_commit(callbacks, {"out_x": float(values.get("value", params["min"]))}),
+	})
+	var upper := _make_slider({"min": params["min"], "max": params["max"], "step": spec.get("step", 0.001), "value": spec.get("value_y", params["max"])}, {
+		"value_changed": func(values: Dictionary) -> void:
+			_emit_live(callbacks, {"out_y": float(values.get("value", params["max"]))}),
+		"committed": func(values: Dictionary) -> void:
+			_emit_commit(callbacks, {"out_y": float(values.get("value", params["max"]))}),
+	})
+	lower.custom_minimum_size = Vector2(110, 16)
+	upper.custom_minimum_size = Vector2(110, 16)
+	box.add_child(lower)
+	box.add_child(upper)
+	return box
+
+
+## 时变三类渲染壳：无交互，标注「时变控件：绑定交互后续卡」。
+static func _make_shell(kind_raw: String) -> Control:
+	var kind: String = _RULES_SCRIPT.normalize_control_kind(kind_raw)
+	var shell := _ShellWidget.new(kind)
+	shell.custom_minimum_size = SHELL_MIN_SIZE
+	return shell
+
+
+# ==========================================
+# 自绘控件：knob / xypad / 壳
+# ==========================================
+
+class _KnobWidget:
+	extends Control
+
+	var _min := 0.0
+	var _max := 1.0
+	var _value := 0.0
+	var _callbacks: Dictionary = {}
+	var _drag_active := false
+
+	func _init(spec: Dictionary, callbacks: Dictionary) -> void:
+		_min = float(spec.get("min", 0.0))
+		_max = float(spec.get("max", 1.0))
+		if absf(_max - _min) < 0.00001:
+			_max = _min + 1.0
+		_value = clampf(float(spec.get("value", _min)), _min, _max)
+		_callbacks = callbacks
+		custom_minimum_size = Vector2(46, 46)
+
+	func _normalized() -> float:
+		return (_value - _min) / (_max - _min)
+
+	func set_value_silent(value: float) -> void:
+		_value = clampf(value, _min, _max)
+		queue_redraw()
+
+	func _draw() -> void:
+		var center := size * 0.5
+		var radius := minf(size.x, size.y) * 0.5 - 3.0
+		var color := Color("a78bfa")
+		var track := Color(0.035, 0.042, 0.055, 0.35)
+		draw_arc(center, radius, PI * 0.75, PI * 2.25, 24, track, 3.0, true)
+		var sweep := PI * 0.75 + _normalized() * PI * 1.5
+		draw_arc(center, radius, PI * 0.75, sweep, 24, color, 3.0, true)
+		var angle_vec := Vector2(cos(sweep), sin(sweep))
+		draw_line(center, center + angle_vec * (radius - 4.0), Color(0.96, 0.96, 0.98), 2.0, true)
+		draw_circle(center, 2.4, Color(0.96, 0.96, 0.98))
+
+	func _get_drag_sensitivity() -> float:
+		return 200.0
+
+	func _gui_input(event: InputEvent) -> void:
+		if event is InputEventMouseButton:
+			var mouse := event as InputEventMouseButton
+			if mouse.button_index == MOUSE_BUTTON_LEFT:
+				_drag_active = mouse.pressed
+				get_viewport().set_input_as_handled()
+		elif event is InputEventMouseMotion and _drag_active:
+			var motion := event as InputEventMouseMotion
+			_apply_delta(motion.relative.y)
+			get_viewport().set_input_as_handled()
+
+	func _apply_delta(delta_px: float) -> void:
+		var t := _normalized() - delta_px / _get_drag_sensitivity()
+		_value = clampf(_min + t * (_max - _min), _min, _max)
+		queue_redraw()
+		_emit_live()
+
+	func _emit_live() -> void:
+		var cb: Variant = _callbacks.get("value_changed", null)
+		if cb != null and cb is Callable and (cb as Callable).is_valid():
+			(cb as Callable).call({"value": _value})
+
+	func _notification(what: int) -> void:
+		if what == NOTIFICATION_MOUSE_EXIT:
+			_drag_active = false
+
+
+class _XYPadWidget:
+	extends Control
+
+	var _min := 0.0
+	var _max := 1.0
+	var _x := 0.0
+	var _y := 0.0
+	var _callbacks: Dictionary = {}
+	var _drag_active := false
+
+	func _init(spec: Dictionary, callbacks: Dictionary) -> void:
+		_min = float(spec.get("min", 0.0))
+		_max = float(spec.get("max", 1.0))
+		if absf(_max - _min) < 0.00001:
+			_max = _min + 1.0
+		_x = clampf(float(spec.get("value", _min)), _min, _max)
+		_y = clampf(float(spec.get("value_y", _min)), _min, _max)
+		_callbacks = callbacks
+		custom_minimum_size = Vector2(104, 76)
+
+	func _norm_x() -> float:
+		return (_x - _min) / (_max - _min)
+
+	func _norm_y() -> float:
+		return (_y - _min) / (_max - _min)
+
+	func _draw() -> void:
+		var bg := Color(0.035, 0.042, 0.055, 0.16)
+		var border: Color = Color("a78bfa") if _drag_active else Color(0.035, 0.042, 0.055, 0.4)
+		draw_rect(Rect2(Vector2.ZERO, size), bg)
+		draw_rect(Rect2(Vector2.ZERO, size), border, false, 1.2)
+		var px := Vector2(_norm_x() * size.x, (1.0 - _norm_y()) * size.y)
+		draw_line(Vector2(px.x, 0), Vector2(px.x, size.y), Color(0.96, 0.96, 0.98, 0.28), 1.0, true)
+		draw_line(Vector2(0, px.y), Vector2(size.x, px.y), Color(0.96, 0.96, 0.98, 0.28), 1.0, true)
+		draw_circle(px, 5.0, Color("a78bfa"))
+		draw_circle(px, 2.0, Color(0.04, 0.04, 0.06))
+
+	func _values() -> Dictionary:
+		return {"out_x": _x, "out_y": _y}
+
+	func _gui_input(event: InputEvent) -> void:
+		if event is InputEventMouseButton:
+			var mouse := event as InputEventMouseButton
+			if mouse.button_index == MOUSE_BUTTON_LEFT:
+				_drag_active = mouse.pressed
+				if mouse.pressed:
+					_apply_position(mouse.position)
+				get_viewport().set_input_as_handled()
+		elif event is InputEventMouseMotion and _drag_active:
+			_apply_position((event as InputEventMouseMotion).position)
+			get_viewport().set_input_as_handled()
+
+	func _apply_position(local_pos: Vector2) -> void:
+		var nx := clampf(local_pos.x / maxf(size.x, 1.0), 0.0, 1.0)
+		var ny := clampf(1.0 - local_pos.y / maxf(size.y, 1.0), 0.0, 1.0)
+		_x = _min + nx * (_max - _min)
+		_y = _min + ny * (_max - _min)
+		queue_redraw()
+		var cb: Variant = _callbacks.get("value_changed", null)
+		if cb != null and cb is Callable and (cb as Callable).is_valid():
+			(cb as Callable).call(_values())
+
+
+class _ShellWidget:
+	extends Control
+
+	var _kind := "envelope"
+
+	func _init(kind: String) -> void:
+		_kind = kind
+
+	func _draw() -> void:
+		var bg := Color(0.035, 0.042, 0.055, 0.10)
+		draw_rect(Rect2(Vector2.ZERO, size), bg)
+		var accent: Color = Color("a78bfa")
+		accent.a = 0.5
+		draw_rect(Rect2(Vector2.ZERO, size), accent, false, 1.0)
+		var font := get_theme_default_font()
+		var fsize := 10
+		if font != null:
+			match _kind:
+				"envelope":
+					var pts := PackedVector2Array([
+						Vector2(8, size.y - 8),
+						Vector2(size.x * 0.3, size.y - 8),
+						Vector2(size.x * 0.45, 10),
+						Vector2(size.x * 0.65, 10),
+						Vector2(size.x * 0.8, size.y - 8),
+						Vector2(size.x - 8, size.y - 8),
+					])
+					draw_polyline(pts, accent, 1.4, true)
+				"lfo":
+					var wave := PackedVector2Array()
+					var cycles := 3.0
+					for i in range(49):
+						var t := float(i) / 48.0
+						wave.append(Vector2(8 + t * (size.x - 16), size.y * 0.5 + sin(t * TAU * cycles) * size.y * 0.3))
+					draw_polyline(wave, accent, 1.4, true)
+				"stepsequencer":
+					var steps := 8
+					for i in range(steps):
+						var w := (size.x - 16.0) / steps - 2.0
+						var h_factor := 0.35 + 0.55 * (float(i % 3) / 2.0)
+						var rect := Rect2(8 + i * ((size.x - 16.0) / steps), size.y - 8 - (size.y - 16.0) * h_factor, w, (size.y - 16.0) * h_factor)
+						draw_rect(rect, accent)
+			var label := "%s（时变壳·绑定后续卡）" % _kind
+			draw_string(font, Vector2(8, 14), label, HORIZONTAL_ALIGNMENT_LEFT, -1, fsize, Color(0.55, 0.51, 0.72, 0.9))
