+# ==========================================
+# FE-SENDROUTE-MACRO-GUI-1 (K3)：send 节点渲染（§9.1 SendOut/SendIn 串联节点）
+# ==========================================
+func _add_send_route_node(spawn: Dictionary, plugin_index: int, is_send_out: bool) -> GraphNode:
+	var plugin_id := str(spawn.get("plugin_id", "")).strip_edges()
+	var kernel_item := str(spawn.get("kernel_item", "")).strip_edges()
+	var zone := ZONE_Z3
+	var col := _next_layout_column(zone)
+	var default_pos := _default_graph_pos_for_zone_column(zone, col)
+	var position_plan: Dictionary = _RACK_LAYOUT_RULES_SCRIPT.resolve_plugin_spawn_position(
+		zone, plugin_id, default_pos, _rack_node_positions, _pending_drop_positions, rack_guide_snap_enabled
+	)
+	var pos: Vector2 = position_plan.get("position", default_pos) as Vector2
+
+	var display: Dictionary = _RACK_SEND_ROUTE_RULES_SCRIPT.send_out_display(kernel_item, _send_topology, str(_bound_kernel_track_id))
+	var node := GraphNode.new()
+	node.name = "SendRoute_%s_%d_%s" % ["out" if is_send_out else "in", plugin_index, _safe_graph_node_suffix(plugin_id)]
+	node.set_meta("vit_plugin_node", true)
+	node.set_meta("kernel_plugin_item_id", kernel_item)
+	node.set_meta("plugin_id", plugin_id)
+	node.set_meta("vit_zone", zone)
+	node.set_meta("vit_display_name", node.title)
+	node.set_meta("vit_send_route_node", true)
+	node.set_meta("vit_send_is_out", is_send_out)
+	node.set_meta("vit_send_fx_track_id", str(display.get("fx_track_id", "")))
+	node.position_offset = pos
+	node.resizable = false
+	add_child(node)
+	node.add_child(_create_send_route_node_content(is_send_out, kernel_item, display))
+	_RACK_NODE_PORT_RULES_SCRIPT.apply_plugin_slot_profile(node, KIND_AUDIO_FX)
+	_vit_install_default_port_pin_maps(node)
+	_rack_apply_graph_node_card_theme(node, KIND_AUDIO_FX)
+	_apply_send_route_node_title(node, is_send_out, display)
+	node.dragged.connect(_on_plugin_graph_node_dragged.bind(node))
+	node.gui_input.connect(_on_node_gui_input.bind(node))
+	call_deferred("_rack_shrink_wrap_graph_node_by_name", str(node.name))
+	return node
+
+
+func _apply_send_route_node_title(node: GraphNode, is_send_out: bool, display: Dictionary) -> void:
+	if node == null or not is_instance_valid(node):
+		return
+	var target_name := str(display.get("target_name", "")).strip_edges()
+	if is_send_out:
+		var amount: String = _RACK_SEND_ROUTE_RULES_SCRIPT.amount_db_text(float(display.get("amount_db", 0.0)))
+		node.title = "%s  %s  %s" % [
+			_RACK_SEND_ROUTE_RULES_SCRIPT.SEND_OUT_TAG,
+			target_name if not target_name.is_empty() else "（待确认）",
+			amount,
+		]
+		node.set_meta("vit_display_name", node.title)
+		var amount_label := _find_child_label_by_name(node, "SendAmountLabel")
+		if amount_label != null:
+			amount_label.text = amount
+		var target_label := _find_child_label_by_name(node, "SendTargetLabel")
+		if target_label != null:
+			target_label.text = target_name if not target_name.is_empty() else "（待确认）"
+	else:
+		node.title = "%s  %s" % [
+			_RACK_SEND_ROUTE_RULES_SCRIPT.SEND_IN_TAG,
+			target_name if not target_name.is_empty() else "湿声注入",
+		]
+		node.set_meta("vit_display_name", node.title)
+
