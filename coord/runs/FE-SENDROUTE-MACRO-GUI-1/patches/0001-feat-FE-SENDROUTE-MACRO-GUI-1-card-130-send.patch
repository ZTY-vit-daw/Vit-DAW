+extends RefCounted
+class_name RackControlLayerRules
+
+# ==============================================================================
+# FE-SENDROUTE-MACRO-GUI-1 (K3)：机架宏控制层规则（纯函数，探针直断面）。
+# 权威=coord/runs/FE-RACK-MACRO-LAYER-DESIGN-1 01/02 定稿（129 用户五问默认锁定）：
+# 两层模型（信号实线/控制紫虚线 #a78bfa）、默认双显、单显控制=信号压淡 15%、
+# 单显信号=控制隐藏；控件十词表与内核 VitParamSurface::supportedControlKinds 同源
+# （七静态类完整交互 + envelope/lfo/stepsequencer 渲染壳先行）；类型建议=确定性
+# 规则表零 LLM；curve 词表=内核 binding schema（linear/invert/ease_in/ease_out）。
+# ==============================================================================
+
+## 控制语义色（B2 视觉语言第三语义色：橙=时间限段、青=用户动作、紫=控制）
+const CONTROL_COLOR := Color("a78bfa")
+const CONTROL_COLOR_DIM := Color(0.655, 0.545, 0.980, 0.55)
+const CONTROL_WIRE_DASH := [6.0, 4.0]
+const CONTROL_WIRE_WIDTH := 1.8
+const SIGNAL_LAYER_DIM_MODULATE_ALPHA := 0.85
+
+## 内核 kind 词表（VitParamSurface.cpp:19-23 同源；macropanel=容器）
+const KIND_MACROPANEL := "macropanel"
+const STATIC_CONTROL_KINDS: Array[String] = ["knob", "slider", "numberbox", "xypad", "toggle", "button", "range"]
+const SHELL_CONTROL_KINDS: Array[String] = ["envelope", "lfo", "stepsequencer"]
+const CONTROL_KINDS: Array[String] = ["knob", "slider", "numberbox", "xypad", "toggle", "button", "range", "envelope", "lfo", "stepsequencer"]
+
+const CURVE_KINDS: Array[String] = ["linear", "invert", "ease_in", "ease_out"]
+
+## 层显示模式：双显（默认）/单显控制/单显信号——切层只改渲染不改数据。
+enum LayerView { BOTH, CONTROL_ONLY, SIGNAL_ONLY }
+
+## 旧 macro_panel artifact 与自由输入的别名兼容（v2 §2：unknown→slider 与内核归一同口径）。
+const KIND_ALIASES := {
+	"switch": "toggle",
+	"checkbox": "toggle",
+	"trigger": "button",
+	"macropanel": "macropanel",
+}
+
+
+static func normalize_control_kind(raw: String) -> String:
+	var kind := raw.strip_edges().to_lower()
+	if KIND_ALIASES.has(kind):
+		return str(KIND_ALIASES[kind])
+	if kind in CONTROL_KINDS:
+		return kind
+	return "slider"
+
+
+static func is_static_control_kind(kind: String) -> bool:
+	return normalize_control_kind(kind) in STATIC_CONTROL_KINDS
+
+
+static func is_shell_control_kind(kind: String) -> bool:
+	return normalize_control_kind(kind) in SHELL_CONTROL_KINDS
+
+
+## 双输出控件（binding.source_output=out_x/out_y，内核 schema 原生）。
+static func dual_output_kind(kind: String) -> bool:
+	var normalized := normalize_control_kind(kind)
+	return normalized == "xypad" or normalized == "range"
+
+
+## 控件的输出名列表：单输出 ["value"]；双输出 ["out_x","out_y"]。
+static func outputs_for_kind(kind: String) -> Array[String]:
+	if dual_output_kind(kind):
+		return ["out_x", "out_y"]
+	return ["value"]
+
+
+## macropanel 槽位输出名（内核 VitMacroNode：macro_1..macro_N，N∈[1,16]）。
+static func macro_output_names(macro_count: int) -> Array[String]:
+	var out: Array[String] = []
+	for i in range(clampi(macro_count, 1, 16)):
+		out.append("macro_%d" % (i + 1))
+	return out
+
+
+# ==========================================
+# 类型建议规则表（确定性，零 LLM；v2 §2 表的参数特征分支）
+# ==========================================
+
+## 按目标参数特征给建议控件 kind（用户可下拉改任意类型）。
+## param_descriptor 形如参数描述符行：{param_id, param_name, min, max, step,
+## is_bool/discrete_steps, normalized_role}——字段缺失走缺省分支，永不失败。
+static func suggest_control_kind(param: Dictionary) -> Dictionary:
+	var name := str(param.get("param_name", param.get("name", param.get("param_id", "")))).strip_edges().to_lower()
+	var role := str(param.get("normalized_role", "")).strip_edges().to_lower()
+	var steps := _discrete_steps(param)
+	var min_value := float(param.get("min", 0.0))
+	var max_value := float(param.get("max", 1.0))
+
+	if bool(param.get("is_bool", false)) or steps == 2 or role in ["on_off", "enable", "bypass", "mute", "solo"] or _name_is_switch_like(name):
+		return {"kind": "toggle", "reason": "两态/开关型参数"}
+	if role in ["trigger", "tap", "momentary"] or _name_is_trigger_like(name):
+		return {"kind": "button", "reason": "瞬时触发型参数"}
+	if steps >= 2 and steps <= 64 and _is_integer_step(param):
+		return {"kind": "numberbox", "reason": "离散小步进（精确值）"}
+	if _is_long_throw_range(min_value, max_value) or _name_is_time_like(name) or role in ["time", "duration"]:
+		return {"kind": "slider", "reason": "长行程范围（精细调节）"}
+	return {"kind": "knob", "reason": "连续单参数（缺省首选）"}
+
+
+static func _discrete_steps(param: Dictionary) -> int:
+	var steps_variant: Variant = control_steps_from_descriptor(param)
+	return int(steps_variant)
+
+
+static func control_steps_from_descriptor(param: Dictionary) -> Variant:
+	var raw: Variant = param.get("discrete_steps", param.get("steps", null))
+	if raw != null and (typeof(raw) == TYPE_FLOAT or typeof(raw) == TYPE_INT):
+		var value := int(raw)
+		if value > 0:
+			return value
+	var step := absf(float(param.get("step", 0.0)))
+	var min_value := float(param.get("min", 0.0))
+	var max_value := float(param.get("max", 1.0))
+	if step > 0.0 and max_value > min_value:
+		var count := int(round((max_value - min_value) / step)) + 1
+		if count > 0 and count <= 4096:
+			return count
+	return 0
+
+
+static func _is_integer_step(param: Dictionary) -> bool:
+	var step := absf(float(param.get("step", 0.0)))
+	return step >= 1.0 or step == 0.0
+
+
+static func _is_long_throw_range(min_value: float, max_value: float) -> bool:
+	if min_value == 0.0 and max_value == 1.0:
+		return false
+	var span := absf(max_value - min_value)
+	return span >= 1000.0
+
+
+static func _name_is_switch_like(name: String) -> bool:
+	return name.contains("enable") or name.contains("on/off") or name.contains("onoff") \
+		or name.contains("bypass") or name.contains("mute") or name.contains("solo") \
+		or name.contains("power") or name.contains("active") or name.contains("开关")
+
+
+static func _name_is_trigger_like(name: String) -> bool:
+	return name.contains("trigger") or name.contains("tap") or name.contains("reset") or name.contains("fire")
+
+
+static func _name_is_time_like(name: String) -> bool:
+	return name.contains("time") or name.contains("length") or name.contains("duration") \
+		or name.contains("decay") or name.contains("release") or name.contains("attack")
+
+
+# ==========================================
+# 层过滤（切层只改渲染）
+# ==========================================
+
+static func signal_layer_visible(view: int) -> bool:
+	return view != LayerView.CONTROL_ONLY
+
+
+static func control_layer_visible(view: int) -> bool:
+	return view != LayerView.SIGNAL_ONLY
+
+
+static func signal_layer_dimmed(view: int) -> bool:
+	return view == LayerView.CONTROL_ONLY
+
+
+static func layer_chip_text(view: int) -> String:
+	match view:
+		LayerView.CONTROL_ONLY:
+			return "◆ 控制"
+		LayerView.SIGNAL_ONLY:
+			return "● 信号"
+		_:
+			return "●信号 ◆控制"
+
+
+# ==========================================
+# 绑定行规整（control_graph 快照 bindings 行 → 前端稳定结构）
+# ==========================================
+
+static func normalize_binding(row: Variant) -> Dictionary:
+	if typeof(row) != TYPE_DICTIONARY:
+		return {}
+	var binding := row as Dictionary
+	var out := {
+		"binding_id": str(binding.get("binding_id", "")).strip_edges(),
+		"source_node_id": str(binding.get("source_node_id", "")).strip_edges(),
+		"source_output": str(binding.get("source_output", "")).strip_edges(),
+		"target_kind": str(binding.get("target_kind", "")).strip_edges().to_lower(),
+		"target_plugin_id": str(binding.get("target_plugin_id", "")).strip_edges(),
+		"target_param_id": str(binding.get("target_param_id", "")).strip_edges(),
+		"target_node_id": str(binding.get("target_node_id", "")).strip_edges(),
+		"target_input": str(binding.get("target_input", "")).strip_edges(),
+		"range_min": float(binding.get("range_min", 0.0)),
+		"range_max": float(binding.get("range_max", 1.0)),
+		"curve": normalize_curve(str(binding.get("curve", "linear"))),
+		"enabled": bool(binding.get("enabled", true)),
+	}
+	return out
+
+
+static func normalize_curve(raw: String) -> String:
+	var curve := raw.strip_edges().to_lower()
+	return curve if curve in CURVE_KINDS else "linear"
+
+
+## 绑定线 tooltip：`宏名 → 插件名·参数名 | min..max | curve`。
+static func binding_wire_tooltip(binding: Dictionary) -> String:
+	return "%s%s → %s%s | %g..%g | %s" % [
+		str(binding.get("source_node_id", "")),
+		(":" + str(binding.get("source_output", ""))) if not str(binding.get("source_output", "")).is_empty() else "",
+		str(binding.get("target_plugin_id", binding.get("target_node_id", ""))),
+		("·" + str(binding.get("target_param_id", binding.get("target_input", "")))) if not str(binding.get("target_param_id", binding.get("target_input", ""))).is_empty() else "",
+		float(binding.get("range_min", 0.0)),
+		float(binding.get("range_max", 1.0)),
+		str(binding.get("curve", "linear")),
+	]
+
+
+## curve 求值（与内核 applyControlBindingsFromOutput 的映射同构：min..max 插值+方向）。
+static func curve_apply(curve: String, t: float, out_min: float, out_max: float) -> float:
+	var clamped := clampf(t, 0.0, 1.0)
+	var eased := clamped
+	match normalize_curve(curve):
+		"invert":
+			return lerpf(out_max, out_min, clamped)
+		"ease_in":
+			eased = clamped * clamped
+		"ease_out":
+			eased = 1.0 - (1.0 - clamped) * (1.0 - clamped)
+	return lerpf(out_min, out_max, eased)
