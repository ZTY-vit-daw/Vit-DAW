+func _find_node_by_meta(rack: Variant, meta_key: String, value_key: String, value: Variant) -> GraphNode:
+	for c in rack.get_children():
+		if c is GraphNode and bool((c as GraphNode).get_meta(meta_key, false)) and (c as GraphNode).get_meta(value_key, null) == value:
+			return c as GraphNode
+	return null
+
+
+func _find_plugin_node(rack: Variant, plugin_id: String) -> GraphNode:
+	for c in rack.get_children():
+		if c is GraphNode and str((c as GraphNode).get_meta("plugin_id", "")) == plugin_id:
+			return c as GraphNode
+	return null
+
+
+func _find_fx_source_list(rack: Variant) -> GraphNode:
+	for c in rack.get_children():
+		if c is GraphNode and bool((c as GraphNode).get_meta("vit_fx_source_list", false)):
+			return c as GraphNode
+	return null
