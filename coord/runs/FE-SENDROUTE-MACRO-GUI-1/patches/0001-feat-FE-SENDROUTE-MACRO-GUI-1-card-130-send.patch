+## 参数口「＋控件」=一步建控制卡+绑定（建议 kind 可下拉改——类型建议规则表入口）。
+func _create_control_for_param(plugin_id: String, param_id: String, kind: String, range_min: float, range_max: float, curve: String) -> void:
+	var rack_client: Variant = _vit_rack_client()
+	var graph_pos := (Vector2(120.0, 160.0) + scroll_offset) / maxf(zoom, 0.001)
+	var node_payload: Dictionary = _RACK_IPC_PAYLOAD_RULES_SCRIPT.control_add_node_payload(kind, "%s %s" % [param_id, kind], graph_pos)
+	var queued_node: String = rack_client.control_add_node(node_payload)
+	if not _rack_command_queued(queued_node, "control_add_node"):
+		return
+	# 绑定需要内核先建好节点（source_node_id 由回执 node.node_id 给出）——挂起待绑定队列，
+	# control_add_node 回执到达时在 _on_send_control_ipc_completed 里补发。
+	_pending_control_binds.append({
+		"plugin_id": plugin_id,
+		"param_id": param_id,
+		"kind": kind,
+		"min": range_min,
+		"max": range_max,
+		"curve": curve,
+		"output": "value",
+	})
+
+
+var _pending_control_binds: Array = []
+
+
+func _flush_pending_control_binds(reply: Dictionary) -> void:
+	if _pending_control_binds.is_empty():
+		return
+	var node_variant: Variant = reply.get("node", null)
+	if typeof(node_variant) != TYPE_DICTIONARY:
+		return
+	var node_id := str((node_variant as Dictionary).get("node_id", "")).strip_edges()
+	if node_id.is_empty():
+		return
+	var pending := _pending_control_binds.pop_front() as Dictionary
+	var output := str(pending.get("output", "value"))
+	if _RACK_CONTROL_LAYER_RULES_SCRIPT.dual_output_kind(str(pending.get("kind", "knob"))):
+		output = "out_x"
+	var rack_client: Variant = _vit_rack_client()
+	var payload: Dictionary = _RACK_IPC_PAYLOAD_RULES_SCRIPT.control_add_binding_payload(
+		node_id,
+		output,
+		"plugin_param",
+		str(pending.get("plugin_id", "")),
+		str(pending.get("param_id", "")),
+		float(pending.get("min", 0.0)),
+		float(pending.get("max", 1.0)),
+		str(pending.get("curve", "linear"))
+	)
+	var queued: String = rack_client.control_add_binding(payload)
+	_rack_command_queued(queued, "control_add_binding")
+
+
+# ==========================================
+# K3：控制线（紫虚线）几何与命中
+# ==========================================
+func _control_anchor_canvas_pos(node_id: String, output: String) -> Vector2:
+	for c in get_children():
+		if not (c is GraphNode):
+			continue
+		var gn := c as GraphNode
+		if not bool(gn.get_meta("vit_control_node", false)):
+			continue
+		if str(gn.get_meta("control_node_id", "")) != node_id:
+			continue
+		var anchor_name := "ControlAnchor_%s" % _safe_graph_node_suffix(output)
+		var anchor := gn.find_child(anchor_name, true, false) as Control
+		if anchor != null and is_instance_valid(anchor):
+			return _control_screen_delta_to_canvas(gn, anchor.get_global_rect().get_center())
+		return _graph_point_to_canvas(gn.position_offset) + Vector2(gn.size.x * zoom, gn.size.y * 0.5 * zoom)
+	return Vector2.INF
+
+
+func _param_port_canvas_pos(plugin_id: String, param_id: String) -> Vector2:
+	var entry: Dictionary = _param_port_controls.get("%s|%s" % [plugin_id, param_id], {}) as Dictionary
+	var control: Variant = entry.get("control", null)
+	var plugin_gn: GraphNode = null
+	if control != null and is_instance_valid(control):
+		plugin_gn = _find_plugin_graph_node_by_kernel_item(plugin_id)
+		if plugin_gn != null:
+			return _control_screen_delta_to_canvas(plugin_gn, (control as Control).get_global_rect().get_center())
+	# 参数口未展开：回退到插件卡右缘。
+	if plugin_gn == null:
+		plugin_gn = _find_plugin_graph_node_for_param_surface(plugin_id)
+	if plugin_gn != null and is_instance_valid(plugin_gn):
+		return _graph_point_to_canvas(plugin_gn.position_offset) + Vector2(plugin_gn.size.x * zoom, plugin_gn.size.y * 0.35 * zoom)
+	return Vector2.INF
+
+
+func _control_screen_delta_to_canvas(gn: GraphNode, screen_point: Vector2) -> Vector2:
+	return _graph_point_to_canvas(gn.position_offset) + (screen_point - gn.get_global_rect().position)
+
+
+func _control_target_canvas_pos(binding: Dictionary) -> Vector2:
+	if str(binding.get("target_kind", "")) == "control_port":
+		var target_node_id := str(binding.get("target_node_id", ""))
+		for c in get_children():
+			if not (c is GraphNode):
+				continue
+			var gn2 := c as GraphNode
+			if bool(gn2.get_meta("vit_control_node", false)) and str(gn2.get_meta("control_node_id", "")) == target_node_id:
+				return _graph_point_to_canvas(gn2.position_offset)
+		return Vector2.INF
+	return _param_port_canvas_pos(str(binding.get("target_plugin_id", "")), str(binding.get("target_param_id", "")))
+
+
+func _control_wire_polyline(binding: Dictionary) -> PackedVector2Array:
+	var from_pos := _control_anchor_canvas_pos(str(binding.get("source_node_id", "")), str(binding.get("source_output", "value")))
+	var to_pos := _control_target_canvas_pos(binding)
+	if from_pos == Vector2.INF or to_pos == Vector2.INF:
+		return PackedVector2Array()
+	var pts := _fallback_bezier(from_pos, to_pos)
+	if pts.size() < 2:
+		pts = PackedVector2Array([from_pos, to_pos])
+	return pts
+
+
+func _pick_control_wire_near_point(pt: Vector2) -> Dictionary:
+	var radius_sq := _RACK_WIRE_PICK_RADIUS_PX * _RACK_WIRE_PICK_RADIUS_PX
+	var best: Dictionary = {}
+	var best_d := INF
+	for binding in _control_bindings:
+		if not bool(binding.get("enabled", true)):
+			continue
+		var pts := _control_wire_polyline(binding)
+		for i in range(pts.size() - 1):
+			var d := _vit_point_to_segment_dist_sq(pt, pts[i], pts[i + 1])
+			if d < best_d:
+				best_d = d
+				best = binding
+	if best.is_empty() or best_d > radius_sq:
+		return {}
+	return best
+
+
+func _pick_control_wire_handle_near_point(pt: Vector2) -> Dictionary:
+	var radius_sq := 12.0 * 12.0
+	for binding in _control_bindings:
+		if not bool(binding.get("enabled", true)):
+			continue
+		var pts := _control_wire_polyline(binding)
+		if pts.size() < 2:
+			continue
+		var mid := pts[pts.size() >> 1]
+		if pt.distance_squared_to(mid) <= radius_sq:
+			return binding
+	return {}
+
+
+func _draw_dashed_polyline(pts: PackedVector2Array, color: Color, width: float, dash: Array) -> void:
+	if pts.size() < 2:
+		return
+	var dash_on := maxf(float(dash[0]), 1.0)
+	var dash_off := maxf(float(dash[1]), 1.0)
+	var segment := PackedVector2Array()
+	var acc := 0.0
+	var drawing := true
+	for i in range(pts.size() - 1):
+		var from := pts[i]
+		var to := pts[i + 1]
+		var length := from.distance_to(to)
+		if length < 0.001:
+			continue
+		var direction := (to - from) / length
+		var cursor := 0.0
+		while cursor < length:
+			var budget := dash_on - acc if drawing else dash_off - acc
+			var remain := length - cursor
+			var step := minf(budget, remain)
+			if drawing:
+				segment.append(from + direction * cursor)
+				segment.append(from + direction * (cursor + step))
+			acc += step
+			cursor += step
+			if acc >= (dash_on if drawing else dash_off):
+				acc = 0.0
+				drawing = not drawing
+	if segment.size() >= 2:
+		draw_polyline(segment, color, width, true)
+
+
+func _draw_control_wires(font: Font, fsize: int) -> void:
+	if not _RACK_CONTROL_LAYER_RULES_SCRIPT.control_layer_visible(_control_layer_view):
+		return
+	var hover_id := _control_wire_hover_binding_id
+	for binding in _control_bindings:
+		if not bool(binding.get("enabled", true)):
+			continue
+		var pts := _control_wire_polyline(binding)
+		if pts.size() < 2:
+			continue
+		var color: Color = _RACK_CONTROL_LAYER_RULES_SCRIPT.CONTROL_COLOR
+		var binding_id := str(binding.get("binding_id", ""))
+		if binding_id == hover_id:
+			color = color.lightened(0.25)
+		_draw_dashed_polyline(pts, color, _RACK_CONTROL_LAYER_RULES_SCRIPT.CONTROL_WIRE_WIDTH + (1.0 if binding_id == hover_id else 0.0), _RACK_CONTROL_LAYER_RULES_SCRIPT.CONTROL_WIRE_DASH)
+		var mid := pts[pts.size() >> 1]
+		# 线中点菱形=绑定把手（点击=编辑卡）。
+		var handle_size := 5.0
+		var diamond := PackedVector2Array([
+			mid + Vector2(0, -handle_size),
+			mid + Vector2(handle_size, 0),
+			mid + Vector2(0, handle_size),
+			mid + Vector2(-handle_size, 0),
+		])
+		draw_colored_polygon(diamond, color)
+		if font != null:
+			var tooltip: String = _RACK_CONTROL_LAYER_RULES_SCRIPT.binding_wire_tooltip(binding)
+			var tsz := font.get_string_size(tooltip, HORIZONTAL_ALIGNMENT_LEFT, -1, max(fsize - 2, 9))
+			var tpos := mid + Vector2(8, -6)
+			draw_string(font, tpos, tooltip, HORIZONTAL_ALIGNMENT_LEFT, -1, max(fsize - 2, 9), Color(0.65, 0.60, 0.90, 0.92))
+	# 绑定拖拽预览（锚→光标紫虚线）。
+	if not _binding_drag.is_empty():
+		var cursor_screen: Vector2 = _binding_drag.get("cursor_screen", get_viewport().get_mouse_position())
+		var anchor: Variant = _binding_drag.get("anchor", null)
+		var from_pos := Vector2.ZERO
+		if anchor != null and is_instance_valid(anchor):
+			var gn3 := _find_control_node_for_anchor(anchor)
+			if gn3 != null:
+				from_pos = _control_screen_delta_to_canvas(gn3, (anchor as Control).get_global_rect().get_center())
+		var to_pos := _screen_point_to_canvas(cursor_screen)
+		if to_pos != Vector2.INF and from_pos != Vector2.ZERO:
+			_draw_dashed_polyline(PackedVector2Array([from_pos, to_pos]), _RACK_CONTROL_LAYER_RULES_SCRIPT.CONTROL_COLOR.lightened(0.2), 2.0, _RACK_CONTROL_LAYER_RULES_SCRIPT.CONTROL_WIRE_DASH)
+
+
+func _find_control_node_for_anchor(anchor: Control) -> GraphNode:
+	var node := anchor.get_parent()
+	while node != null:
+		if node is GraphNode and bool((node as GraphNode).get_meta("vit_control_node", false)):
+			return node as GraphNode
+		node = node.get_parent()
+	return null
+
+
+func _screen_point_to_canvas(screen_point: Vector2) -> Vector2:
+	var local := screen_point - get_global_rect().position
+	return local + scroll_offset
+
+
+## 乐观 pending 发送芯片（选定即连→内核确认回读前的过渡显示；TTL 回滚语义）。
+func _draw_pending_send_edges(font: Font, fsize: int) -> void:
+	if _pending_send_edges.is_empty():
