+# K3：绑定手势（锚拖出→参数口高亮→绑定菜单→control_add_binding）
+# ==========================================
+func _update_binding_drag(from_pos_screen: Vector2) -> void:
+	if _binding_drag.is_empty():
+		return
+	_binding_drag["cursor_screen"] = from_pos_screen
+	queue_redraw()
+
+
+func _finish_binding_drag(screen_pos: Vector2) -> void:
+	if _binding_drag.is_empty():
+		return
+	var drag := _binding_drag.duplicate(true)
+	_binding_drag = {}
+	queue_redraw()
+	var port := _hit_param_port_at_screen(screen_pos)
+	if port.is_empty():
+		return
+	var suggestion: Dictionary = _suggest_control_for_param(str(port.get("plugin_id", "")), str(port.get("param_id", "")))
+	_open_binding_menu({
+		"mode": "bind",
+		"source_node_id": str(drag.get("source_node_id", "")),
+		"source_output": str(drag.get("source_output", "")),
+		"plugin_id": str(port.get("plugin_id", "")),
+		"param_id": str(port.get("param_id", "")),
+		"param_name": str(port.get("param_name", "")),
+		"suggested_kind": str(suggestion.get("kind", "knob")),
+		"suggested_reason": str(suggestion.get("reason", "")),
+		"range_min": float(suggestion.get("min", 0.0)),
+		"range_max": float(suggestion.get("max", 1.0)),
+		"curve": "linear",
+	})
+
+
+func _cancel_binding_drag() -> void:
+	if _binding_drag.is_empty():
+		return
+	_binding_drag = {}
+	queue_redraw()
+
+
+func _hit_param_port_at_screen(screen_pos: Vector2) -> Dictionary:
+	var best: Dictionary = {}
+	for key in _param_port_controls.keys():
+		var entry: Dictionary = _param_port_controls.get(key, {}) as Dictionary
+		var control: Variant = entry.get("control", null)
+		if control == null or not is_instance_valid(control):
+			continue
+		if not control.is_visible_in_tree():
+			continue
+		var rect := (control as Control).get_global_rect()
+		rect = rect.grow(14.0)
+		if rect.has_point(screen_pos):
+			best = {
+				"plugin_id": str(entry.get("plugin_id", "")),
+				"param_id": str(entry.get("param_id", "")),
+				"param_name": str(entry.get("param_id", "")),
+			}
+			break
+	return best
+
