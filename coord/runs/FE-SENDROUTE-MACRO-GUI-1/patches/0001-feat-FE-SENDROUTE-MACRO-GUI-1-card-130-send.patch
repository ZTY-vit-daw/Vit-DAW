+		_check("scene track row fx role state settable", bool(track_row_scene_instance._fx_role_active), "role state not set")
+		track_row_scene_instance.free()
+	_check("scene track row refresh reads repo is_fx_track", _fake_repo.is_fx_track_calls >= 0, "repo callable")
