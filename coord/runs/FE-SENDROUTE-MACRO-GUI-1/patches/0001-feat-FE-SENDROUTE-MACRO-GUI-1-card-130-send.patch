+# ==========================================
+# K3：send 拓扑数据流（唯一读源=track.send.list；写回执自带同构快照）
+# ==========================================
+func _refresh_send_topology_from_repository() -> void:
+	var repo: Node = get_tree().get_first_node_in_group("project_repository")
+	if repo == null or not repo.has_method("get_send_topology"):
+		return
+	var topology: Dictionary = repo.call("get_send_topology") as Dictionary
+	if topology.is_empty():
+		return
+	_send_topology = topology
+	_update_send_route_node_labels()
+
+
+func _request_send_topology_refresh(force: bool = false) -> void:
+	var now := Time.get_ticks_msec()
+	if not force:
+		if _send_topology_refresh_in_flight and now - _send_topology_last_request_msec < 2000:
+			return
+		if now - _send_topology_last_request_msec < _SEND_TOPOLOGY_REFRESH_COOLDOWN_MSEC:
+			return
+	_send_topology_refresh_in_flight = true
+	_send_topology_last_request_msec = now
+	var rack_client: Variant = _vit_rack_client()
+	var queued: String = rack_client.track_send_list({}, "track_send_list")
+	if queued.is_empty():
+		_send_topology_refresh_in_flight = false
+		return
+	_rack_diag_log("track_send_list queued")
+
+
+func _apply_send_topology(topology: Dictionary, source_request_id: String = "") -> void:
+	_send_topology_refresh_in_flight = false
+	if topology.is_empty():
+		return
+	_send_topology = topology
+	var repo: Node = get_tree().get_first_node_in_group("project_repository")
+	if repo != null and repo.has_method("apply_send_topology"):
+		if repo.call("apply_send_topology", topology) and _project_event_hub != null:
+			_project_event_hub.send_topology_changed.emit(topology)
+	_update_send_route_node_labels()
+	_render_fx_source_list()
+	# 待定发送收口：确认到达（连上/已断）即清过渡显示。
+	for key in _pending_send_edges.keys():
+		var confirmed := false
+		for send_variant in topology.get("sends", []):
+			var send: Dictionary = send_variant
+			if _RACK_SEND_ROUTE_RULES_SCRIPT.send_edge_key(str(send.get("source_track_id", "")), str(send.get("fx_track_id", ""))) == key:
+				confirmed = true
+				break
+		if confirmed:
+			_pending_send_edges.erase(key)
+	_expire_pending_send_edges()
+	queue_redraw()
+	# 连接类写回执到达 → aux 插件对需要 project state 刷新才会出现在画布。
+	if source_request_id.begins_with("track_send_connect") or source_request_id.begins_with("track_send_disconnect"):
+		_request_project_state_refresh_single_flight()
+
+
+func _bind_send_control_ipc_signals() -> void:
+	var completed_cb := Callable(self, "_on_send_control_ipc_completed")
+	var timeout_cb := Callable(self, "_on_send_control_ipc_timed_out")
+	if _KERNEL_COMMAND_SIGNAL_BUS_SCRIPT.connect_command_completed(completed_cb):
+		_KERNEL_COMMAND_SIGNAL_BUS_SCRIPT.connect_command_timed_out(timeout_cb)
+
+
+func _request_matches_send_or_control(request_id: String) -> bool:
+	for prefix in _SEND_REQUEST_PREFIXES:
+		if request_id.begins_with(prefix):
+			return true
+	for prefix in _CONTROL_REQUEST_PREFIXES:
+		if request_id.begins_with(prefix):
+			return true
+	return false
+
+
+func _on_send_control_ipc_completed(request_id: String, reply: Dictionary, cmd: Dictionary) -> void:
+	if not _request_matches_send_or_control(request_id):
+		return
+	if request_id.begins_with("track_send"):
+		var topology: Dictionary = _RACK_SEND_ROUTE_RULES_SCRIPT.normalize_topology(reply)
+		_apply_send_topology(topology, request_id)
+		return
+	if request_id.begins_with("ctrl_params_"):
+		_on_param_port_rows_reply(request_id, reply)
+		return
+	# control_* 写命令：回执自带 control_graph 全量快照。
+	if request_id.begins_with("control_add_node"):
+		_flush_pending_control_binds(reply)
+	var graph_variant: Variant = reply.get("control_graph", null)
+	if typeof(graph_variant) == TYPE_DICTIONARY:
+		_apply_control_graph(graph_variant as Dictionary)
+
+
+func _on_send_control_ipc_timed_out(request_id: String, _cmd: Dictionary) -> void:
+	if not _request_matches_send_or_control(request_id):
+		return
+	if request_id.begins_with("track_send"):
+		_send_topology_refresh_in_flight = false
+		_expire_pending_send_edges()
+		queue_redraw()
+
+
