+
+var _checks_total := 0
+var _checks_failed := 0
+var _setup_failed := false
+var _phase := "init"
+var _phase_frame := 0
+var _stage: Node = null
+var _fake_debug_flags: Node = null
+var _probe_rack_script: GDScript = null
+var _rack: Variant = null
+var _fake_client: FakeRackClient = null
+var _fake_repo: FakeRepo = null
+var _hub: Node = null
+
+
+func _initialize() -> void:
+	print("[probe] FE-SENDROUTE-MACRO-GUI-1 send route + macro control layer suite start")
+	_fake_debug_flags = FakeDebugFlags.new()
+	Engine.register_singleton("VitDebugFlags", _fake_debug_flags)
+	_static_contract_checks()
+	_suite_send_rules()
+	_suite_control_rules()
+	_suite_selector_filter()
+	_setup_scene_suite()
+	# ③ 场景断言延后到首帧后执行（_initialize 阶段根窗口未就绪）。
+	_phase = "scene"
+
+
+func _process(_delta: float) -> bool:
+	if _phase != "scene":
+		return false
+	_phase_frame += 1
+	if _phase_frame >= 2:
+		_run_scene_suite()
+		_finish()
+		return true
+	return false
+
+
+func _finish() -> void:
+	if _setup_failed or _checks_failed > 0:
+		print("[probe] PROBE FAIL (checks_total=%d failed=%d setup_failed=%s)" % [_checks_total, _checks_failed, str(_setup_failed)])
+		_teardown()
+		quit(1)
+		return
+	print("[probe] PROBE PASS (checks_total=%d)" % _checks_total)
+	_teardown()
+	quit(0)
+
+
+func _teardown() -> void:
+	if _stage != null and is_instance_valid(_stage):
+		_stage.queue_free()
+
+
+func _check(label: String, ok: bool, detail: String) -> void:
+	_checks_total += 1
+	if ok:
+		print("[probe] PASS %s" % label)
+		return
+	_checks_failed += 1
+	print("[probe] FAIL %s | %s" % [label, detail])
+
+
+func _fail_setup(reason: String) -> void:
+	_setup_failed = true
+	_checks_failed += 1
+	print("[probe] FAIL setup: %s" % reason)
+	print("[probe] PROBE FAIL (setup)")
+	quit(2)
+
+
+# ==========================================================
+# ① 契约静态检查
+# ==========================================================
+func _static_contract_checks() -> void:
+	var rack_client_script: Variant = load(RACK_CLIENT_PATH)
+	var rack_client_instance: Variant = rack_client_script.new() if rack_client_script != null else null
+	for method_name in [
+		"track_send_connect", "track_send_set_amount", "track_send_disconnect", "track_send_list", "track_send_set_fx_role",
+		"control_add_node", "control_add_macro", "control_add_binding", "control_update_node",
+		"control_set_node_value", "control_set_macro_values", "control_update_binding",
+		"control_remove_binding", "control_remove_node",
+	]:
+		_check("contract rack_client.%s" % method_name, rack_client_instance != null and rack_client_instance.has_method(method_name), method_name)
+
+	var payload_script: Variant = load(PAYLOAD_RULES_PATH)
+	for method_name in [
+		"track_send_connect_payload", "track_send_connect_auto_create_payload", "track_send_connect_sidechain_payload",
+		"track_send_set_amount_payload", "track_send_disconnect_payload", "track_send_disconnect_sidechain_payload",
+		"track_send_list_payload", "track_send_set_fx_role_payload",
+		"control_add_node_payload", "control_add_macro_payload", "control_add_binding_payload",
+		"control_update_node_payload", "control_set_node_value_payload", "control_set_macro_values_payload",
+		"control_update_binding_payload", "control_remove_binding_payload", "control_remove_node_payload",
+	]:
+		_check("contract payload_rules.%s" % method_name, payload_script != null and payload_script.has_method(method_name), method_name)
+
+	var send_rules: Variant = load(SEND_RULES_PATH)
+	for method_name in ["is_send_out_entry", "is_send_in_entry", "normalize_topology", "sends_for_source", "sends_for_fx", "fx_track_id_set", "send_out_display", "amount_db_text", "default_fx_track_name", "target_selector_rows", "send_edge_key", "sidechain_edge_key"]:
+		_check("contract send_rules.%s" % method_name, send_rules != null and send_rules.has_method(method_name), method_name)
+
+	var selector: Variant = load(SELECTOR_PATH)
+	var selector_instance: Variant = selector.new() if selector != null else null
+	for method_name in ["filter_rows", "row_label", "open_at", "close_popup", "apply_query", "visible_count", "new_fx_name"]:
+		_check("contract selector.%s" % method_name, selector_instance != null and selector_instance.has_method(method_name), method_name)
+
+	var control_rules: Variant = load(CONTROL_RULES_PATH)
+	for method_name in ["normalize_control_kind", "outputs_for_kind", "macro_output_names", "suggest_control_kind", "signal_layer_visible", "control_layer_visible", "signal_layer_dimmed", "normalize_binding", "curve_apply", "dual_output_kind"]:
+		_check("contract control_rules.%s" % method_name, control_rules != null and control_rules.has_method(method_name), method_name)
+
+	var widget_factory: Variant = load(WIDGET_FACTORY_PATH)
+	for method_name in ["create_control_widget", "is_shell_kind"]:
+		_check("contract widget_factory.%s" % method_name, widget_factory != null and widget_factory.has_method(method_name), method_name)
+
+	var track_kind: Variant = load(TRACK_KIND_PATH)
+	_check("contract EFFECT_RETURN enum enabled", track_kind_script_has_effect_return(track_kind), "EFFECT_RETURN=3 missing")
+
+	var track_row: Variant = load(TRACK_ROW_CONTROLLER_PATH)
+	var track_row_instance: Variant = track_row.new() if track_row != null else null
+	for method_name in ["set_fx_return_role", "_refresh_fx_return_role", "_ensure_fx_role_badge"]:
+		_check("contract track_row.%s" % method_name, track_row_instance != null and track_row_instance.has_method(method_name), method_name)
+
+
+func track_kind_script_has_effect_return(track_kind: Variant) -> bool:
+	if track_kind == null:
+		return false
+	return int(track_kind.Kind.EFFECT_RETURN) == 3
+
+
+# ==========================================================
+# ② 纯函数套件
+# ==========================================================
+func _suite_send_rules() -> void:
+	var rules: Variant = load(SEND_RULES_PATH)
+	var reply := {
+		"sends": [
+			{"source_track_id": FIXTURE_SOURCE_TRACK, "source_name": "vocals", "fx_track_id": FIXTURE_FX_TRACK, "fx_name": "Reverb Bus", "amount_db": -6.0, "send_bus": 2, "return_bus": 3},
+			{"source_track_id": FIXTURE_OTHER_TRACK, "source_name": "guitar", "fx_track_id": FIXTURE_FX_TRACK, "fx_name": "Reverb Bus", "amount_db": -12.5, "send_bus": 2, "return_bus": 3},
+		],
+		"dangling": [{"source_track_id": "1099", "source_name": "dead", "fx_track_id": "", "fx_name": "", "amount_db": 0.0, "send_bus": 8, "return_bus": -1}],
+		"fx_tracks": [{"track_id": FIXTURE_FX_TRACK, "name": "Reverb Bus", "send_bus": 2, "return_bus": 3, "source_count": 2}],
+		"sidechain": [{"source_track_id": FIXTURE_SOURCE_TRACK, "track_id": FIXTURE_OTHER_TRACK, "track_name": "guitar", "plugin_item_id": "p_sc", "plugin_name": "ZamComp"}],
+	}
+	var topology: Dictionary = rules.normalize_topology(reply)
+	_check("send normalize sends count", int(topology.get("sends", []).size()) == 2, str(topology.get("sends", []).size()))
+	_check("send normalize dangling preserved", int(topology.get("dangling", []).size()) == 1, str(topology.get("dangling", []).size()))
+	_check("send normalize fx_tracks", str((topology.get("fx_tracks", []) as Array)[0].get("name", "")) == "Reverb Bus", "fx row name")
+	var fx_set: Dictionary = rules.fx_track_id_set(topology)
+	_check("send fx_track_id_set", fx_set.has(FIXTURE_FX_TRACK) and not fx_set.has(FIXTURE_SOURCE_TRACK), str(fx_set))
+	_check("send sends_for_source", rules.sends_for_source(topology, FIXTURE_SOURCE_TRACK).size() == 1, "source filter")
+	_check("send sends_for_fx", rules.sends_for_fx(topology, FIXTURE_FX_TRACK).size() == 2, "fx filter")
+	var display: Dictionary = rules.send_out_display("p_sendout", topology, FIXTURE_SOURCE_TRACK)
+	_check("send send_out_display target", str(display.get("target_name", "")) == "Reverb Bus", str(display.get("target_name", "")))
+	_check("send send_out_display amount", is_equal_approx(float(display.get("amount_db", 0.0)), -6.0), str(display.get("amount_db", "")))
+	var sc_display: Dictionary = rules.send_out_display("p_sc", topology, FIXTURE_SOURCE_TRACK)
+	_check("send send_out_display sidechain", bool(sc_display.get("is_sidechain", false)) and str(sc_display.get("target_name", "")).contains("ZamComp"), str(sc_display))
+	_check("send amount_db_text", str(rules.amount_db_text(-96.0)) == "off" and str(rules.amount_db_text(-6.0)) == "-6.0 dB", "text form")
+	_check("send default_fx_track_name reverb", str(rules.default_fx_track_name("plate")) == "Reverb Bus", "reverb default")
+	_check("send default_fx_track_name delay", str(rules.default_fx_track_name("pingpong delay")) == "Delay Bus", "delay default")
+	_check("send is_send_out_entry", rules.is_send_out_entry({"type": "auxsend"}) and not rules.is_send_out_entry({"type": "auxreturn"}), "detect")
+	var rows: Array = rules.target_selector_rows(
+		[{"id": FIXTURE_SOURCE_TRACK, "name": "vocals"}, {"id": FIXTURE_FX_TRACK, "name": "Reverb Bus"}, {"id": FIXTURE_OTHER_TRACK, "name": "guitar"}],
+		topology, FIXTURE_SOURCE_TRACK,
+		{FIXTURE_OTHER_TRACK: [{"type": "audio_fx", "name": "ZamComp", "plugin_item_id": "p_sc"}, {"type": "volume", "name": "vol"}]}
+	)
+	var kinds := []
+	for row_variant in rows:
+		kinds.append(str((row_variant as Dictionary).get("kind", "")))
+	_check("send selector rows fx first", kinds.size() > 0 and kinds[0] == "fx", str(kinds))
+	_check("send selector rows self excluded", not rows.any(func(row: Variant) -> bool: return str((row as Dictionary).get("track_id", "")) == FIXTURE_SOURCE_TRACK), "self in rows")
+	_check("send selector rows sidechain leaf", kinds.has("sidechain"), str(kinds))
+	_check("send selector rows new_fx tail", kinds.size() > 0 and kinds[kinds.size() - 1] == "new_fx", str(kinds))
