+func _open_binding_menu(context: Dictionary) -> void:
+	_build_binding_menu()
+	_binding_menu_context = context
+	var mode := str(context.get("mode", "bind"))
+	var target_text := "%s · %s" % [str(context.get("plugin_id", "")), str(context.get("param_id", ""))]
+	if mode == "create_control":
+		_binding_menu.title = "新建控件 → %s" % target_text
+	elif not str(context.get("binding_id", "")).is_empty():
+		_binding_menu.title = "编辑绑定 → %s" % target_text
+		_binding_menu_context["mode"] = "edit_binding"
+	else:
+		_binding_menu.title = "绑定 → %s" % target_text
+	_binding_menu_min_edit.value = float(context.get("range_min", 0.0))
+	_binding_menu_max_edit.value = float(context.get("range_max", 1.0))
+	var curve := str(context.get("curve", "linear"))
+	var curve_index := 0
+	for i in range(_binding_menu_curve_option.item_count):
+		if _binding_menu_curve_option.get_item_text(i) == curve:
+			curve_index = i
+			break
+	_binding_menu_curve_option.selected = curve_index
+	var suggested := str(context.get("suggested_kind", "knob"))
+	var kind_index := 0
+	for i in range(_binding_menu_kind_option.item_count):
+		if _binding_menu_kind_option.get_item_text(i) == suggested:
+			kind_index = i
+			break
+	_binding_menu_kind_option.selected = kind_index
+	_binding_menu.popup_centered()
+
