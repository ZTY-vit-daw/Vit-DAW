diff --git a/app/rack/rack_send_route_rules.gd b/app/rack/rack_send_route_rules.gd
new file mode 100644
index 0000000..70a8080
--- /dev/null
+++ b/app/rack/rack_send_route_rules.gd
@@ -0,0 +1,280 @@
+extends RefCounted
+class_name RackSendRouteRules
+
+# ==============================================================================
+# FE-SENDROUTE-MACRO-GUI-1 (K3)：send/return 机架呈现规则（纯函数，探针直断面）。
+# 底层事实（MIX-SENDRETURN-DESIGN-1 §9.1）：SendOut/SendIn = pluginList 里的
+# AuxSend/AuxReturn 插件的 GUI 呈名（零聚合投影层）——内核 state 的 plugins 数组里
+# type="auxsend"/"auxreturn"；轨间拓扑（source→fx 映射/发送量/侧链）唯一读源 =
+# track.send.list 回执（K1 已合入，每写命令回执自带同构快照 sends/dangling/fx_tracks/
+# sidechain）。本模块不做 IPC、不碰 UI 树，只做检测/规整/派生。
+# ==============================================================================
+
+const PLUGIN_TYPE_SEND_OUT := "auxsend"
+const PLUGIN_TYPE_SEND_IN := "auxreturn"
+const SEND_OUT_TAG := "SEND ▸"
+const SEND_IN_TAG := "◂ SEND"
+const DEFAULT_NEW_FX_NAME := "Reverb Bus"
+
+const _PLUGIN_PAYLOAD_RULES_SCRIPT: Variant = preload("res://app/rack/rack_plugin_payload_rules.gd")
+
+## 拖拽排序换位说明（诚实边界）：内核 move_plugin 已在 DAG rack 模式废弃
+# （PluginRackControlService::handleMovePlugin 拒绝），无索引换位命令面——
+# SendOut 链位（tap 点）与 SendIn 汇入点由既有 DAG 连线语义表达（重连电缆），
+# 与效果器同构；内核侧 K1 只保证成对有序（SendOut 严格先于同对 SendIn）。
+
+
+static func is_send_out_entry(entry: Dictionary) -> bool:
+	return str(entry.get("type", "")).strip_edges().to_lower() == PLUGIN_TYPE_SEND_OUT
+
+
+static func is_send_in_entry(entry: Dictionary) -> bool:
+	return str(entry.get("type", "")).strip_edges().to_lower() == PLUGIN_TYPE_SEND_IN
+
+
+static func is_send_route_entry(entry: Dictionary) -> bool:
+	return is_send_out_entry(entry) or is_send_in_entry(entry)
+
+
+## 规整 track.send.list / 写命令回执的拓扑快照为稳定结构：
+## {sends: [...], dangling: [...], fx_tracks: [...], sidechain: [...]}（深拷贝、字段成串）。
+static func normalize_topology(reply: Variant) -> Dictionary:
+	var empty := {"sends": [], "dangling": [], "fx_tracks": [], "sidechain": []}
+	if typeof(reply) != TYPE_DICTIONARY:
+		return empty
+	var source := reply as Dictionary
+	var out := {
+		"sends": _normalize_rows(source.get("sends", [])),
+		"dangling": _normalize_rows(source.get("dangling", [])),
+		"fx_tracks": _normalize_fx_rows(source.get("fx_tracks", [])),
+		"sidechain": _normalize_sidechain_rows(source.get("sidechain", [])),
+	}
+	return out
+
+
+static func _normalize_rows(rows: Variant) -> Array:
+	var out: Array = []
+	if typeof(rows) != TYPE_ARRAY:
+		return out
+	for row_variant in rows as Array:
+		if typeof(row_variant) != TYPE_DICTIONARY:
+			continue
+		var row := row_variant as Dictionary
+		out.append({
+			"source_track_id": str(row.get("source_track_id", "")).strip_edges(),
+			"source_name": str(row.get("source_name", "")).strip_edges(),
+			"fx_track_id": str(row.get("fx_track_id", "")).strip_edges(),
+			"fx_name": str(row.get("fx_name", "")).strip_edges(),
+			"amount_db": float(row.get("amount_db", 0.0)),
+			"send_bus": int(row.get("send_bus", -1)),
+			"return_bus": int(row.get("return_bus", -1)),
+		})
+	return out
+
+
+static func _normalize_fx_rows(rows: Variant) -> Array:
+	var out: Array = []
+	if typeof(rows) != TYPE_ARRAY:
+		return out
+	for row_variant in rows as Array:
+		if typeof(row_variant) != TYPE_DICTIONARY:
+			continue
+		var row := row_variant as Dictionary
+		out.append({
+			"track_id": str(row.get("track_id", "")).strip_edges(),
+			"name": str(row.get("name", "")).strip_edges(),
+			"send_bus": int(row.get("send_bus", -1)),
+			"return_bus": int(row.get("return_bus", -1)),
+			"source_count": int(row.get("source_count", 0)),
+		})
+	return out
+
+
+static func _normalize_sidechain_rows(rows: Variant) -> Array:
+	var out: Array = []
+	if typeof(rows) != TYPE_ARRAY:
+		return out
+	for row_variant in rows as Array:
+		if typeof(row_variant) != TYPE_DICTIONARY:
+			continue
+		var row := row_variant as Dictionary
+		out.append({
+			"source_track_id": str(row.get("source_track_id", "")).strip_edges(),
+			"track_id": str(row.get("track_id", "")).strip_edges(),
+			"track_name": str(row.get("track_name", "")).strip_edges(),
+			"plugin_item_id": str(row.get("plugin_item_id", "")).strip_edges(),
+			"plugin_name": str(row.get("plugin_name", "")).strip_edges(),
+		})
+	return out
+
+
+static func send_edge_key(source_track_id: String, fx_track_id: String) -> String:
+	return "send:%s>%s" % [source_track_id.strip_edges(), fx_track_id.strip_edges()]
+
+
+static func sidechain_edge_key(source_track_id: String, plugin_item_id: String) -> String:
+	return "send:sc:%s>%s" % [source_track_id.strip_edges(), plugin_item_id.strip_edges()]
+
+
+## FX 轨集合（track_id -> true），供轨列表徽标 / 选择器分组 / 画布视角判定。
+static func fx_track_id_set(topology: Dictionary) -> Dictionary:
+	var out: Dictionary = {}
+	for fx_variant in topology.get("fx_tracks", []):
+		var fx: Dictionary = fx_variant
+		var track_id := str(fx.get("track_id", "")).strip_edges()
+		if not track_id.is_empty():
+			out[track_id] = true
+	return out
+
+
+## 该轨作为源的全部发送（SEND 槽位数据源——裁定 2 主控面）。
+static func sends_for_source(topology: Dictionary, track_id: String) -> Array:
+	var clean := track_id.strip_edges()
+	var out: Array = []
+	for send_variant in topology.get("sends", []):
+		var send: Dictionary = send_variant
+		if str(send.get("source_track_id", "")) == clean:
+			out.append(send)
+	return out
+
+
+## 发送到该 FX 轨的全部源（FX 轨只读来源列表数据源）。
+static func sends_for_fx(topology: Dictionary, track_id: String) -> Array:
+	var clean := track_id.strip_edges()
+	var out: Array = []
+	for send_variant in topology.get("sends", []):
+		var send: Dictionary = send_variant
+		if str(send.get("fx_track_id", "")) == clean:
+			out.append(send)
+	return out
+
+
+static func find_send(topology: Dictionary, source_track_id: String, fx_track_id: String) -> Dictionary:
+	var key := send_edge_key(source_track_id, fx_track_id)
+	for send_variant in topology.get("sends", []):
+		var send: Dictionary = send_variant
+		if send_edge_key(str(send.get("source_track_id", "")), str(send.get("fx_track_id", ""))) == key:
+			return send
+	return {}
+
+
+## SendOut 卡显示派生：{tag, target_name, amount_db, is_sidechain, fx_track_id}。
+## 音频发送：目标名/量来自拓扑快照（按源轨定位——插件侧无 bus→fx 映射，快照是唯一读源）；
+## 侧链发送：目标名来自 sidechain 行（按 plugin_item_id 定位），无发送量。
+static func send_out_display(plugin_item_id: String, topology: Dictionary, track_id: String) -> Dictionary:
+	var out := {
+		"tag": SEND_OUT_TAG,
+		"target_name": "",
+		"amount_db": 0.0,
+		"is_sidechain": false,
+		"fx_track_id": "",
+	}
+	var clean_plugin := plugin_item_id.strip_edges()
+	var clean_track := track_id.strip_edges()
+	for sc_variant in topology.get("sidechain", []):
+		var sc: Dictionary = sc_variant
+		if str(sc.get("plugin_item_id", "")) == clean_plugin:
+			out.is_sidechain = true
+			out.target_name = "%s · %s" % [str(sc.get("track_name", "")), str(sc.get("plugin_name", ""))]
+			out.fx_track_id = str(sc.get("track_id", ""))
+			return out
+	for send_variant in sends_for_source(topology, clean_track):
+		var send: Dictionary = send_variant
+		if str(send.get("source_track_id", "")) == clean_track:
+			# 同源多 FX 时按发送量行序对齐（插件序与拓扑序一致由内核链序保证）。
+			out.target_name = str(send.get("fx_name", ""))
+			out.amount_db = float(send.get("amount_db", 0.0))
+			out.fx_track_id = str(send.get("fx_track_id", ""))
+			return out
+	out.target_name = "（悬空）"
+	return out
+
+
+static func amount_db_text(db: float) -> String:
+	if db <= -95.9:
+		return "off"
+	return "%+.1f dB" % db
+
+
+## 新建 FX 轨默认名建议（§9.2「Reverb Bus 2 类」）：按触发来源插件类别的确定性映射。
+static func default_fx_track_name(hint_text: String = "") -> String:
+	var hint := hint_text.strip_edges().to_lower()
+	if hint.contains("delay") or hint.contains("echo"):
+		return "Delay Bus"
+	if hint.contains("comp") or hint.contains("duck"):
+		return "Comp Bus"
+	if hint.contains("chorus") or hint.contains("flanger") or hint.contains("phaser"):
+		return "Mod Bus"
+	return DEFAULT_NEW_FX_NAME
+
+
+## 目标选择器数据构建：分组「FX 轨」/「普通轨」+每轨插件侧链口（可展开叶）+
+## 底部「＋新建 FX 轨」；行结构 {kind: fx|track|sidechain|new_fx, ...叶子字段}。
+## tracks=repository 轨行（{id,name,...}）；rack_nodes_by_track=每轨插件行（侧链口用）。
+static func target_selector_rows(tracks: Array, topology: Dictionary, current_track_id: String, rack_nodes_by_track: Dictionary) -> Array:
+	var fx_ids := fx_track_id_set(topology)
+	var rows: Array = []
+	for track_variant in tracks:
+		if typeof(track_variant) != TYPE_DICTIONARY:
+			continue
+		var track: Dictionary = track_variant
+		var track_id := str(track.get("id", "")).strip_edges()
+		var track_name := str(track.get("name", "")).strip_edges()
+		if track_id.is_empty() or track_id == current_track_id.strip_edges():
+			continue
+		var is_fx := fx_ids.has(track_id)
+		rows.append({
+			"kind": "fx" if is_fx else "track",
+			"track_id": track_id,
+			"track_name": track_name,
+			"send_count": int(_fx_source_count(topology, track_id)),
+		})
+		var plugins_variant: Variant = rack_nodes_by_track.get(track_id, [])
+		if typeof(plugins_variant) == TYPE_ARRAY:
+			for plugin_variant in plugins_variant as Array:
+				if typeof(plugin_variant) != TYPE_DICTIONARY:
+					continue
+				var plugin: Dictionary = plugin_variant
+				var plugin_type := str(plugin.get("type", "")).strip_edges().to_lower()
+				if plugin_type.is_empty() or plugin_type in ["volume", "level", PLUGIN_TYPE_SEND_OUT, PLUGIN_TYPE_SEND_IN]:
+					continue
+				rows.append({
+					"kind": "sidechain",
+					"track_id": track_id,
+					"track_name": track_name,
+					"plugin_item_id": str(_PLUGIN_PAYLOAD_RULES_SCRIPT.plugin_item_id_from_entry(plugin)),
+					"plugin_name": str(plugin.get("name", "")).strip_edges(),
+				})
+	rows.sort_custom(_selector_row_less)
+	rows.append({
+		"kind": "new_fx",
+		"track_id": "",
+		"track_name": "",
+		"default_name": DEFAULT_NEW_FX_NAME,
+	})
+	return rows
+
+
+static func _fx_source_count(topology: Dictionary, track_id: String) -> int:
+	for fx_variant in topology.get("fx_tracks", []):
+		var fx: Dictionary = fx_variant
+		if str(fx.get("track_id", "")) == track_id.strip_edges():
+			return int(fx.get("source_count", 0))
+	return 0
+
+
+static func _selector_row_less(a: Dictionary, b: Dictionary) -> bool:
+	var rank := func(kind: String) -> int:
+		match kind:
+			"fx":
+				return 0
+			"track":
+				return 1
+			"sidechain":
+				return 2
+		return 3
+	var rank_a: int = rank.call(str(a.get("kind", "")))
+	var rank_b: int = rank.call(str(b.get("kind", "")))
+	if rank_a != rank_b:
+		return rank_a < rank_b
+	return str(a.get("track_name", "")).naturalnocasecmp_to(str(b.get("track_name", ""))) < 0
