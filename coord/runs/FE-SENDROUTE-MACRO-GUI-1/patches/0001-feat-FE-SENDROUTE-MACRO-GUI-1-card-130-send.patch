+func _refresh_send_slots() -> void:
+	if _send_panel == null or not is_instance_valid(_send_panel):
+		return
+	var kid := bound_kernel_track_id.strip_edges()
+	for child in _send_panel.get_children():
+		child.queue_free()
+	var sends: Array = []
+	if not kid.is_empty():
+		var tree := get_tree()
+		if tree != null:
