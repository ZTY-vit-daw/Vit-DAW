+	rack._on_vit_rack_gui_input(_right_button(Vector2(400.0, 300.0), true))
+	_check("scene wire right-click noop without hit", _collect_cmds("control_remove_binding").size() == before_remove, "unexpected remove")
+	# 直接命中路径：_pick_control_wire_near_point 依赖屏幕几何，headless 用几何兜底断言函数存在与空命中安全。
+	_check("scene wire pick empty safe", rack._pick_control_wire_near_point(Vector2(9900.0, 9900.0)).is_empty(), "far point hit")
+
+	# --- 场景 9：SEND 槽位（通道条场景） ---
+	_suite_mixer_strip()
+
+	# --- 场景 10：Track_Row FX 徽标契约面（3D 场景依赖，DOM 徽标归真栈腿） ---
+	var track_row_script: Variant = load(TRACK_ROW_CONTROLLER_PATH)
+	var track_row_scene_instance: Variant = track_row_script.new() if track_row_script != null else null
+	_check("scene track row set_fx_return_role callable", track_row_scene_instance != null and track_row_scene_instance.has_method("set_fx_return_role"), "method missing")
