+const RACK_CLIENT_PATH := "res://app/kernel/clients/rack_client.gd"
+const PAYLOAD_RULES_PATH := "res://app/rack/rack_ipc_payload_rules.gd"
+const EVENT_HUB_PATH := "res://vit_dock/core/project_event_hub.gd"
+const STRIP_SCENE_PATH := "res://vit_dock/views/mixer/vit_mixer_channel_strip.tscn"
+const TRACK_ROW_CONTROLLER_PATH := "res://app/tracks/track_scene/Track_Row_Controller.gd"
+const TRACK_KIND_PATH := "res://app/tracks/vit_daw_track_kind.gd"
+
