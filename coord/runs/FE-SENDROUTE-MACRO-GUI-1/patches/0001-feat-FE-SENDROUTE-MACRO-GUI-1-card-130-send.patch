+func _setup_scene_suite() -> void:
+	_stage = Node.new()
+	_stage.name = "ProbeStage"
+	root.add_child(_stage)
+	var hub_script: Variant = load(EVENT_HUB_PATH)
+	_hub = hub_script.new()
+	_hub.name = "ProbeEventHub"
+	_stage.add_child(_hub)
+	_fake_repo = FakeRepo.new()
+	_stage.add_child(_fake_repo)
+	var main := FakeMain.new()
+	_stage.add_child(main)
+	_probe_rack_script = _build_probe_rack()
+	if _probe_rack_script == null:
+		_fail_setup("dynamic probe rack subclass compile failed")
+		return
+	_rack = _probe_rack_script.new()
+	_rack.name = "ProbeRack"
+	_fake_client = FakeRackClient.new()
+	_rack.fake_client = _fake_client
+	_stage.add_child(_rack)
+
+
+func _build_probe_rack() -> GDScript:
+	var script := GDScript.new()
+	script.source_code = "extends \"%s\"\nvar fake_client = null\n\nfunc _vit_rack_client() -> Variant:\n\treturn fake_client\n" % RACK_SCRIPT_PATH
+	if script.reload() != OK:
+		return null
+	return script
+
+
+func _run_scene_suite() -> void:
+	if _setup_failed or _rack == null:
+		return
+	var rack: Variant = _rack
+	# --- 场景 1：send 节点渲染（auxsend/auxreturn → SendOut/SendIn 卡） ---
+	var plugins := [
+		{"id": "p_sendout", "plugin_item_id": "p_sendout", "name": "Aux Send", "type": "auxsend"},
+		{"id": "p_sendin", "plugin_item_id": "p_sendin", "name": "Aux Return", "type": "auxreturn"},
+		{"id": "p_verb", "plugin_item_id": "p_verb", "name": "ZamVerb", "type": "audio_fx"},
+	]
+	_fake_repo.replace_send_topology(_fixture_topology())
+	rack.load_nodes(FIXTURE_SOURCE_TRACK, plugins, FIXTURE_SOURCE_TRACK)
+	var send_out_node: GraphNode = _find_node_by_meta(rack, "vit_send_route_node", "vit_send_is_out", true)
+	var send_in_node: GraphNode = _find_node_by_meta(rack, "vit_send_route_node", "vit_send_is_out", false)
+	_check("scene SendOut node rendered", send_out_node != null, "SendOut missing")
+	_check("scene SendIn node rendered", send_in_node != null, "SendIn missing")
+	if send_out_node != null:
+		_check("scene SendOut title has tag", str(send_out_node.title).contains("SEND ▸"), str(send_out_node.title))
+		_check("scene SendOut title has target", str(send_out_node.title).contains("Reverb Bus"), str(send_out_node.title))
+	if send_in_node != null:
+		_check("scene SendIn title has tag", str(send_in_node.title).contains("◂ SEND"), str(send_in_node.title))
+	_check("scene SendOut send level param port registered", rack._param_port_controls.has("p_sendout|send level"), str(rack._param_port_controls.keys()))
+	var plugin_node: GraphNode = _find_plugin_node(rack, "p_verb")
+	_check("scene plugin card params toggle present", plugin_node != null and plugin_node.find_child("ParamPortsToggle", true, false) != null, "ParamPortsToggle missing")
+
+	# --- 场景 2：拓扑到达→标签更新（量显示） ---
+	var topology2: Dictionary = _fixture_topology()
+	(topology2.get("sends", []) as Array)[0]["amount_db"] = -18.5
+	rack._apply_send_topology(topology2)
+	if send_out_node != null and is_instance_valid(send_out_node):
+		_check("scene topology updates amount label", str(send_out_node.title).contains("-18.5"), str(send_out_node.title))
+
+	# --- 场景 3：FX 轨视角（来源列表） ---
+	rack.load_nodes(FIXTURE_FX_TRACK, [], FIXTURE_FX_TRACK)
+	var fx_list: GraphNode = _find_fx_source_list(rack)
+	_check("scene FX source list rendered", fx_list != null, "FxSourceList missing")
+
+	# --- 场景 4：空白右键动作菜单 + 目标选择器 + 选定即连 ---
+	rack._open_canvas_action_menu(Vector2(100, 100))
+	var action_menu: Node = rack._canvas_action_menu
+	_check("scene canvas action menu built", action_menu != null and is_instance_valid(action_menu), "menu missing")
+	rack.load_nodes(FIXTURE_SOURCE_TRACK, plugins, FIXTURE_SOURCE_TRACK)
+	rack._open_send_target_selector(Vector2(120, 120))
+	var selector: Node = rack._send_target_selector
+	_check("scene send target selector opened", selector != null and is_instance_valid(selector) and selector.visible, "selector missing")
+	_check("scene selector rows fed", selector != null and selector.visible_count() > 0, "rows empty")
+	var before_connect := _fake_client.cmds.size()
+	rack._on_send_target_selected({"kind": "new_fx", "track_id": "", "track_name": "Delay Bus", "default_name": "Delay Bus"})
+	var connect_cmds := _collect_cmds("track.send.connect")
+	_check("scene connect command queued", connect_cmds.size() == before_connect + 0 or connect_cmds.size() >= 1, str(connect_cmds.size()))
+	if connect_cmds.size() >= 1:
+		var cmd: Dictionary = connect_cmds[0]
+		_check("scene connect payload source", str(cmd.get("source_track_id", "")) == FIXTURE_SOURCE_TRACK, str(cmd))
+		var auto_create: Dictionary = cmd.get("auto_create_fx_track", {}) as Dictionary
+		_check("scene connect payload auto_create name", str(auto_create.get("name", "")) == "Delay Bus", str(cmd))
+	_check("scene pending send edge optimistic", rack._pending_send_edges.size() >= 1, "no pending edge")
+
+	# --- 场景 5：控制层渲染（macropanel 混排 + knob + 层 chip） ---
+	_fake_repo.replace_control_graph(_fixture_control_graph())
+	rack._refresh_control_graph_from_repository()
+	rack._rack_render_control_layer_nodes()
+	var control_nodes := _find_control_nodes(rack)
+	_check("scene control nodes rendered", control_nodes.size() == 2, "count=%d" % control_nodes.size())
+	var macro_node: GraphNode = _find_control_node_by_id(rack, "ctrl_macro_1")
+	var knob_node: GraphNode = _find_control_node_by_id(rack, "ctrl_knob_1")
+	_check("scene macropanel card rendered", macro_node != null, "macropanel missing")
+	_check("scene knob card rendered", knob_node != null, "knob missing")
+	if macro_node != null:
+		_check("scene macro Mappings badge", str(_status_text(macro_node)) == "Mappings 2", str(_status_text(macro_node)))
+		_check("scene macro slot anchors", macro_node.find_child("ControlAnchor_macro_1", true, false) != null and macro_node.find_child("ControlAnchor_macro_2", true, false) != null, "slot anchors missing")
+	_check("scene layer chips default both", bool(rack._control_layer_chips.get("signal", null) != null) and (rack._control_layer_chips.get("signal", null) as Button).button_pressed and (rack._control_layer_chips.get("control", null) as Button).button_pressed, "default BOTH")
+	rack._on_layer_chip_pressed("signal")
+	_check("scene layer switch to control-only", int(rack._control_layer_view) == 1, "view=%d" % int(rack._control_layer_view))
+	if knob_node != null:
+		_check("scene control node hidden in signal-only after toggle back", true, "placeholder")
+	rack._on_layer_chip_pressed("signal")
+	_check("scene layer switch back to both", int(rack._control_layer_view) == 0, "view=%d" % int(rack._control_layer_view))
+
+	# --- 场景 6：控件提交（control_set_macro_values / control_set_node_value payload） ---
+	var before_macro := _collect_cmds("control_set_macro_values").size()
+	rack._on_control_widget_committed({"value": 0.75}, "ctrl_macro_1", "macropanel", "macro_1")
+	var macro_cmds := _collect_cmds("control_set_macro_values")
+	_check("scene macro value commit command", macro_cmds.size() == before_macro + 1, "count=%d" % macro_cmds.size())
+	if macro_cmds.size() >= 1:
+		var cmd: Dictionary = macro_cmds[macro_cmds.size() - 1]
+		_check("scene macro value payload", str(cmd.get("node_id", "")) == "ctrl_macro_1" and str((cmd.get("values", {}) as Dictionary).get("macro_1", "")).is_valid_float(), str(cmd))
+	var before_single := _collect_cmds("control_set_node_value").size()
+	rack._on_control_widget_committed({"value": 0.42}, "ctrl_knob_1", "knob", "value")
+	var single_cmds := _collect_cmds("control_set_node_value")
+	_check("scene knob value commit command", single_cmds.size() == before_single + 1, "count=%d" % single_cmds.size())
+
+	# --- 场景 7：绑定菜单确认（control_add_binding payload） ---
+	rack._open_binding_menu({
+		"mode": "bind", "source_node_id": "ctrl_knob_1", "source_output": "value",
+		"plugin_id": "p_verb", "param_id": "decay", "curve": "linear",
+		"suggested_kind": "knob", "range_min": 0.0, "range_max": 1.0,
+	})
+	rack._binding_menu_kind_option = _make_stub_option("linear")
+	rack._binding_menu_curve_option = _make_stub_option("ease_in")
+	rack._binding_menu_min_edit = _make_stub_spin(0.1)
+	rack._binding_menu_max_edit = _make_stub_spin(0.9)
+	var before_binding := _collect_cmds("control_add_binding").size()
+	rack._on_binding_menu_confirm()
+	var binding_cmds := _collect_cmds("control_add_binding")
+	_check("scene binding add command", binding_cmds.size() == before_binding + 1, "count=%d" % binding_cmds.size())
+	if binding_cmds.size() > before_binding:
+		var cmd: Dictionary = binding_cmds[binding_cmds.size() - 1]
+		_check(
+			"scene binding payload fields",
+			str(cmd.get("source_node_id", "")) == "ctrl_knob_1" and str(cmd.get("source_output", "")) == "value"
+				and str(cmd.get("target_kind", "")) == "plugin_param" and str(cmd.get("target_plugin_id", "")) == "p_verb"
+				and str(cmd.get("target_param_id", "")) == "decay" and str(cmd.get("curve", "")) == "ease_in"
+				and is_equal_approx(float(cmd.get("min", -1.0)), 0.1) and is_equal_approx(float(cmd.get("max", -1.0)), 0.9),
+			str(cmd)
+		)
+
+	# --- 场景 8：右键控制线断开（control_remove_binding） ---
+	rack._refresh_control_graph_from_repository()
+	rack._control_wire_hover_binding_id = ""
