+# ==========================================
+# K3：send 创建一步化（§9.0-3 目标选择器→选定即连+乐观 pending）
+# ==========================================
+func _build_send_target_selector() -> void:
+	if _send_target_selector != null and is_instance_valid(_send_target_selector):
+		return
+	_send_target_selector = _RACK_SEND_TARGET_SELECTOR_SCRIPT.new()
+	_send_target_selector.name = "RackSendTargetSelector"
+	add_child(_send_target_selector)
+	_send_target_selector.send_target_selected.connect(_on_send_target_selected)
+
+
+func _open_send_target_selector(local_pos: Vector2) -> void:
+	var tid := str(_bound_kernel_track_id).strip_edges()
+	if tid.is_empty():
+		tid = _resolve_current_kernel_track_id()
+	if tid.is_empty():
+		_rack_ipc_alert("未选定轨道，无法创建发送")
+		return
+	var repo: Node = get_tree().get_first_node_in_group("project_repository")
+	if repo == null:
+		_rack_ipc_alert("工程仓库不可用")
+		return
+	var tracks: Array = []
+	if repo.has_method("get_tracks"):
+		var tracks_variant: Variant = repo.call("get_tracks")
+		if typeof(tracks_variant) == TYPE_ARRAY:
+			tracks = tracks_variant as Array
+	var rack_nodes_by_track: Dictionary = {}
+	if repo.has_method("get_rack_nodes_by_track"):
+		rack_nodes_by_track = repo.call("get_rack_nodes_by_track") as Dictionary
+	var rows: Array = _RACK_SEND_ROUTE_RULES_SCRIPT.target_selector_rows(tracks, _send_topology, tid, rack_nodes_by_track)
+	_build_send_target_selector()
+	var track_name := ""
+	if repo.has_method("get_track"):
+		var track_variant: Variant = repo.call("get_track", tid)
+		if typeof(track_variant) == TYPE_DICTIONARY:
+			track_name = str((track_variant as Dictionary).get("name", "")).strip_edges()
+	_send_target_selector.open_at(local_pos, rows, "从 %s 创建发送" % (track_name if not track_name.is_empty() else tid))
+
+
+func _on_send_target_selected(selection: Dictionary) -> void:
+	if _send_target_selector != null and is_instance_valid(_send_target_selector):
+		_send_target_selector.close_popup()
+	var tid := str(_bound_kernel_track_id).strip_edges()
+	if tid.is_empty():
+		tid = _resolve_current_kernel_track_id()
+	if tid.is_empty():
+		_rack_ipc_alert("未选定轨道，无法创建发送")
+		return
+	var kind := str(selection.get("kind", ""))
+	var payload: Dictionary = {}
+	var request_id := "track_send_connect"
+	var pending_key := ""
+	var pending_label := ""
+	match kind:
+		"fx", "track":
+			var fx_id := str(selection.get("track_id", "")).strip_edges()
+			payload = _RACK_IPC_PAYLOAD_RULES_SCRIPT.track_send_connect_payload(tid, fx_id)
+			pending_key = _RACK_SEND_ROUTE_RULES_SCRIPT.send_edge_key(tid, fx_id)
+			pending_label = "SEND ▸ %s …连接中" % str(selection.get("track_name", ""))
+		"new_fx":
+			var fx_name := str(selection.get("track_name", "")).strip_edges()
+			payload = _RACK_IPC_PAYLOAD_RULES_SCRIPT.track_send_connect_auto_create_payload(tid, fx_name)
+			pending_key = _RACK_SEND_ROUTE_RULES_SCRIPT.send_edge_key(tid, "new:%s" % fx_name)
+			pending_label = "SEND ▸ %s …建轨连接中" % fx_name
+		"sidechain":
+			payload = _RACK_IPC_PAYLOAD_RULES_SCRIPT.track_send_connect_sidechain_payload(tid, str(selection.get("plugin_item_id", "")))
+			request_id = "track_send_connect_sc"
+			pending_key = _RACK_SEND_ROUTE_RULES_SCRIPT.sidechain_edge_key(tid, str(selection.get("plugin_item_id", "")))
+			pending_label = "SEND ▸ 侧链 %s …连接中" % str(selection.get("plugin_name", ""))
+		_:
+			return
+	var rack_client: Variant = _vit_rack_client()
+	var queued: String = rack_client.track_send_connect(payload, request_id)
+	if not _rack_command_queued(queued, "track.send.connect"):
+		_rack_ipc_alert("发送创建命令排队失败（IPC 不可用）")
+		return
+	_pending_send_edges[pending_key] = {
+		"label": pending_label,
+		"expire_msec": Time.get_ticks_msec() + _PENDING_EDGE_TTL_MSEC,
+	}
+	_rack_keep_process_alive(_PENDING_EDGE_TTL_MSEC + 200)
+	queue_redraw()
+	_rack_diag_log("send connect queued kind=%s payload=%s" % [kind, JSON.stringify(payload)])
+
+
+func _rack_ipc_alert(message: String) -> void:
+	var now := Time.get_ticks_msec()
+	if now - _rack_ipc_alert_last_msec < _RACK_IPC_ALERT_COOLDOWN_MSEC:
+		return
+	_rack_ipc_alert_last_msec = now
+	_rack_diag_log(message)
+
+
+# ==========================================
+# K3：宏控制层——层 chip + 控制卡 + 参数口 + 绑定手势 + 紫虚线
+# ==========================================
+func _build_control_layer_chips() -> void:
+	if not _control_layer_chips.is_empty():
+		return
+	var hud := HBoxContainer.new()
+	hud.name = "RackLayerChips"
+	hud.mouse_filter = Control.MOUSE_FILTER_STOP
+	hud.anchor_left = 0.0
+	hud.anchor_right = 0.0
+	hud.anchor_top = 0.0
+	hud.anchor_bottom = 0.0
+	hud.offset_left = 12.0
+	hud.offset_right = 190.0
+	hud.offset_top = 8.0
+	hud.offset_bottom = 34.0
+	hud.add_theme_constant_override("separation", 4)
+	add_child(hud)
+	var signal_chip := Button.new()
+	signal_chip.name = "LayerChipSignal"
+	signal_chip.toggle_mode = true
+	signal_chip.button_pressed = true
+	signal_chip.focus_mode = Control.FOCUS_NONE
+	signal_chip.pressed.connect(_on_layer_chip_pressed.bind("signal"))
+	hud.add_child(signal_chip)
+	var control_chip := Button.new()
+	control_chip.name = "LayerChipControl"
+	control_chip.toggle_mode = true
+	control_chip.button_pressed = true
+	control_chip.focus_mode = Control.FOCUS_NONE
+	control_chip.pressed.connect(_on_layer_chip_pressed.bind("control"))
+	hud.add_child(control_chip)
+	_control_layer_chips = {"hud": hud, "signal": signal_chip, "control": control_chip}
+	_update_layer_chip_states()
+
+
+func _on_layer_chip_pressed(which: String) -> void:
+	var signal_visible: bool = _RACK_CONTROL_LAYER_RULES_SCRIPT.signal_layer_visible(_control_layer_view)
+	var control_visible: bool = _RACK_CONTROL_LAYER_RULES_SCRIPT.control_layer_visible(_control_layer_view)
+	if which == "signal":
+		signal_visible = not signal_visible
+	else:
+		control_visible = not control_visible
+	# 双关保护：两层同时隐藏不允许（点灭最后一层无效）。
+	if not signal_visible and not control_visible:
+		_update_layer_chip_states()
+		return
+	if signal_visible and control_visible:
+		_control_layer_view = _RACK_CONTROL_LAYER_RULES_SCRIPT.LayerView.BOTH
+	elif control_visible:
+		_control_layer_view = _RACK_CONTROL_LAYER_RULES_SCRIPT.LayerView.CONTROL_ONLY
+	else:
+		_control_layer_view = _RACK_CONTROL_LAYER_RULES_SCRIPT.LayerView.SIGNAL_ONLY
+	_update_layer_chip_states()
+	_apply_layer_visibility()
+
+
+func _update_layer_chip_states() -> void:
+	if _control_layer_chips.is_empty():
+		return
+	var signal_chip := _control_layer_chips.get("signal", null) as Button
+	var control_chip := _control_layer_chips.get("control", null) as Button
+	if signal_chip != null:
+		signal_chip.button_pressed = _RACK_CONTROL_LAYER_RULES_SCRIPT.signal_layer_visible(_control_layer_view)
+		signal_chip.text = "● 信号"
+	if control_chip != null:
+		control_chip.button_pressed = _RACK_CONTROL_LAYER_RULES_SCRIPT.control_layer_visible(_control_layer_view)
+		control_chip.text = "◆ 控制"
+
+
+func _apply_layer_visibility() -> void:
+	## 只改渲染不改数据（129 定稿规则 3）——切层不触发重建，杜绝与 render 互递归。
+	var control_visible: bool = _RACK_CONTROL_LAYER_RULES_SCRIPT.control_layer_visible(_control_layer_view)
+	var dim_signal: bool = _RACK_CONTROL_LAYER_RULES_SCRIPT.signal_layer_dimmed(_control_layer_view)
+	for c in get_children():
+		if not (c is GraphNode):
+			continue
+		var gn := c as GraphNode
+		var is_control := bool(gn.get_meta("vit_control_node", false))
+		if is_control:
+			gn.visible = control_visible
+		elif dim_signal:
+			gn.modulate.a = _RACK_CONTROL_LAYER_RULES_SCRIPT.SIGNAL_LAYER_DIM_MODULATE_ALPHA
+		else:
+			gn.modulate.a = 1.0
+	queue_redraw()
+
+
+func _refresh_control_graph_from_repository() -> void:
+	var repo: Node = get_tree().get_first_node_in_group("project_repository")
+	if repo == null or not repo.has_method("get_control_graph"):
+		return
+	var graph: Dictionary = repo.call("get_control_graph") as Dictionary
+	if graph.is_empty():
+		return
+	_control_graph_snapshot = graph
+	_refresh_control_bindings_cache()
+
+
+func _refresh_control_bindings_cache() -> void:
+	_control_bindings = []
+	var bindings_variant: Variant = _control_graph_snapshot.get("bindings", [])
+	if typeof(bindings_variant) != TYPE_ARRAY:
+		return
+	for binding_variant in bindings_variant as Array:
+		var normalized: Dictionary = _RACK_CONTROL_LAYER_RULES_SCRIPT.normalize_binding(binding_variant)
+		if not normalized.is_empty():
+			_control_bindings.append(normalized)
+
+
+func _apply_control_graph(graph: Dictionary) -> void:
+	if graph.is_empty():
+		return
+	_control_graph_snapshot = graph.duplicate(true)
+	_refresh_control_bindings_cache()
+	var repo: Node = get_tree().get_first_node_in_group("project_repository")
+	if repo != null and repo.has_method("apply_control_graph"):
+		if repo.call("apply_control_graph", graph) and _project_event_hub != null:
+			_project_event_hub.control_graph_changed.emit(graph)
+	_rack_render_control_layer_nodes()
+	queue_redraw()
+
+
+func _rack_render_control_layer_nodes() -> void:
+	_remove_control_layer_nodes()
+	_param_port_controls = _filter_param_port_registry()
+	if not _RACK_CONTROL_LAYER_RULES_SCRIPT.control_layer_visible(_control_layer_view):
+		return
+	var nodes_variant: Variant = _control_graph_snapshot.get("nodes", [])
+	if typeof(nodes_variant) != TYPE_ARRAY:
+		return
+	for node_variant in nodes_variant as Array:
+		if typeof(node_variant) != TYPE_DICTIONARY:
+			continue
+		_add_control_layer_node(node_variant as Dictionary)
+	_apply_layer_visibility()
+
+
+func _render_control_layer_nodes() -> void:
+	_rack_render_control_layer_nodes()
+
+
+func _remove_control_layer_nodes() -> void:
+	var to_drop: Array[Node] = []
+	for c in get_children():
+		if c is GraphNode and bool((c as GraphNode).get_meta("vit_control_node", false)):
+			to_drop.append(c)
+	for node in to_drop:
+		if is_instance_valid(node):
+			node.free()
+
+
+func _filter_param_port_registry() -> Dictionary:
+	# 控制卡重建时保留仍挂着的参数口（插件卡/送出卡上的）；被释放控件清出注册表。
+	var out: Dictionary = {}
+	for key in _param_port_controls.keys():
+		var entry: Dictionary = _param_port_controls.get(key, {}) as Dictionary
+		var control: Variant = entry.get("control", null)
+		if control != null and is_instance_valid(control):
+			out[key] = entry
+	return out
+
+
+func _add_control_layer_node(snapshot: Dictionary) -> void:
+	var node_id := str(snapshot.get("node_id", "")).strip_edges()
+	if node_id.is_empty():
+		return
+	var kind: String = _RACK_CONTROL_LAYER_RULES_SCRIPT.normalize_control_kind(str(snapshot.get("kind", "slider")))
+	var node := GraphNode.new()
+	node.name = "ControlNode_%s" % _safe_graph_node_suffix(node_id)
+	node.title = str(snapshot.get("name", node_id)).strip_edges()
+	node.position_offset = Vector2(float(snapshot.get("x", 0.0)), float(snapshot.get("y", 0.0)))
+	node.set_meta("vit_control_node", true)
+	node.set_meta("control_node_id", node_id)
+	node.set_meta("control_kind", kind)
+	node.set_meta("vit_node_kind", KIND_CONTROL_NODE)
+	node.set_meta("vit_display_name", node.title)
+	node.resizable = false
+	node.draggable = true
+	add_child(node)
+	node.add_child(_create_control_layer_node_content(node_id, kind, snapshot))
+	_rack_apply_graph_node_card_theme(node, ZONE_Z2)
+	_apply_control_card_purple_accent(node)
+	node.dragged.connect(_on_control_node_dragged.bind(node))
+	node.gui_input.connect(_on_node_gui_input.bind(node))
+	call_deferred("_rack_shrink_wrap_graph_node_by_name", str(node.name))
+
+
+func _apply_control_card_purple_accent(node: GraphNode) -> void:
+	# 控制卡紫竖条（129 定稿：控制语义色 #a78bfa）。
+	var accent := ColorRect.new()
+	accent.name = "ControlAccentBar"
+	accent.color = _RACK_CONTROL_LAYER_RULES_SCRIPT.CONTROL_COLOR
+	accent.custom_minimum_size = Vector2(4, 0)
+	accent.size_flags_vertical = Control.SIZE_EXPAND_FILL
+	accent.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	node.add_child(accent)
+
+
+func _create_control_layer_node_content(node_id: String, kind: String, snapshot: Dictionary) -> Control:
+	var margin := MarginContainer.new()
+	margin.add_theme_constant_override("margin_left", RACK_CARD_CONTENT_MARGIN)
+	margin.add_theme_constant_override("margin_right", RACK_CARD_CONTENT_MARGIN)
+	margin.add_theme_constant_override("margin_top", 8)
+	margin.add_theme_constant_override("margin_bottom", 8)
+	var root := VBoxContainer.new()
+	root.add_theme_constant_override("separation", 5)
+
+	var min_value := float(snapshot.get("min", 0.0))
+	var max_value := float(snapshot.get("max", 1.0))
+	var current_values: Dictionary = _dict_from_snapshot(snapshot.get("current_values", {}))
+	var binding_count := _control_binding_count_for_node(node_id)
+
+	var status := Label.new()
+	status.name = "ControlBindingStatus"
+	status.text = "Mappings %d" % binding_count
+	status.add_theme_font_size_override("font_size", 11)
+	status.add_theme_color_override("font_color", Color(0.035, 0.042, 0.055, 0.76))
+	root.add_child(status)
+
+	if kind == _RACK_CONTROL_LAYER_RULES_SCRIPT.KIND_MACROPANEL:
+		# 混排宏卡：macro_1..N 槽位各一旋钮 + 各自输出锚（内核 VitMacroNode 模型）。
+		var macro_count := int(snapshot.get("macro_count", 1))
+		for i in range(clampi(macro_count, 1, 16)):
+			var output := "macro_%d" % (i + 1)
+			root.add_child(_make_control_slot_row(node_id, output, min_value, max_value, float(current_values.get(output, min_value))))
+	else:
+		var outputs: Array[String] = _RACK_CONTROL_LAYER_RULES_SCRIPT.outputs_for_kind(kind)
+		for output in outputs:
+			var spec := {
+				"min": min_value,
+				"max": max_value,
+				"value": float(current_values.get("value", current_values.get(output, min_value))),
+				"value_y": float(current_values.get("out_y", max_value)),
+				"label": str(snapshot.get("name", node_id)),
+			}
+			if _RACK_CONTROL_WIDGET_FACTORY_SCRIPT.is_shell_kind(kind):
+				var shell_bundle: Dictionary = _RACK_CONTROL_WIDGET_FACTORY_SCRIPT.create_control_widget(kind, spec, {})
+				root.add_child(shell_bundle.get("root", null) as Control)
+				root.add_child(_make_output_anchor_row(node_id, output, output))
+				continue
+			var callbacks := {
+				"value_changed": Callable(self, "_on_control_widget_live").bind(node_id, kind, output),
+				"committed": Callable(self, "_on_control_widget_committed").bind(node_id, kind, output),
+			}
+			var bundle: Dictionary = _RACK_CONTROL_WIDGET_FACTORY_SCRIPT.create_control_widget(kind, spec, callbacks)
+			root.add_child(bundle.get("root", null) as Control)
+			root.add_child(_make_output_anchor_row(node_id, output, output))
+
+	margin.add_child(root)
+	return margin
+
+
+func _make_control_slot_row(node_id: String, output: String, min_value: float, max_value: float, value: float) -> Control:
+	var row := HBoxContainer.new()
+	row.add_theme_constant_override("separation", 6)
+	var slot_label := Label.new()
+	slot_label.text = output
+	slot_label.add_theme_font_size_override("font_size", 10)
+	slot_label.add_theme_color_override("font_color", Color(0.035, 0.042, 0.055, 0.62))
+	row.add_child(slot_label)
+	var spec := {"min": min_value, "max": max_value, "value": value, "label": output}
+	var callbacks := {
+		"value_changed": Callable(self, "_on_control_widget_live").bind(node_id, _RACK_CONTROL_LAYER_RULES_SCRIPT.KIND_MACROPANEL, output),
+		"committed": Callable(self, "_on_control_widget_committed").bind(node_id, _RACK_CONTROL_LAYER_RULES_SCRIPT.KIND_MACROPANEL, output),
+	}
+	var bundle: Dictionary = _RACK_CONTROL_WIDGET_FACTORY_SCRIPT.create_control_widget("knob", spec, callbacks)
+	row.add_child(bundle.get("root", null) as Control)
+	row.add_child(_make_output_anchor(node_id, output))
+	return row
+
+
+func _make_output_anchor_row(node_id: String, output: String, label_text: String) -> Control:
+	var row := HBoxContainer.new()
+	row.add_theme_constant_override("separation", 6)
+	row.alignment = BoxContainer.ALIGNMENT_END
+	var label := Label.new()
+	label.text = label_text
+	label.add_theme_font_size_override("font_size", 10)
+	label.add_theme_color_override("font_color", Color(0.035, 0.042, 0.055, 0.62))
+	row.add_child(label)
+	row.add_child(_make_output_anchor(node_id, output))
+	return row
+
+
+## 输出锚=绑定拖拽起点（紫色小圆按钮；按下进入 _binding_drag 手势通道，
+## 不触发 GraphEdit connection_request——两层模型规则 2）。
+func _make_output_anchor(node_id: String, output: String) -> Control:
+	var anchor := Button.new()
+	anchor.name = "ControlAnchor_%s" % _safe_graph_node_suffix(output)
+	anchor.text = "●"
+	anchor.tooltip_text = "拖出到参数口建立绑定（%s）" % output
+	anchor.custom_minimum_size = Vector2(26, 22)
+	anchor.focus_mode = Control.FOCUS_NONE
+	anchor.add_theme_color_override("font_color", _RACK_CONTROL_LAYER_RULES_SCRIPT.CONTROL_COLOR)
+	anchor.add_theme_color_override("font_hover_color", _RACK_CONTROL_LAYER_RULES_SCRIPT.CONTROL_COLOR.lightened(0.2))
+	anchor.set_meta("control_anchor_node_id", node_id)
+	anchor.set_meta("control_anchor_output", output)
+	anchor.gui_input.connect(_on_control_anchor_gui_input.bind(anchor))
+	return anchor
+
+
+func _on_control_anchor_gui_input(event: InputEvent, anchor: Button) -> void:
+	if not (event is InputEventMouseButton):
+		return
+	var mouse := event as InputEventMouseButton
+	if mouse.button_index != MOUSE_BUTTON_LEFT:
+		return
+	if mouse.pressed:
+		_binding_drag = {
+			"source_node_id": str(anchor.get_meta("control_anchor_node_id", "")),
+			"source_output": str(anchor.get_meta("control_anchor_output", "")),
+			"anchor": anchor,
+			"from_pos": Vector2.ZERO,
+		}
+		_rack_keep_process_alive(8000)
+		queue_redraw()
+		get_viewport().set_input_as_handled()
+
+
+func _dict_from_snapshot(value: Variant) -> Dictionary:
+	if typeof(value) == TYPE_DICTIONARY:
+		return (value as Dictionary).duplicate(true)
+	return {}
+
+
+func _control_binding_count_for_node(node_id: String) -> int:
+	var count := 0
+	for binding in _control_bindings:
+		if str(binding.get("source_node_id", "")) == node_id:
+			count += 1
+	return count
+
+
+func _on_control_widget_live(values: Dictionary, _node_id: String, _kind: String, _output: String) -> void:
+	pass  # 中间帧本地回显（控件自绘已更新）；提交帧才落内核命令。
+
+
+func _on_control_widget_committed(values: Dictionary, node_id: String, kind: String, output: String) -> void:
+	var rack_client: Variant = _vit_rack_client()
+	if kind == _RACK_CONTROL_LAYER_RULES_SCRIPT.KIND_MACROPANEL:
+		var payload: Dictionary = _RACK_IPC_PAYLOAD_RULES_SCRIPT.control_set_macro_values_payload(node_id, {output: float(values.get("value", values.get(output, 0.0)))})
+		var queued: String = rack_client.control_set_macro_values(payload)
+		_rack_command_queued(queued, "control_set_macro_values")
+		return
+	if _RACK_CONTROL_LAYER_RULES_SCRIPT.dual_output_kind(kind):
+		# 双输出控件：一次提交两输出（out_x/out_y 同帧成对）。
+		var payload: Dictionary = _RACK_IPC_PAYLOAD_RULES_SCRIPT.control_set_macro_values_payload(node_id, {
+			"out_x": float(values.get("out_x", values.get("value", 0.0))),
+			"out_y": float(values.get("out_y", values.get("value", 0.0))),
+		})
+		var queued: String = rack_client.control_set_macro_values(payload)
+		_rack_command_queued(queued, "control_set_macro_values")
+		return
+	var payload: Dictionary = _RACK_IPC_PAYLOAD_RULES_SCRIPT.control_set_node_value_payload(node_id, output, float(values.get("value", 0.0)))
+	var queued: String = rack_client.control_set_node_value(payload)
+	_rack_command_queued(queued, "control_set_node_value")
+
+
+func _on_control_node_dragged(_from: Vector2, _to: Vector2, node: GraphNode) -> void:
+	# 拖动中只刷新连线跟随；位置提交在鼠标释放（gui_input RELEASED）。
+	queue_redraw()
+
+
+func _commit_control_node_position(node: GraphNode) -> void:
+	var node_id := str(node.get_meta("control_node_id", "")).strip_edges()
+	if node_id.is_empty():
+		return
+	var payload: Dictionary = _RACK_IPC_PAYLOAD_RULES_SCRIPT.control_update_node_payload(node_id, {
+		"x": node.position_offset.x,
+		"y": node.position_offset.y,
+	})
+	var rack_client: Variant = _vit_rack_client()
+	var queued: String = rack_client.control_update_node(payload)
+	_rack_command_queued(queued, "control_update_node")
+
+
+func _create_macro_at(canvas_pos: Vector2) -> void:
+	var graph_pos := (canvas_pos + scroll_offset) / maxf(zoom, 0.001)
+	var payload: Dictionary = _RACK_IPC_PAYLOAD_RULES_SCRIPT.control_add_macro_payload("Macro", graph_pos, 1)
+	var rack_client: Variant = _vit_rack_client()
+	var queued: String = rack_client.control_add_macro(payload)
+	if _rack_command_queued(queued, "control_add_macro"):
+		_rack_diag_log("control_add_macro queued at %s" % str(graph_pos))
+
+
+# ==========================================
+# K3：参数口（效果器卡 ⌗ params 行 + 注册表；SendOut 硬接线口）
+# ==========================================
+func _make_param_port_row(plugin_id: String, param_id: String, param_name: String, always_visible: bool = false) -> Control:
+	var row := HBoxContainer.new()
+	row.name = "ParamPortRow_%s" % _safe_graph_node_suffix(param_id)
+	row.add_theme_constant_override("separation", 6)
+	var dot := ColorRect.new()
+	dot.color = _RACK_CONTROL_LAYER_RULES_SCRIPT.CONTROL_COLOR
+	dot.custom_minimum_size = Vector2(8, 8)
+	dot.size_flags_vertical = Control.SIZE_SHRINK_CENTER
+	dot.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	row.add_child(dot)
+	var label := Label.new()
+	label.text = param_name
+	label.add_theme_font_size_override("font_size", 10)
+	label.add_theme_color_override("font_color", Color(0.035, 0.042, 0.055, 0.7))
+	label.clip_text = true
+	label.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
+	row.add_child(label)
+	if not always_visible:
+		var add_button := Button.new()
+		add_button.text = "＋控件"
+		add_button.tooltip_text = "按参数特征建议控件类型并创建控制卡（可下拉改）"
+		add_button.custom_minimum_size = Vector2(52, 20)
+		add_button.focus_mode = Control.FOCUS_NONE
+		add_button.pressed.connect(_on_param_port_create_control.bind(plugin_id, param_id, param_name))
+		row.add_child(add_button)
+	_register_param_port(row, plugin_id, param_id)
+	return row
+
+
+func _register_param_port(row: Control, plugin_id: String, param_id: String) -> void:
+	_param_port_controls["%s|%s" % [plugin_id, param_id]] = {
+		"control": row,
+		"plugin_id": plugin_id,
+		"param_id": param_id,
+	}
+
+
+func _on_param_port_create_control(plugin_id: String, param_id: String, param_name: String) -> void:
+	var suggestion: Dictionary = _suggest_control_for_param(plugin_id, param_id)
+	_open_binding_menu({
+		"mode": "create_control",
+		"plugin_id": plugin_id,
+		"param_id": param_id,
+		"param_name": param_name,
+		"suggested_kind": str(suggestion.get("kind", "knob")),
+		"suggested_reason": str(suggestion.get("reason", "")),
+		"range_min": float(suggestion.get("min", 0.0)),
+		"range_max": float(suggestion.get("max", 1.0)),
+		"curve": "linear",
+	})
+
+
+func _suggest_control_for_param(plugin_id: String, param_id: String) -> Dictionary:
+	var rows: Array = _param_port_rows_by_plugin.get(plugin_id, []) as Array
+	var param_row := {}
+	for row_variant in rows:
+		if typeof(row_variant) != TYPE_DICTIONARY:
+			continue
+		var row: Dictionary = row_variant
+		if str(row.get("param_id", row.get("id", ""))) == param_id:
+			param_row = row
+			break
+	var suggestion: Dictionary = _RACK_CONTROL_LAYER_RULES_SCRIPT.suggest_control_kind(param_row)
+	if param_row.is_empty():
+		suggestion["min"] = 0.0
+		suggestion["max"] = 1.0
+	else:
+		suggestion["min"] = float(param_row.get("min", 0.0))
+		suggestion["max"] = float(param_row.get("max", 1.0))
+	return suggestion
+
+
+## 插件卡 ⌗ params 展开行（收起只显示计数；展开=参数描述符 binding_target 投影行）。
+func _make_param_ports_section(plugin_id: String) -> Control:
+	var toggle := Button.new()
+	toggle.name = "ParamPortsToggle"
+	toggle.text = "⌗ params"
+	toggle.tooltip_text = "展开参数口（绑定落点）"
+	toggle.focus_mode = Control.FOCUS_NONE
+	toggle.toggle_mode = true
+	toggle.pressed.connect(_on_param_ports_toggle_pressed.bind(plugin_id, toggle))
+	return toggle
+
+
+func _on_param_ports_toggle_pressed(plugin_id: String, toggle: Button) -> void:
+	var node := toggle.get_parent()
+	while node != null and not (node is GraphNode):
+		node = node.get_parent()
+	var gn := node as GraphNode
+	if gn == null:
+		return
+	var holder := gn.find_child("ParamPortsHolder", true, false) as Control
+	if toggle.button_pressed:
+		if holder == null:
+			holder = VBoxContainer.new()
+			holder.name = "ParamPortsHolder"
+			holder.add_theme_constant_override("separation", 2)
+			gn.add_child(holder)
+		_render_param_ports_for_plugin(plugin_id, holder)
+		_request_param_port_rows(plugin_id)
+	else:
+		if holder != null:
+			holder.queue_free()
+	call_deferred("_rack_shrink_wrap_graph_node_by_name", str(gn.name))
+
+
+func _render_param_ports_for_plugin(plugin_id: String, holder: Control) -> void:
+	for child in holder.get_children():
+		child.queue_free()
+	var rows: Array = _param_port_rows_by_plugin.get(plugin_id, []) as Array
+	if rows.is_empty():
+		var hint := Label.new()
+		hint.text = "参数获取中…（点击 Get Params 可强制刷新）"
+		hint.add_theme_font_size_override("font_size", 10)
+		holder.add_child(hint)
+		return
+	var shown := 0
+	for row_variant in rows:
+		if typeof(row_variant) != TYPE_DICTIONARY:
+			continue
+		if shown >= 12:
+			break
+		var row: Dictionary = row_variant
+		var target: Dictionary = _dict_from_snapshot(row.get("binding_target", {}))
+		var pid := str(target.get("param_id", row.get("param_id", row.get("id", "")))).strip_edges()
+		var pname := str(target.get("param_name", row.get("param_name", row.get("name", pid)))).strip_edges()
+		if pid.is_empty():
+			continue
+		holder.add_child(_make_param_port_row(plugin_id, pid, pname if not pname.is_empty() else pid))
+		shown += 1
+
+
+func _request_param_port_rows(plugin_id: String) -> void:
+	if _param_port_rows_by_plugin.has(plugin_id):
+		return
+	if _param_port_pending_by_plugin.has(plugin_id):
+		return
+	var tid := str(_bound_kernel_track_id).strip_edges()
+	if tid.is_empty():
+		tid = _resolve_current_kernel_track_id()
+	if tid.is_empty():
+		return
+	_param_port_pending_by_plugin[plugin_id] = true
+	var payload: Dictionary = _RACK_IPC_PAYLOAD_RULES_SCRIPT.get_plugin_parameters_payload(tid, plugin_id)
+	var rack_client: Variant = _vit_rack_client()
+	var queued: String = rack_client.get_plugin_parameters(payload, "ctrl_params_%s" % plugin_id)
+	if queued.is_empty():
+		_param_port_pending_by_plugin.erase(plugin_id)
+		return
+	_rack_diag_log("ctrl params queued plugin=%s" % plugin_id)
+
+
+func _on_param_port_rows_reply(request_id: String, reply: Dictionary) -> void:
+	var plugin_id := request_id.trim_prefix("ctrl_params_")
+	_param_port_pending_by_plugin.erase(plugin_id)
+	if str(reply.get("status", "")) != "ok":
+		_rack_diag_log("ctrl params failed plugin=%s message=%s" % [plugin_id, str(reply.get("message", ""))])
+		return
+	var rows: Array = []
+	var parameters_variant: Variant = reply.get("parameters", reply.get("params", []))
+	if typeof(parameters_variant) == TYPE_ARRAY:
+		for row_variant in parameters_variant as Array:
+			if typeof(row_variant) == TYPE_DICTIONARY:
+				rows.append((row_variant as Dictionary).duplicate(true))
+	_param_port_rows_by_plugin[plugin_id] = rows
+	_refresh_param_port_holders(plugin_id)
+
+
+func _refresh_param_port_holders(plugin_id: String) -> void:
+	for c in get_children():
+		if not (c is GraphNode):
+			continue
+		var gn := c as GraphNode
+		if str(gn.get_meta("plugin_id", "")) != plugin_id:
+			continue
+		var holder := gn.find_child("ParamPortsHolder", true, false) as Control
+		if holder != null and is_instance_valid(holder):
+			_render_param_ports_for_plugin(plugin_id, holder)
+			call_deferred("_rack_shrink_wrap_graph_node_by_name", str(gn.name))
+
