+func _update_send_route_node_labels() -> void:
+	for c in get_children():
+		if not (c is GraphNode):
+			continue
+		var gn := c as GraphNode
+		if not bool(gn.get_meta("vit_send_route_node", false)):
+			continue
+		var kernel_item := str(gn.get_meta("kernel_plugin_item_id", "")).strip_edges()
+		var display: Dictionary = _RACK_SEND_ROUTE_RULES_SCRIPT.send_out_display(kernel_item, _send_topology, str(_bound_kernel_track_id))
+		gn.set_meta("vit_send_fx_track_id", str(display.get("fx_track_id", "")))
+		_apply_send_route_node_title(gn, bool(gn.get_meta("vit_send_is_out", false)), display)
+
