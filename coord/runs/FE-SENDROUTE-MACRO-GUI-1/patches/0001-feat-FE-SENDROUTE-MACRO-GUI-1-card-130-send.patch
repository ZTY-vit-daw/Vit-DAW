+extends PanelContainer
+# ==============================================================================
+# FE-SENDROUTE-MACRO-GUI-1 (K3)：send 创建目标选择器（MIX-SENDRETURN-DESIGN-1
+# §9.0-3 创建一步化）：已有轨分组（FX 轨/普通轨）+ 每轨插件侧链口（可展开叶）+
+# 检索框 + 底部「＋新建 FX 轨」（现场命名，默认 Reverb Bus 类）。
+# 形态对齐 rack_plugin_search_popup（FE-GUI-RACK-LIST-1）的检索/键盘/钳制模式；
+# 数据源=Vit_Graph_Rack 传入的 RackSendRouteRules.target_selector_rows 行；
+# 本组件零 IPC：选中仅 emit send_target_selected(选择行)，由机架走
+# track.send.connect（选定即连+乐观 pending，rack_pending_edge_rules 回滚模式）。
+# ==============================================================================
+
+signal send_target_selected(selection: Dictionary)
+
+const POPUP_MIN_WIDTH := 340.0
+const LIST_MIN_HEIGHT := 230.0
+const POPUP_EDGE_MARGIN := 6.0
+const FILTER_FIELDS: Array[String] = ["track_name", "plugin_name"]
+const GROUP_LABELS := {
+	"fx": "FX 轨（总线）",
+	"track": "普通轨",
+	"sidechain": "",
+	"new_fx": "",
+}
+
+var _search_edit: LineEdit
+var _tree: Tree
+var _footer_label: Label
+var _name_edit: LineEdit
+var _name_row: HBoxContainer
+var _rows: Array = []
+var _visible_rows: Array = []
+var _leaf_items: Array = []
+var _empty_hint := ""
+
+
+func _ready() -> void:
+	visible = false
+	mouse_filter = Control.MOUSE_FILTER_STOP
+	z_index = 4096
+	custom_minimum_size = Vector2(POPUP_MIN_WIDTH, 0)
+
+	var margin := MarginContainer.new()
+	margin.add_theme_constant_override("margin_left", 6)
+	margin.add_theme_constant_override("margin_right", 6)
+	margin.add_theme_constant_override("margin_top", 6)
+	margin.add_theme_constant_override("margin_bottom", 6)
+	add_child(margin)
+
+	var box := VBoxContainer.new()
+	box.add_theme_constant_override("separation", 4)
+	margin.add_child(box)
+
+	_search_edit = LineEdit.new()
+	_search_edit.placeholder_text = "检索目标（轨名/侧链插件名）…"
+	_search_edit.clear_button_enabled = true
+	_search_edit.text_changed.connect(_on_search_text_changed)
+	_search_edit.text_submitted.connect(_on_search_text_submitted)
+	_search_edit.gui_input.connect(_on_search_gui_input)
+	box.add_child(_search_edit)
+
+	_tree = Tree.new()
+	_tree.custom_minimum_size = Vector2(0, LIST_MIN_HEIGHT)
+	_tree.size_flags_vertical = Control.SIZE_EXPAND_FILL
+	_tree.hide_root = true
+	_tree.item_activated.connect(_on_tree_item_activated)
+	box.add_child(_tree)
+
+	_name_row = HBoxContainer.new()
+	_name_row.add_theme_constant_override("separation", 6)
+	_name_row.visible = false
+	var name_label := Label.new()
+	name_label.text = "新 FX 轨名："
+	name_label.add_theme_font_size_override("font_size", 12)
+	_name_row.add_child(name_label)
+	_name_edit = LineEdit.new()
+	_name_edit.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	_name_edit.placeholder_text = "Reverb Bus"
+	_name_edit.text_submitted.connect(_on_new_fx_name_submitted)
+	_name_row.add_child(_name_edit)
+	box.add_child(_name_row)
+
+	_footer_label = Label.new()
+	_footer_label.add_theme_font_size_override("font_size", 12)
+	box.add_child(_footer_label)
+
+
+## 打开：本地坐标锚定（钳制父矩形），重灌行并清检索；选择「＋新建 FX 轨」时展开命名行。
+func open_at(local_pos: Vector2, rows: Array, footer_text: String = "", empty_hint: String = "") -> void:
+	_rows = rows
+	_empty_hint = empty_hint
+	_search_edit.text = ""
+	_name_row.visible = false
+	_name_edit.text = ""
+	_rebuild_tree()
+	set_footer_text(footer_text)
+	visible = true
+	move_to_front()
+	position = _clamp_popup_position(local_pos)
+	_search_edit.call_deferred("grab_focus")
+
+
+func close_popup() -> void:
+	visible = false
+
+
+func set_footer_text(text: String) -> void:
+	if _footer_label != null:
+		_footer_label.text = text
+
+
+func visible_count() -> int:
+	return _visible_rows.size()
+
+
+func apply_query(query: String) -> void:
+	_search_edit.text = query
+	_rebuild_tree()
+
+
+func new_fx_name_visible() -> bool:
+	return _name_row != null and _name_row.visible
+
+
+func new_fx_name() -> String:
+	return _name_edit.text.strip_edges() if _name_edit != null else ""
+
+
+# ==========================================
+# 过滤（纯函数，探针直断面）
+# ==========================================
+
+static func filter_rows(rows: Array, query: String) -> Array:
+	var pool: Array = []
+	for raw in rows:
+		if typeof(raw) == TYPE_DICTIONARY:
+			pool.append(raw)
+	var q := query.strip_edges().to_lower()
+	if q.is_empty():
+		return pool
+	var tokens := q.split(" ", false)
+	var out: Array = []
+	for row_variant in pool:
+		var row := row_variant as Dictionary
+		var matched := true
+		for token in tokens:
+			var token_hit := false
+			for field in FILTER_FIELDS:
+				if str(row.get(field, "")).to_lower().contains(token):
+					token_hit = true
+					break
+			if not token_hit:
+				matched = false
+				break
+		if matched:
+			out.append(row)
+	return out
+
+
+static func row_label(row: Dictionary) -> String:
+	var kind := str(row.get("kind", ""))
+	match kind:
+		"fx":
+			return "%s（%d 源）" % [str(row.get("track_name", "")), int(row.get("send_count", 0))]
+		"track":
+			return str(row.get("track_name", ""))
+		"sidechain":
+			return "侧链 ▸ %s" % str(row.get("plugin_name", ""))
+		"new_fx":
+			return "＋ 新建 FX 轨"
+	return str(row.get("track_name", ""))
+
+
+# ==========================================
+# 内部：树构建与交互
+# ==========================================
+
+func _rebuild_tree() -> void:
+	var query := _search_edit.text.strip_edges()
+	_tree.clear()
+	_leaf_items = []
+	_visible_rows = []
+	var root := _tree.create_item()
+	var filtered := filter_rows(_rows, _search_edit.text)
+	if filtered.is_empty():
+		var hint := _empty_hint
+		if not _rows.is_empty():
+			hint = "无匹配目标"
+		elif hint.is_empty():
+			hint = "暂无可发送目标"
+		var info := _tree.create_item(root)
+		info.set_text(0, hint)
+		info.set_selectable(0, false)
+		info.set_metadata(0, {"kind": "info"})
+		return
+	var last_group := ""
+	var group_item: TreeItem = null
+	for row_variant in filtered:
+		var row := row_variant as Dictionary
+		var kind := str(row.get("kind", ""))
+		if kind == "sidechain" or kind == "new_fx":
+			group_item = root
+		else:
+			var group_label := str(GROUP_LABELS.get(kind, ""))
+			if group_label != last_group:
+				last_group = group_label
+				group_item = _tree.create_item(root)
+				group_item.set_text(0, group_label)
+				group_item.set_metadata(0, {"kind": "group"})
+				group_item.collapsed = false
+		var leaf := _tree.create_item(group_item)
+		leaf.set_text(0, row_label(row))
+		leaf.set_tooltip_text(0, _leaf_tooltip(row))
+		leaf.set_metadata(0, row)
+		_leaf_items.append(leaf)
+		_visible_rows.append(row)
+	if not query.is_empty():
+		_select_leaf(0, false)
+
+
+func _leaf_tooltip(row: Dictionary) -> String:
+	var kind := str(row.get("kind", ""))
+	match kind:
+		"fx":
+			return "发送到已有 FX 轨 %s（%s）" % [str(row.get("track_name", "")), str(row.get("track_id", ""))]
+		"track":
+			return "发送到轨 %s（首连将懒初始化为 FX 轨）" % str(row.get("track_name", ""))
+		"sidechain":
+			return "控制发送：本轨 → %s · %s 的侧链口" % [str(row.get("track_name", "")), str(row.get("plugin_name", ""))]
+		"new_fx":
+			return "现场新建 FX 轨（默认 %s，可改名）" % str(row.get("default_name", ""))
+	return ""
+
+
+func toggle_group(item: TreeItem) -> void:
+	if item != null:
+		item.collapsed = not item.collapsed
+
+
+func _selected_leaf_index() -> int:
+	var selected := _tree.get_selected()
+	if selected == null:
+		return -1
+	return _leaf_items.find(selected)
+
+
+func _select_leaf(index: int, expand_ancestors: bool = true) -> void:
+	if index < 0 or index >= _leaf_items.size():
+		return
+	var item: TreeItem = _leaf_items[index]
+	if expand_ancestors:
+		var parent := item.get_parent()
+		while parent != null:
+			parent.collapsed = false
+			parent = parent.get_parent()
+	item.select(0)
+	_tree.scroll_to_item(item)
+
+
+func _move_selection(delta: int) -> void:
+	if _leaf_items.is_empty():
+		return
+	var next := clampi(_selected_leaf_index() + delta, 0, _leaf_items.size() - 1)
+	_select_leaf(next)
+
+
+func _confirm_selection() -> void:
+	var idx := _selected_leaf_index()
+	if idx < 0 or idx >= _visible_rows.size():
+		return
+	var row := _visible_rows[idx] as Dictionary
+	if str(row.get("kind", "")) == "new_fx":
+		_begin_new_fx_naming(row)
+		return
+	send_target_selected.emit(row)
+
+
+## 「＋新建 FX 轨」两步：首击展开命名行（预填默认名），回车/再击确认发射。
+func _begin_new_fx_naming(row: Dictionary) -> void:
+	_name_edit.text = str(row.get("default_name", "Reverb Bus"))
+	_name_row.visible = true
+	_name_edit.call_deferred("grab_focus")
+	_name_edit.call_deferred("select_all")
+
+
+func _on_new_fx_name_submitted(_text: String) -> void:
+	_confirm_new_fx()
+
+
+func _confirm_new_fx() -> void:
+	if not _name_row.visible:
+		return
+	var name := _name_edit.text.strip_edges()
+	if name.is_empty():
+		_name_edit.grab_focus()
+		return
+	send_target_selected.emit({
+		"kind": "new_fx",
+		"track_id": "",
+		"track_name": name,
+		"default_name": name,
+	})
+
+
+func _on_search_text_changed(_text: String) -> void:
+	_rebuild_tree()
+
+
+func _on_search_text_submitted(_text: String) -> void:
+	if _name_row.visible:
+		_confirm_new_fx()
+		return
+	_confirm_selection()
+
+
+func _on_tree_item_activated() -> void:
+	var item := _tree.get_selected()
+	if item == null:
+		return
+	if _leaf_items.find(item) >= 0:
+		_confirm_selection()
+		return
+	toggle_group(item)
+
+
+func _on_search_gui_input(event: InputEvent) -> void:
+	if not (event is InputEventKey) or not event.pressed:
+		return
+	var key := event as InputEventKey
+	if key.keycode == KEY_UP:
+		_move_selection(-1)
+		get_viewport().set_input_as_handled()
+	elif key.keycode == KEY_DOWN:
+		_move_selection(1)
+		get_viewport().set_input_as_handled()
+	elif key.keycode == KEY_ESCAPE:
+		close_popup()
+		get_viewport().set_input_as_handled()
+
+
+func _clamp_popup_position(local_pos: Vector2) -> Vector2:
+	var parent_control := get_parent() as Control
+	if parent_control == null:
+		return local_pos
+	var popup_size := get_combined_minimum_size()
+	var max_x := maxf(POPUP_EDGE_MARGIN, parent_control.size.x - popup_size.x - POPUP_EDGE_MARGIN)
+	var max_y := maxf(POPUP_EDGE_MARGIN, parent_control.size.y - popup_size.y - POPUP_EDGE_MARGIN)
+	return Vector2(
+		clampf(local_pos.x, POPUP_EDGE_MARGIN, max_x),
+		clampf(local_pos.y, POPUP_EDGE_MARGIN, max_y)
+	)
