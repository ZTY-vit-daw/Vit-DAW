+	)
+	if !hasClipTarget {
+		return false
+	}
+	hasFadeOrGain := TextHasAny(text,
+		"fade", "fade in", "fade out", "clip gain", "gain",
+		"\u6de1\u5165", "\u6de1\u51fa", "\u6de1\u5316", "\u589e\u76ca",
+	)
+	if !hasFadeOrGain {
+		return false
+	}
+	if TextHasAny(text, "fade", "gain", "clip gain", "fade/gain") && TextHasAny(text, "clip", "audio clip") {
