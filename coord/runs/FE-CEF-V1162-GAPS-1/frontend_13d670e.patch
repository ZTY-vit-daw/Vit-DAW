 # Narrow, high-signal clip import/bake routing diagnostics.
 # Enable by either:
 # 1) env: VIT_CLIP_PIPELINE_LOG=1
@@ -110,6 +121,12 @@ func log_cef_focus(message: String) -> void:
 	print("[VitCefFocus] ", message)
 
 
+func log_cef_paste(message: String) -> void:
+	if not cef_paste_log_enabled:
+		return
+	print("[VitCefPaste] ", message)
+
+
 func log_track_sync_diag(message: String) -> void:
 	if not track_sync_diag_log_enabled:
 		return
@@ -159,6 +176,16 @@ func _load_from_env() -> void:
 		cef_focus_compensation_enabled = true
 	elif cef_comp_raw in ["0", "false", "off", "no"]:
 		cef_focus_compensation_enabled = false
+	var cef_paste_shim_raw := OS.get_environment("VIT_CEF_PASTE_SHIM").strip_edges().to_lower()
+	if cef_paste_shim_raw in ["1", "true", "on", "yes"]:
