diff --git a/vit_dock/diagnostics/cef_classdb_dump.gd b/vit_dock/diagnostics/cef_classdb_dump.gd
new file mode 100644
index 0000000..8204b15
--- /dev/null
+++ b/vit_dock/diagnostics/cef_classdb_dump.gd
@@ -0,0 +1,53 @@
+extends Node
+
+## FE-CEF-V1162-GAPS-1 ⑤排查场景（验收自证专用，不在产品链路：仅显式以场景参数启动）。
+##
+## 目的：枚举 gdcef 扩展类的 ClassDB API 面（方法/属性/信号），供 v1.15.4 与 v1.16.2
+## 两版 diff——判断 ipc_message 通路是否出现 API/签名变更或新增开关。
+## 不创建浏览器（无需探针服务/vitagent）；仅依赖扩展加载注册。
+## 结果打 [CEFCLASSDB] 行，正常枚举完成 quit(0)，类缺失 quit(1)。
+
+const CLASSES := ["CefTexture", "CefIpcInspector"]
+
+func _ready() -> void:
+	call_deferred("_dump")
+
+
+func _dump() -> void:
+	var all_ok := true
+	for class_name_str in CLASSES:
+		if not ClassDB.class_exists(class_name_str):
+			print("[CEFCLASSDB] class %s MISSING" % class_name_str)
+			all_ok = false
+			continue
+		print("[CEFCLASSDB] class %s BEGIN" % class_name_str)
+		var methods: Array = ClassDB.class_get_method_list(class_name_str, true)
+		var method_names: Array = []
+		for m in methods:
+			method_names.append(str(m.get("name")))
+		method_names.sort()
+		print("[CEFCLASSDB] %s methods(%d)=%s" % [class_name_str, method_names.size(), str(method_names)])
+		var props: Array = ClassDB.class_get_property_list(class_name_str, true)
+		var prop_names: Array = []
+		for p in props:
+			var meta: String = str(p.get("name"))
+			var hint: int = int(p.get("hint", 0))
+			if hint == 128:  # PROPERTY_USAGE_CATEGORY
+				continue
+			if hint & 2:  # PROPERTY_USAGE_GROUP bit
+				continue
+			prop_names.append(meta)
+		prop_names.sort()
+		print("[CEFCLASSDB] %s properties(%d)=%s" % [class_name_str, prop_names.size(), str(prop_names)])
+		var signals: Array = ClassDB.class_get_signal_list(class_name_str, true)
+		var signal_names: Array = []
+		for s in signals:
+			var params: Array = []
+			for a in s.get("args", []):
+				params.append("%s:%d" % [str(a.get("name")), int(a.get("type", 0))])
+			signal_names.append("%s(%s)" % [str(s.get("name")), ", ".join(params)])
+		signal_names.sort()
+		print("[CEFCLASSDB] %s signals(%d)=%s" % [class_name_str, signal_names.size(), str(signal_names)])
+		print("[CEFCLASSDB] class %s END" % class_name_str)
+	print("[CEFCLASSDB] FINAL %s" % ("pass" if all_ok else "fail"))
+	get_tree().quit(0 if all_ok else 1)
