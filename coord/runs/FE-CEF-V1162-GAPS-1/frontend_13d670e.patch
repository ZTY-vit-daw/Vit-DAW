index 0000000..cb63ca6
--- /dev/null
+++ b/vit_dock/diagnostics/cef_input_hook_test.gd
@@ -0,0 +1,219 @@
+extends Node
+
+## FE-CEF-V1162-GAPS-1 ①垫片前置验证（一次性取证，不入验收链）：
+## CefTexture 的 gui_input 信号在 gdcef v1.16.2（Rust override gui_input 虚方法）
+## 下是否仍发出——决定 ⌘V 垫片的捕获点。
+## 同时验证 Window 级 _unhandled_key_input 备选路径。
+## 打 [CEFHOOK] 行后 quit。
+
+const URL_ENV := "VIT_CEF_HOOK_URL"
+const DEFAULT_URL := "http://127.0.0.1:7879/"
+
+var _host: VitCefWebViewHost
+var _window: Window = null
+var _hook_node: Node
+var _gui_input_hits := 0
+var _unhandled_hits := 0
+var _key_hits := 0
+
+func _ready() -> void:
+	call_deferred("_boot")
+
+
+func _boot() -> void:
+	_host = VitCefWebViewHost.new()
+	_host.debug_console_received.connect(_on_console)
+	if not _host.create_window(0, "CEF Input Hook Test", 900, 700):
+		_fail("host.create_window failed")
+		return
+	_window = _host.debug_window()
+	# FE-CEF-V1162-GAPS-1 取证：后台 shell 拉起的 Godot 窗口拿不到 OS 前台焦点
+	# （win_focus=false → 页面焦点机制整体不转）。尝试主动请求前台。
+	if _window != null and is_instance_valid(_window):
+		DisplayServer.window_move_to_foreground(_window.get_window_id())
+		print("[CEFHOOK] move_to_foreground requested")
+	_decoy = Button.new()
+	_decoy.name = "HookTestDecoy"
+	_decoy.text = "decoy"
+	_decoy.position = Vector2(6, 40)
+	_decoy.focus_mode = Control.FOCUS_ALL
+	_window.add_child(_decoy)
+	await _sleep(1.0)
+	var url := OS.get_environment(URL_ENV).strip_edges()
+	if url.is_empty():
+		url = DEFAULT_URL
+	_host.navigate(url)
+	_host.focus()
+	await _sleep(6.0)
+	var browser: Control = _host.debug_browser()
+	if browser == null:
+		_fail("no browser")
+		return
+	if browser.has_signal("gui_input"):
+		browser.gui_input.connect(_on_browser_gui_input)
+		print("[CEFHOOK] gui_input signal connected")
+	else:
+		print("[CEFHOOK] gui_input signal MISSING")
+	_hook_node = preload("res://vit_dock/diagnostics/cef_input_hook_probe_node.gd").new()
+	_window.add_child(_hook_node)
+	print("[CEFHOOK] hook node added")
+	# 点击页面中部（给 CefTexture 焦点+取点击校准），再注入 ⌘V
+	await _click_raw(Vector2(300, 300))
+	await _sleep(0.3)
+	var calib_js := "(function(){var ev=(window.__inputProbe&&window.__inputProbe.events())||[];for(var i=ev.length-1;i>=0;i--){if(ev[i].type==='pointerdown'){console.log('[PD] '+JSON.stringify({t:'calib',x:ev[i].detail.x,y:ev[i].detail.y}));return;}}console.log('[PD] '+JSON.stringify({t:'calib',x:-1,y:-1}))})()"
+	_host.eval_js(calib_js)
+	await _sleep(0.5)
+	var click_scale := Vector2(1.0, 1.0)
+	if _last_calib.x > 0.0 and _last_calib.y > 0.0:
+		click_scale = Vector2(_last_calib.x / 300.0, _last_calib.y / 300.0)
+	print("[CEFHOOK] click_scale=%s" % str(click_scale))
+	_print_focus_owner("page-center")
+	_press_key(86, true, true)
+	await _sleep(0.08)
+	_press_key(86, false, true)
+	await _sleep(1.0)
+	# 点击 react-b 字段（模拟真实粘贴前置：字段聚焦/IME 代理接管），再注入 ⌘V
+	_host.eval_js("(function(){var e=document.querySelector('[data-w=\"react-b\"]');if(e){e.scrollIntoView({block:'center'});}})()")
+	await _sleep(0.2)
+	var field_js := "(function(){var e=document.querySelector('[data-w=\"react-b\"]');if(!e){console.log('[PD] '+JSON.stringify({t:'hookpos',ok:false}));return;}var r=e.getBoundingClientRect();console.log('[PD] '+JSON.stringify({t:'hookpos',ok:true,cx:r.x+r.width/2,cy:r.y+r.height/2}))})()"
+	_host.eval_js(field_js)
+	await _sleep(0.4)
+	var fpos: Vector2 = _last_hook_pos
+	if fpos == Vector2.ZERO:
+		print("[CEFHOOK] field locate failed, skip field leg")
+	else:
+		var raw_fpos := Vector2(fpos.x / click_scale.x, fpos.y / click_scale.y)
+		print("[CEFHOOK] field css=%s raw=%s" % [str(fpos), str(raw_fpos)])
+		# 复刻 autodrive 前置：warmup 点击 native-a（建代理）。
+		var na_js := "(function(){var e=document.querySelector('[data-w=\"native-a\"]');if(!e){console.log('[PD] '+JSON.stringify({t:'napos',ok:false}));return;}var r=e.getBoundingClientRect();console.log('[PD] '+JSON.stringify({t:'napos',ok:true,cx:r.x+r.width/2,cy:r.y+r.height/2}))})()"
+		_host.eval_js(na_js)
+		await _sleep(0.4)
+		if _last_na_pos != Vector2.ZERO:
+			await _click_raw(Vector2(_last_na_pos.x / click_scale.x, _last_na_pos.y / click_scale.y))
+			await _sleep(0.3)
+			await _probe_page_focus("warmup-na")
+		# decoy grab（复刻 synth 前半）。
+		if _decoy != null:
+			_decoy.grab_focus()
+			await _sleep(0.15)
+			var proxy := _find_ime_proxy()
+			if proxy != null:
+				proxy.grab_focus()
+			await _sleep(1.0)
+			await _probe_page_focus("post-synth")
+		await _click_raw(raw_fpos)
+		await _sleep(0.05)
+		await _probe_page_focus("t+0.05s")
+		await _sleep(0.25)
+		await _probe_page_focus("t+0.30s")
+		_print_focus_owner("field-focus")
+		_press_key(86, true, true)
+		await _sleep(0.08)
+		_press_key(86, false, true)
+		await _sleep(1.0)
+		await _probe_page_focus("post-cmdv")
+	print("[CEFHOOK] RESULT gui_input_hits=%d unhandled_hits=%d key_hits=%d" % [
+		_gui_input_hits, _unhandled_hits, _key_hits])
+	_host.close()
+	get_tree().quit(0)
+
+
+var _last_hook_pos := Vector2.ZERO
+var _last_calib := Vector2.ZERO
+var _last_na_pos := Vector2.ZERO
+var _decoy: Button = null
+
+
+func _find_ime_proxy() -> Control:
+	var browser: Control = _host.debug_browser()
+	if browser == null or not is_instance_valid(browser):
+		return null
+	for child in browser.get_children():
+		if child is LineEdit:
+			return child
+	return null
+
+
+func _print_focus_owner(tag: String) -> void:
+	var owner := get_viewport().gui_get_focus_owner() if get_viewport() != null else null
+	print("[CEFHOOK] focus_owner@%s %s" % [tag, str(owner.get_path()) if owner != null else "<null>"])
+
+
+func _probe_page_focus(tag: String) -> void:
+	_host.eval_js("(function(){var ev=(window.__inputProbe&&window.__inputProbe.events())||[];var lastpd=null;for(var i=ev.length-1;i>=0;i--){if(ev[i].type==='pointerdown'){lastpd=ev[i];break;}}console.log('[PD] '+JSON.stringify({t:'pgfocus',tag:'%s',hf:document.hasFocus(),ae:(document.activeElement?String(document.activeElement.tagName+(document.activeElement.dataset&&document.activeElement.dataset.w?':'+document.activeElement.dataset.w:'')):'none'),ne:ev.length,pd:(lastpd?(String(Math.round(lastpd.detail.x))+','+String(Math.round(lastpd.detail.y))):'none')}))})()" % tag)
+	await _sleep(0.35)
+
+
+func _on_browser_gui_input(event: InputEvent) -> void:
+	if event is InputEventKey:
+		_gui_input_hits += 1
+		print("[CEFHOOK] gui_input KEY %s" % str(event))
+
+
+func _on_hook_stats(gui: int, unhandled: int, key: int) -> void:
+	_gui_input_hits += gui
+	_unhandled_hits += unhandled
+	_key_hits += key
+
+
+func _on_console(message: String) -> void:
+	if message.begins_with("[CEFHOOK]"):
+		print("[CEFHOOK] page %s" % message)
+	elif message.begins_with("[PD]"):
+		var parsed: Variant = JSON.parse_string(message.substr(4))
+		if typeof(parsed) != TYPE_DICTIONARY:
+			return
+		if str(parsed.get("t", "")) == "hookpos" and bool(parsed.get("ok", false)):
+			_last_hook_pos = Vector2(float(parsed.get("cx", 0.0)), float(parsed.get("cy", 0.0)))
+			print("[CEFHOOK] field pos %s" % str(_last_hook_pos))
+		elif str(parsed.get("t", "")) == "napos" and bool(parsed.get("ok", false)):
+			_last_na_pos = Vector2(float(parsed.get("cx", 0.0)), float(parsed.get("cy", 0.0)))
+			print("[CEFHOOK] native-a pos %s" % str(_last_na_pos))
+		elif str(parsed.get("t", "")) == "calib":
+			_last_calib = Vector2(float(parsed.get("x", -1.0)), float(parsed.get("y", -1.0)))
+		elif str(parsed.get("t", "")) == "pgfocus":
+			print("[CEFHOOK] page_focus@%s hf=%s ae=%s pd=%s" % [
+				str(parsed.get("tag", "")), str(parsed.get("hf", "")), str(parsed.get("ae", "")), str(parsed.get("pd", ""))])
+
+
+func _click_raw(pos: Vector2) -> void:
+	_press_mouse(pos, true)
+	await _sleep(0.08)
+	_press_mouse(pos, false)
+	await _sleep(0.05)
+
+
+func _press_mouse(pos: Vector2, pressed: bool) -> void:
+	if _window == null or not is_instance_valid(_window):
+		return
+	var ev := InputEventMouseButton.new()
+	ev.button_index = MOUSE_BUTTON_LEFT
+	ev.pressed = pressed
+	ev.position = pos
+	ev.global_position = pos
+	_window.push_input(ev, true)
+
+
+func _press_key(keycode: int, pressed: bool, meta := false) -> void:
+	if _window == null or not is_instance_valid(_window):
+		return
+	var ev := InputEventKey.new()
+	ev.pressed = pressed
+	ev.keycode = keycode as Key
+	ev.physical_keycode = keycode as Key
+	ev.unicode = 0
+	ev.meta_pressed = meta
+	_window.push_input(ev, true)
+
+
+func _sleep(sec: float) -> void:
+	var loop := Engine.get_main_loop()
+	if loop is SceneTree:
+		await (loop as SceneTree).create_timer(sec).timeout
+
+
+func _fail(reason: String) -> void:
+	print("[CEFHOOK] abort reason=%s" % reason)
+	if _host != null and is_instance_valid(_host):
+		_host.close()
+	get_tree().quit(2)
