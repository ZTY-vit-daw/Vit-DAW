+func _on_browser_gui_input(event: InputEvent) -> void:
+	if not (event is InputEventKey):
+		return
+	var key := event as InputEventKey
+	if not key.pressed or key.echo:
+		return
+	if key.keycode != KEY_V or not key.meta_pressed:
+		return
+	if not VitDebugFlags.cef_paste_shim_enabled:
+		VitDebugFlags.log_cef_paste("paste.shim disabled, passthrough")
+		return
+	if not _require_ready("paste_shim"):
+		return
+	var clip := DisplayServer.clipboard_get()
+	if clip.is_empty():
+		VitDebugFlags.log_cef_paste("paste.shim clipboard empty, skip")
+		return
+	VitDebugFlags.log_cef_paste("paste.shim fire len=%d" % clip.length())
+	var js := PASTE_SHIM_INSERT_JS % [JSON.stringify(clip), clip.length()]
+	_browser.call("eval", js)
