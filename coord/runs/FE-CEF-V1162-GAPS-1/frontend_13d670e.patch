+const PASTE_SHIM_INSERT_JS := """
+(function () {
+	try {
+		if (window.__vitCefComposing === true) { console.log('[VPS] busy'); return; }
+		var el = document.activeElement;
+		if (!el || !el.tagName) { console.log('[VPS] noactive'); return; }
+		var tag = el.tagName.toLowerCase();
+		var editable = false;
+		if (tag === 'input' || tag === 'textarea') {
+			editable = !el.readOnly && !el.disabled;
+		} else {
+			editable = el.isContentEditable === true;
+		}
+		if (!editable) { console.log('[VPS] noeditable:' + tag); return; }
+		var ok = document.execCommand('insertText', false, %s);
+		console.log('[VPS] insert ' + (ok ? 'ok' : 'rejected') + ' len=' + %d);
+	} catch (e) { console.log('[VPS] err:' + String(e)); }
+})()
