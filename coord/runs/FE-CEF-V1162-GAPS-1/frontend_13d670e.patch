diff --git a/vit_dock/diagnostics/cef_click_matrix.gd b/vit_dock/diagnostics/cef_click_matrix.gd
new file mode 100644
index 0000000..86fb36d
--- /dev/null
+++ b/vit_dock/diagnostics/cef_click_matrix.gd
@@ -0,0 +1,155 @@
+extends Node
+
+## FE-CEF-V1162-GAPS-1 取证：点击转发性矩阵（一次性，不入验收链）。
+## 问题：hook test 中校准点击到达页面（pd 更新），其后所有 push_input 点击
+## 页面均未收到（pd 停滞）。本场景逐步隔离：
+##   M1 校准点击 → pd 基线
+##   M2 再点击（无任何按键介入）→ pd 是否更新
+##   M3 ⌘V down/up 注入 → 再点击 → pd 是否更新
+##   M4 meta 单独 release 注入 → 再点击 → pd 是否更新
+## 全程 VIT_CEF_PASTE_SHIM=0（隔离垫片）。
+
+const URL := "http://127.0.0.1:7879/"
+const OUT_FILE := "/tmp/cef_click_matrix_result.txt"
+
+var _host: VitCefWebViewHost
+var _window: Window = null
+var _last_pd := "none"
+
+
+func _say(line: String) -> void:
+	print(line)
+	var f := FileAccess.open(OUT_FILE, FileAccess.READ_WRITE if FileAccess.file_exists(OUT_FILE) else FileAccess.WRITE)
+	if f != null:
+		f.seek_end()
+		f.store_line(line)
+		f.close()
+
+
+func _ready() -> void:
+	call_deferred("_boot")
+
+
+func _boot() -> void:
+	_host = VitCefWebViewHost.new()
+	_host.debug_console_received.connect(_on_console)
+	if not _host.create_window(0, "CEF Click Matrix", 900, 700):
+		_fail("host.create_window failed")
+		return
+	_window = _host.debug_window()
+	if _window != null and is_instance_valid(_window):
+		DisplayServer.window_move_to_foreground(_window.get_window_id())
+	_host.navigate(URL)
+	_host.focus()
+	# 末招：隐藏主窗口，逼 AppKit 把 key 交给 CEF 窗口。
+	get_tree().root.visible = false
+	await _sleep(2.0)
+	if _window != null and is_instance_valid(_window):
+		DisplayServer.window_move_to_foreground(_window.get_window_id())
+	await _sleep(6.0)
+	await _click_raw(Vector2(300, 300))
+	await _probe("M1-calib")
+	# M1b：无任何 eval/按键介入的连续两击。
+	await _click_raw(Vector2(400, 260))
+	await _click_raw(Vector2(420, 280))
+	await _probe("M1b-two-clicks-no-eval")
+	await _click_raw(Vector2(320, 300))
+	await _probe("M2-click-only")
+	_press_key(86, true, true)
+	await _sleep(0.08)
+	_press_key(86, false, true)
+	await _sleep(0.5)
+	await _click_raw(Vector2(340, 300))
+	await _probe("M3-after-cmdv")
+	_press_key(4194304, false, false)  # KEY_META release（keycode 位掩码形态）
+	await _sleep(0.3)
+	await _click_raw(Vector2(360, 300))
+	await _probe("M4-after-meta-release")
+	# M5：motion + click——辨别「mouse leave 后需 move 重入」假设。
+	_press_motion(Vector2(370, 310))
+	await _sleep(0.1)
+	await _click_raw(Vector2(380, 320))
+	await _probe("M5-motion-then-click")
+	_say("[CEFMATRIX] DONE")
+	_host.close()
+	get_tree().quit(0)
+
+
+func _probe(tag: String) -> void:
+	var wf := "n/a"
+	if _window != null and is_instance_valid(_window):
+		wf = str(_window.has_focus())
+	_last_pd = "none"
+	_last_pm = "none"
+	_ne = "-1"
+	_host.eval_js("(function(){var ev=(window.__inputProbe&&window.__inputProbe.events())||[];var lastpd=null;var lastpm=null;for(var i=ev.length-1;i>=0;i--){if(ev[i].type==='pointerdown'&&!lastpd){lastpd=ev[i];}if(ev[i].type==='pointermove'&&!lastpm){lastpm=ev[i];}}console.log('[PD] '+JSON.stringify({t:'mtx',tag:'%s',ne:ev.length,pd:(lastpd?(String(Math.round(lastpd.detail.x))+','+String(Math.round(lastpd.detail.y))):'none'),pm:(lastpm?(String(Math.round(lastpm.detail.x))+','+String(Math.round(lastpm.detail.y))):'none')}))})()" % tag)
+	await _sleep(0.5)
+	_say("[CEFMATRIX] %s pd=%s pm=%s ne=%s win_focus=%s" % [tag, _last_pd, _last_pm, _ne, wf])
+
+
+var _last_pm := "none"
+var _ne := "-1"
+
+
+func _on_console(message: String) -> void:
+	if message.begins_with("[PD]"):
+		var parsed: Variant = JSON.parse_string(message.substr(4))
+		if typeof(parsed) == TYPE_DICTIONARY and str(parsed.get("t", "")) == "mtx":
+			_last_pd = str(parsed.get("pd", "none"))
+			_last_pm = str(parsed.get("pm", "none"))
+			_ne = str(parsed.get("ne", "-1"))
+
+
+func _click_raw(pos: Vector2) -> void:
+	# 每次点击前重申前台/key 状态（后台激活时序竞争：activate 后 key 可能落回主窗）。
+	if _window != null and is_instance_valid(_window):
+		DisplayServer.window_move_to_foreground(_window.get_window_id())
+	_press_mouse(pos, true)
+	await _sleep(0.08)
+	_press_mouse(pos, false)
+	await _sleep(0.3)
+
+
+func _press_mouse(pos: Vector2, pressed: bool) -> void:
+	if _window == null or not is_instance_valid(_window):
+		return
+	var ev := InputEventMouseButton.new()
+	ev.button_index = MOUSE_BUTTON_LEFT
+	ev.pressed = pressed
+	ev.position = pos
+	ev.global_position = pos
+	_window.push_input(ev, true)
+
+
+func _press_motion(pos: Vector2) -> void:
+	if _window == null or not is_instance_valid(_window):
+		return
+	var ev := InputEventMouseMotion.new()
+	ev.position = pos
+	ev.global_position = pos
+	_window.push_input(ev, true)
+
+
+func _press_key(keycode: int, pressed: bool, meta := false) -> void:
+	if _window == null or not is_instance_valid(_window):
+		return
+	var ev := InputEventKey.new()
+	ev.pressed = pressed
+	ev.keycode = keycode as Key
