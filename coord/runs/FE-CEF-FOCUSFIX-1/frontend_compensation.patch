+# --- 焦点乒乓补偿（FE-CEF-FOCUSFIX-1，VIT_CEF_FOCUS_COMPENSATION=1 时生效） -----
+
+## 探针/诊断面：内部 Window 引用（autodrive 驱动注入 push_input 用），产品链路不消费。
+func debug_window() -> Window:
+	return _window
+
+
+## 探针/诊断面：内部 CefTexture 引用（autodrive 检视 IME 代理子节点用），产品链路不消费。
+func debug_browser() -> Control:
+	return _browser
+
+
+func _start_focus_compensation() -> void:
+	if _comp_tick_alive:
+		return
+	_comp_tick_alive = true
+	_comp_tick()
+
+
+## 常驻轻量 tick（关时每 tick 仅一次旗标检查）；开启期每 tick 先向页面请求焦点回报，
+## 再评估补偿签名（回报解析见 _on_console_message）。
+func _comp_tick() -> void:
+	if not _comp_tick_alive:
+		return
+	if VitDebugFlags.cef_focus_compensation_enabled:
+		_comp_evaluate()
+	var loop := Engine.get_main_loop()
+	if loop is SceneTree:
+		var timer := (loop as SceneTree).create_timer(_COMP_TICK_SEC)
+		await timer.timeout
+		_comp_tick()
+
+
+func _comp_evaluate() -> void:
+	if _browser == null or not is_instance_valid(_browser) or not _browser.is_inside_tree():
+		return
+	_browser.call("eval", "window.__vitCefFocusProbeReport && window.__vitCefFocusProbeReport();")
+	var now := Time.get_ticks_msec()
+	if not _visible or _loading:
+		_comp_page_unfocused_since_msec = -1
+		return
+	if now - _comp_last_fire_msec < _COMP_COOLDOWN_MSEC or now < _comp_backoff_until_msec:
+		return
+	var report_fresh := now - _comp_page_focus_report_msec <= _COMP_PAGE_REPORT_FRESH_MSEC
+	var page_unfocused_long := _comp_page_unfocused_since_msec >= 0 \
+			and now - _comp_page_unfocused_since_msec >= _COMP_PAGE_UNFOCUSED_MSEC
+	var owner_in_scope := _comp_focus_owner_in_browser_scope()
+	var churn := _comp_churn_count(now)
+	if not (report_fresh and page_unfocused_long and owner_in_scope and churn >= _COMP_CHURN_MIN_EVENTS):
+		return
+	if _comp_page_composing:
+		return
+	_comp_fire(now, churn)
+
+
+func _comp_fire(now: int, churn: int) -> void:
+	_comp_last_fire_msec = now
+	_comp_fire_times_msec.append(now)
+	_comp_prune(_comp_fire_times_msec, now, _COMP_BACKOFF_WINDOW_MSEC)
+	var fire_no := _comp_fire_times_msec.size()
+	var had_window_focus := _window != null and is_instance_valid(_window) and _window.has_focus()
+	var unfocused_ms := -1
+	if _comp_page_unfocused_since_msec >= 0:
+		unfocused_ms = now - _comp_page_unfocused_since_msec
+	VitDebugFlags.log_cef_focus("compensation.fire #%d churn=%d win_focus=%s page_unfocused=%dms owner=%s" % [
+		fire_no, churn, str(had_window_focus), unfocused_ms, _focus_owner_path()])
+	if _window != null and is_instance_valid(_window) and not had_window_focus:
+		_window.grab_focus()
+	if _browser != null and is_instance_valid(_browser) and _browser.is_inside_tree():
+		_browser.grab_focus()
+	# 已出手：失焦计时作废，等页面下一轮回报重新认定（仍失焦则冷却期后重评估）。
+	_comp_page_unfocused_since_msec = -1
+	_comp_verify_after_fire(fire_no)
+	if fire_no >= _COMP_BACKOFF_FIRE_COUNT:
+		_comp_backoff_until_msec = now + _COMP_BACKOFF_PAUSE_MSEC
+		_comp_fire_times_msec.clear()
+		VitDebugFlags.log_cef_focus("compensation.backoff pause=%dms（短窗连续触发过密，暂停防抖动）" % _COMP_BACKOFF_PAUSE_MSEC)
+
+
+func _comp_verify_after_fire(fire_no: int) -> void:
+	await _comp_sleep(0.3)
