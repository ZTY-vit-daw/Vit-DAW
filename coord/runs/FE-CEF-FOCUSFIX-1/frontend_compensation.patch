+
+
+func _comp_churn_count(now: int) -> int:
+	_comp_prune(_comp_event_times_msec, now, _COMP_CHURN_WINDOW_MSEC)
+	return _comp_event_times_msec.size()
+
+
+func _comp_prune(arr: Array[int], now: int, window_msec: int) -> void:
+	while arr.size() > 0 and now - arr[0] > window_msec:
+		arr.pop_front()
