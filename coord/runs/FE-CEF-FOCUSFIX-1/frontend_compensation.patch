diff --git a/app/kernel/autoloads/VitDebugFlags.gd b/app/kernel/autoloads/VitDebugFlags.gd
index 4e970a7..e646cdc 100644
--- a/app/kernel/autoloads/VitDebugFlags.gd
+++ b/app/kernel/autoloads/VitDebugFlags.gd
@@ -15,6 +15,11 @@ var webui_lifecycle_log_enabled: bool = false
 ## CefTexture 的焦点进出/grab_focus/set_visible/心跳焦点态。默认关。
 ## 开启: env VIT_CEF_FOCUS_LOG=1 或 JSON "cef_focus_log_enabled": true
 var cef_focus_log_enabled: bool = false
+## CEF 焦点乒乓补偿（FE-CEF-FOCUSFIX-1，过渡 hack，根修=升级 gdcef）：检测
+## gdcef IME 桥乒乓失焦态（页面回报 hasFocus=false 持续 + CefTexture/IME 代理焦点
+## 高频换手）→ window.grab_focus + CefTexture.grab_focus 重置焦点环。默认关。
+## 开启: env VIT_CEF_FOCUS_COMPENSATION=1 或 JSON "cef_focus_compensation_enabled": true
+var cef_focus_compensation_enabled: bool = false
 # Narrow, high-signal clip import/bake routing diagnostics.
 # Enable by either:
 # 1) env: VIT_CLIP_PIPELINE_LOG=1
@@ -149,6 +154,11 @@ func _load_from_env() -> void:
 		cef_focus_log_enabled = true
 	elif cef_focus_raw in ["0", "false", "off", "no"]:
 		cef_focus_log_enabled = false
+	var cef_comp_raw := OS.get_environment("VIT_CEF_FOCUS_COMPENSATION").strip_edges().to_lower()
+	if cef_comp_raw in ["1", "true", "on", "yes"]:
+		cef_focus_compensation_enabled = true
+	elif cef_comp_raw in ["0", "false", "off", "no"]:
+		cef_focus_compensation_enabled = false
 	var clip_raw := OS.get_environment("VIT_CLIP_PIPELINE_LOG").strip_edges().to_lower()
 	if clip_raw in ["1", "true", "on", "yes"]:
 		clip_pipeline_log_enabled = true
@@ -254,6 +264,8 @@ func _reload_from_commands_file_if_changed(force: bool = false) -> void:
 		webui_lifecycle_log_enabled = bool(d["webui_lifecycle_log_enabled"])
 	if d.has("cef_focus_log_enabled"):
 		cef_focus_log_enabled = bool(d["cef_focus_log_enabled"])
+	if d.has("cef_focus_compensation_enabled"):
