+
+## console 通道回传：仅认 [ADRV] 前缀（页面 eval 的诊断响应）。
+func _on_console(message: String) -> void:
+	var prefix := "[ADRV] "
+	if not message.begins_with(prefix):
+		return
+	var parsed: Variant = JSON.parse_string(message.substr(prefix.length()))
+	if typeof(parsed) == TYPE_DICTIONARY:
+		_ipc_queue.append(parsed)
