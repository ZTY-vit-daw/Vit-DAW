+		return
+	_mark("r%d.synth stuck: decoy grab → proxy grab" % r)
+	_decoy.grab_focus()
+	await _sleep(0.15)
+	proxy.grab_focus()
+	# 等待越过补偿阈值（失焦判定 1.2s+tick 0.25s）——OFF 应维持失焦，ON 应见补偿
+	# 自主恢复（页面 hasFocus 回 true，无需任何点击）。
+	await _sleep(3.0)
+	var hf := await _page_has_focus()
+	print("[CEFAUTODRIVE] round %d synth page_hasFocus=%s owner=%s" % [r, str(hf), _focus_owner_path()])
+
+
+func _ime_proxy() -> Control:
+	var browser: Control = _host.debug_browser()
+	if browser == null or not is_instance_valid(browser):
+		return null
+	for child in browser.get_children():
