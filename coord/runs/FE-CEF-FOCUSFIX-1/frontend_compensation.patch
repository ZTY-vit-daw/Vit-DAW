 	if d.has("clip_pipeline_log_enabled"):
 		clip_pipeline_log_enabled = bool(d["clip_pipeline_log_enabled"])
 	if d.has("wave_tile_diag_log_enabled"):
diff --git a/vit_dock/diagnostics/cef_focus_autodrive.gd b/vit_dock/diagnostics/cef_focus_autodrive.gd
new file mode 100644
index 0000000..eae5b65
--- /dev/null
+++ b/vit_dock/diagnostics/cef_focus_autodrive.gd
@@ -0,0 +1,364 @@
+extends Node
+
+## FE-CEF-FOCUSFIX-1 探针驱动场景（验收自证专用，不在产品链路：仅显式以场景参数启动，
+##   Godot --path <前端仓> res://vit_dock/diagnostics/cef_focus_autodrive.tscn）。
+##
+## 直接实例化 VitCefWebViewHost 指向 input_probe 探针页（默认 http://127.0.0.1:7879/，
+## 可用 VIT_CEF_AUTODRIVE_URL 覆盖），按取证四步序列在引擎边界注入输入
+## （Window.push_input——不经 OS 键鼠，符合 AGENTS §5 主机控制禁令的边界）：
+##   ①点击 A 框输入 abc{r} → ②点击 B 框输入 hello{r} → ③点回 A 输入 xy{r} →
+##   ④点击 B 框 ⌘V 粘贴 PASTE-{r}（pbcopy 预置剪贴板）。
+## 页面实值经 host eval_js → sendIpcMessage → web_message_received 回传比对；
+## 每步在探针时间线打 mark（[:INPROBE] 镜像可对照）。结果打 [CEFAUTODRIVE] 行，
+## 全轮全步通过 quit(0)，任一失败 quit(1)，环境/宿主故障 quit(2)。
+##
+## 环境：VIT_CEF_AUTODRIVE_URL（探针地址）/ VIT_CEF_AUTODRIVE_ROUNDS（默认 5）。
+## 补偿开关沿用 VitDebugFlags（VIT_CEF_FOCUS_COMPENSATION），开关两态各跑一轮即成对照。
+
+const URL_ENV := "VIT_CEF_AUTODRIVE_URL"
+const ROUNDS_ENV := "VIT_CEF_AUTODRIVE_ROUNDS"
+const DEFAULT_URL := "http://127.0.0.1:7879/"
+const PAGE_BOOT_TIMEOUT_SEC := 25.0
+const IPC_TIMEOUT_SEC := 3.0
+const CLICK_HOLD_SEC := 0.06
+const SETTLE_AFTER_CLICK_SEC := 0.40
+const SETTLE_AFTER_STEP_SEC := 0.50
+const KEY_PRESS_SEC := 0.06
+const KEY_INTERVAL_SEC := 0.16
+
+var _host: VitCefWebViewHost
+var _window: Window = null
+var _decoy: Control = null
+var _rounds := 5
+var _field_pos: Dictionary = {}
+var _ipc_queue: Array = []
+var _expected_a := ""
+var _expected_b := ""
+# 校准出的点击映射：push_input 纹理坐标 → 页面 clientX/Y 的比例（css = texture * scale）。
+# gdcef OSR 转发实测含 device-scale 折算（M3 dpr=2 时 css=texture*0.5），不能假设 1:1。
+var _click_scale := Vector2(1.0, 1.0)
+
+
+func _ready() -> void:
+	# _ready 期场景根仍在装配子节点，直接 add_child 会失败（实测"Parent node is busy
+	# setting up children"→窗口不入树→CEF 浏览器不创建）——延迟到装配完成后再启动。
+	call_deferred("_boot")
+
+
+func _boot() -> void:
+	var rounds_raw := OS.get_environment(ROUNDS_ENV).strip_edges()
+	if rounds_raw.is_valid_int():
+		_rounds = clampi(int(rounds_raw), 1, 50)
+	_host = VitCefWebViewHost.new()
+	_host.web_message_received.connect(_on_ipc)
+	# 页面回传走 console 通道（[ADRV] 前缀）：sendIpcMessage 在焦点乒乓失焦态下会
+	# 停摆（FE-CEF-FOCUSFIX-1 实测+上游 #228 家族），console 全程可用。
+	_host.debug_console_received.connect(_on_console)
+	if not _host.create_window(0, "CEF Focus Autodrive", 1100, 880):
+		_fail_fast("host.create_window failed")
+		return
+	_window = _host.debug_window()
+	# 诱饵控件（CEF 窗口内、浏览器外）：grab_focus 交出浏览器焦点（合成卡死态用）。
+	_decoy = Button.new()
+	_decoy.name = "AutodriveDecoy"
+	_decoy.text = "decoy"
+	_decoy.position = Vector2(6, 40)
+	_decoy.focus_mode = Control.FOCUS_ALL
+	_window.add_child(_decoy)
+	var url := OS.get_environment(URL_ENV).strip_edges()
+	if url.is_empty():
+		url = DEFAULT_URL
+	print("[CEFAUTODRIVE] cfg url=%s rounds=%d compensation=%s" % [
+		url, _rounds, str(VitDebugFlags.cef_focus_compensation_enabled)])
+	_host.navigate(url)
+	_host.focus()
+	_run()
+
+
+func _run() -> void:
+	if not await _wait_page_boot():
+		_fail_fast("probe page boot timeout (sendIpcMessage 未回响)")
+		return
+	_compact_layout()
+	if not await _calibrate_click():
+		_fail_fast("click calibration failed (校准点击未回响)")
+		return
+	for id in ["native-a", "react-b"]:
+		if not await _locate_field(id):
+			_fail_fast("locate failed: %s" % id)
+			return
+	print("[CEFAUTODRIVE] page.ready scale=%s a=%s b=%s" % [str(_click_scale), str(_field_pos.get("native-a")), str(_field_pos.get("react-b"))])
+	var rounds_pass := 0
+	for r in range(1, _rounds + 1):
+		if await _run_round(r):
+			rounds_pass += 1
+	var all_pass := rounds_pass == _rounds
+	print("[CEFAUTODRIVE] FINAL %s rounds_pass=%d/%d" % ["pass" if all_pass else "fail", rounds_pass, _rounds])
+	await _sleep(0.6)
+	get_tree().quit(0 if all_pass else 1)
+
+
+func _run_round(r: int) -> bool:
+	# 预热：点击 A 建立 IME 代理（真实用户路径），再合成卡死态；随后四步序列。
+	await _click_field("native-a")
+	await _sleep(0.2)
+	await _synthesize_stuck(r)
+	var s1: bool = await _step_type(r, "s1", "A", "native-a", "a", "abc%d" % r)
+	var s2: bool = await _step_type(r, "s2", "B", "react-b", "b", "hello%d" % r)
+	var s3: bool = await _step_type(r, "s3", "A", "native-a", "a", "xy%d" % r)
+	var s4: bool = await _step_paste(r)
+	var ok := s1 and s2 and s3 and s4
+	print("[CEFAUTODRIVE] round %d verdict=%s" % [r, "pass" if ok else "fail"])
+	return ok
+
+
+func _step_type(r: int, step: String, label: String, data_w: String, state_key: String, text: String) -> bool:
+	_mark("r%d.%s click %s + type %s" % [r, step, label, text])
+	await _click_field(data_w)
+	await _type_text(text)
+	await _sleep(SETTLE_AFTER_STEP_SEC)
+	return await _check_state(r, step, label, state_key, text)
+
+
+func _step_paste(r: int) -> bool:
+	var paste_text := "PASTE-%d" % r
+	_mark("r%d.s4 click B + cmd-V paste %s" % [r, paste_text])
+	await _click_field("react-b")
+	var paste_cmd := "printf %%s '%s' | pbcopy" % paste_text
+	OS.execute("/bin/bash", ["-c", paste_cmd])
+	await _sleep(0.15)
+	_press_key(86, true, true)  # ⌘V down
+	await _sleep(KEY_PRESS_SEC)
+	_press_key(86, false, true)  # ⌘V up
+	await _sleep(SETTLE_AFTER_STEP_SEC + 0.1)
+	return await _check_state(r, "s4", "B", "b", paste_text)
+
+
+func _check_state(r: int, step: String, label: String, state_key: String, appended: String) -> bool:
+	if state_key == "a":
+		_expected_a += appended
+	else:
+		_expected_b += appended
+	var state: Dictionary = await _fetch_state()
+	if state.is_empty():
+		print("[CEFAUTODRIVE] round %d step %s(%s) verdict=fail got=no-ipc want=%s" % [r, step, label, _expected_a if state_key == "a" else _expected_b])
+		return false
+	var got := str(state.get(state_key, ""))
+	var want := _expected_a if state_key == "a" else _expected_b
+	var step_ok := got == want
+	print("[CEFAUTODRIVE] round %d step %s(%s) verdict=%s got=\"%s\" want=\"%s\"" % [r, step, label, "pass" if step_ok else "fail", got, want])
+	return step_ok
+
+
+# --- 页面交互（eval → sendIpcMessage → ipc_message 回传） ----------------------
+
+
+## 把探针页测试组件挪到视口左上（fixed 覆盖布局）：点击坐标经 gdcef OSR 转发带
+## device-scale 折算，右侧/下方元素换算后可能越出 CefTexture 范围——紧凑布局保证
+## 目标元素在可注入域内。同时隐藏探针浮层（[data-probe-overlay] 右上 fixed、
+## pointer-events:auto，窄视口下会盖住输入列吃掉点击；时间线证据走 console 镜像
+## 不依赖浮层）。
+func _compact_layout() -> void:
+	_host.eval_js("(function(){var f=document.querySelector('fieldset');if(f){f.style.position='fixed';f.style.left='16px';f.style.top='80px';f.style.margin='0';f.style.zIndex='50';f.style.background='#fff';}var o=document.querySelector('[data-probe-overlay]');if(o){o.style.display='none';}})()")
+
+
+## 校准：在已知纹理坐标 (300,200) 点击一次，取页面实测 clientX/Y，得 css=texture*k。
+func _calibrate_click() -> bool:
+	await _click_raw(Vector2(300, 200))
+	# 注意：__inputProbe.events() 活数组的字段名是 type/detail（console 镜像的 l/t/tg/d
+	# 只是打印形态），此处按源码字段取值。
+	var js := "(function(){var ev=(window.__inputProbe&&window.__inputProbe.events())||[];for(var i=ev.length-1;i>=0;i--){if(ev[i].type==='pointerdown'){console.log('[ADRV] '+JSON.stringify({t:'calib',x:ev[i].detail.x,y:ev[i].detail.y}));return;}}console.log('[ADRV] '+JSON.stringify({t:'calib',x:-1,y:-1}))})()"
+	var reply: Dictionary = await _eval_await(js, "calib", IPC_TIMEOUT_SEC)
+	if reply.is_empty() or float(reply.get("x", -1.0)) <= 0.0:
+		return false
+	_click_scale = Vector2(float(reply.get("x")) / 300.0, float(reply.get("y")) / 200.0)
+	return _click_scale.x > 0.01 and _click_scale.y > 0.01
+
+
+func _locate_field(data_w: String) -> bool:
+	var js := "(()=>{const e=document.querySelector('[data-w=\"%s\"]');if(!e){console.log('[ADRV] '+JSON.stringify({t:'pos',id:'%s',ok:false}));return;}const r=e.getBoundingClientRect();console.log('[ADRV] '+JSON.stringify({t:'pos',id:'%s',ok:true,cx:r.x+r.width/2,cy:r.y+r.height/2}))})()" % [data_w, data_w, data_w]
+	var reply: Dictionary = await _eval_await(js, "pos", IPC_TIMEOUT_SEC)
+	if reply.is_empty() or not bool(reply.get("ok", false)):
+		return false
+	# 存 css 中心；点击时按校准比例换算回纹理坐标。
+	_field_pos[data_w] = Vector2(float(reply.get("cx", 0.0)), float(reply.get("cy", 0.0)))
+	return true
+
+
+func _wait_page_boot() -> bool:
+	var deadline := Time.get_ticks_msec() + int(PAGE_BOOT_TIMEOUT_SEC * 1000.0)
+	while Time.get_ticks_msec() < deadline:
+		if not _ipc_queue.is_empty():
+			var boot := _drain_ipc("boot")
+			if not boot.is_empty():
+				# eval world 可见性诊断（决定回传策略：隔离 world 时页面 JS 全局不可见）。
+				print("[CEFAUTODRIVE] boot.diag probe=%s rep=%s ipc=%s ping=%s" % [
+					str(boot.get("probe", "?")), str(boot.get("rep", "?")),
+					str(boot.get("ipc", "?")), str(boot.get("ping", "?"))])
+			return true
+		_host.eval_js("window.__adrvPing=(window.__adrvPing||0)+1;console.log('[ADRV] '+JSON.stringify({t:'boot',probe:typeof window.__inputProbe,rep:typeof window.__vitCefFocusProbeReport,ipc:typeof window.sendIpcMessage,ping:window.__adrvPing}))")
+		await _sleep(0.5)
+	return false
+
+
+func _fetch_state() -> Dictionary:
+	var js := "console.log('[ADRV] '+JSON.stringify({t:'state',a:document.querySelector('[data-w=\"native-a\"]').value,b:document.querySelector('[data-w=\"react-b\"]').value}))"
+	return await _eval_await(js, "state", IPC_TIMEOUT_SEC)
+
+
+func _mark(label: String) -> void:
+	_host.eval_js("window.__inputProbe && window.__inputProbe.mark('%s');" % label)
+
+
+func _eval_await(js: String, tag: String, timeout_sec: float) -> Dictionary:
+	_host.eval_js(js)
+	var deadline := Time.get_ticks_msec() + int(timeout_sec * 1000.0)
+	while Time.get_ticks_msec() < deadline:
+		var hit := _drain_ipc(tag)
+		if not hit.is_empty():
+			return hit
+		await _sleep(0.08)
+	return {}
+
+
+func _drain_ipc(tag: String) -> Dictionary:
+	for i in range(_ipc_queue.size()):
+		var entry: Dictionary = _ipc_queue[i]
+		if str(entry.get("t", "")) == tag:
+			_ipc_queue.remove_at(i)
+			return entry
+	return {}
+
+
+func _on_ipc(message: String) -> void:
+	var parsed: Variant = JSON.parse_string(message)
+	if typeof(parsed) == TYPE_DICTIONARY:
+		_ipc_queue.append(parsed)
