+	return str(owner.get_path())
+
+
+func _page_has_focus() -> bool:
+	var reply: Dictionary = await _eval_await("console.log('[ADRV] '+JSON.stringify({t:'phf',v:document.hasFocus()}))", "phf", IPC_TIMEOUT_SEC)
+	return bool(reply.get("v", true))
+
+
+func _click_field(data_w: String) -> void:
+	var css_center: Vector2 = _field_pos.get(data_w, Vector2(150, 150))
+	# css → 纹理坐标（校准比例的逆）；越界说明紧凑布局失败或映射异常，点击仍发出，
+	# 由页面侧事件对照暴露问题。
+	var pos := Vector2(css_center.x / _click_scale.x, css_center.y / _click_scale.y)
+	await _click_raw(pos)
+
+
+func _click_raw(pos: Vector2) -> void:
+	_press_mouse(pos, true)
+	await _sleep(CLICK_HOLD_SEC)
+	_press_mouse(pos, false)
+	await _sleep(SETTLE_AFTER_CLICK_SEC)
+
+
+func _press_mouse(pos: Vector2, pressed: bool) -> void:
+	if _window == null or not is_instance_valid(_window):
+		return
+	var ev := InputEventMouseButton.new()
+	ev.button_index = MOUSE_BUTTON_LEFT
+	ev.pressed = pressed
+	ev.position = pos
+	ev.global_position = pos
+	_window.push_input(ev, true)
+
+
+func _type_text(text: String) -> void:
+	for ch in text:
+		var lower := ch.to_lower()
+		var keycode := lower.unicode_at(0)
+		if keycode >= 0x61 and keycode <= 0x7A:
+			keycode = keycode - 0x20  # 字母：keycode 用大写形态（Key 枚举），unicode 保留实际字符
+		_press_key_char(keycode, ch.unicode_at(0))
+		await _sleep(KEY_INTERVAL_SEC)
+
+
+func _press_key_char(keycode: int, unicode: int) -> void:
+	_press_key_raw(keycode, unicode, true)
+	await _sleep(KEY_PRESS_SEC)
+	_press_key_raw(keycode, 0, false)
+
+
+func _press_key(keycode: int, pressed: bool, meta := false) -> void:
+	_press_key_raw(keycode, 0, pressed, meta)
+
+
+func _press_key_raw(keycode: int, unicode: int, pressed: bool, meta := false) -> void:
+	if _window == null or not is_instance_valid(_window):
+		return
+	var ev := InputEventKey.new()
+	ev.pressed = pressed
+	ev.keycode = keycode as Key
+	ev.physical_keycode = keycode as Key
+	ev.unicode = unicode
+	ev.meta_pressed = meta
+	_window.push_input(ev, true)
+
+
+func _sleep(sec: float) -> void:
+	var loop := Engine.get_main_loop()
+	if loop is SceneTree:
+		await (loop as SceneTree).create_timer(sec).timeout
+
+
+func _fail_fast(reason: String) -> void:
+	print("[CEFAUTODRIVE] FINAL abort reason=%s" % reason)
+	get_tree().quit(2)
