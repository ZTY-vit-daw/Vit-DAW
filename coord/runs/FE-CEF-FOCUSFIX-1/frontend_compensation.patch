+
+
+func _comp_focus_owner_in_browser_scope() -> bool:
+	if _window == null or not is_instance_valid(_window) or _browser == null or not is_instance_valid(_browser):
+		return false
+	var owner := _window.gui_get_focus_owner()
+	if owner == null:
+		return false
+	if owner == _browser:
+		return true
+	var browser_path := str(_browser.get_path())
