+## FE-SEND-EXTERNAL-REFRESH-1 (161)：从 list_tracks 回执（{tracks: [{track_id/id,
+## plugins: [...]}]}）提取每轨 send 路由插件条目（auxsend/auxreturn 原样行，保留
+## plugin_item_id/type）。返回 {track_id: [entry, ...]}；形状异常返回空表（fail-open）。
+## 动机：VSP 紧凑快照（state_snapshot project.timeline）白名单剥每轨 plugins，SEND 卡
+## 的数据源 auxsend 条目只能从本拉取补齐。
+static func send_route_plugin_entries_from_track_states(tracks: Variant) -> Dictionary:
+	var out: Dictionary = {}
+	if typeof(tracks) != TYPE_ARRAY:
+		return out
+	for track_variant in tracks as Array:
+		if typeof(track_variant) != TYPE_DICTIONARY:
+			continue
+		var track: Dictionary = track_variant
+		var track_id := str(track.get("track_id", track.get("id", ""))).strip_edges()
+		if track_id.is_empty():
+			continue
+		var plugins_variant: Variant = track.get("plugins", [])
+		if typeof(plugins_variant) != TYPE_ARRAY:
+			continue
+		var entries: Array = []
+		for plugin_variant in plugins_variant as Array:
+			if typeof(plugin_variant) != TYPE_DICTIONARY:
+				continue
+			var plugin: Dictionary = plugin_variant
+			if is_send_route_entry(plugin):
+				entries.append(plugin.duplicate(true))
+		if not entries.is_empty():
+			out[track_id] = entries
+	return out
+
+
+## FE-SEND-EXTERNAL-REFRESH-1 (161)：repository 插件行 + 外部快照 send 路由条目合并——
+## 按 plugin_item_id 去重，repository 行优先（rack DAG 布局字段在位），快照条目按
+## list_tracks 原序追加（内核保证 SendOut 严格先于同对 SendIn）。
+static func merge_send_route_entries(plugins: Array, send_route_entries: Array) -> Array:
+	var out: Array = plugins.duplicate(true)
+	var known_ids: Dictionary = {}
+	for entry_variant in out:
+		if typeof(entry_variant) != TYPE_DICTIONARY:
+			continue
+		var entry: Dictionary = entry_variant
+		var item_id := _plugin_item_id_of_entry(entry)
+		if not item_id.is_empty():
+			known_ids[item_id] = true
+	for entry_variant in send_route_entries:
+		if typeof(entry_variant) != TYPE_DICTIONARY:
+			continue
+		var entry: Dictionary = entry_variant
+		var item_id := _plugin_item_id_of_entry(entry)
+		if not item_id.is_empty() and known_ids.has(item_id):
+			continue
+		out.append(entry.duplicate(true))
+	return out
+
+
+static func _plugin_item_id_of_entry(entry: Dictionary) -> String:
+	for key in ["plugin_item_id", "item_id", "plugin_id", "id"]:
+		var value := str(entry.get(key, "")).strip_edges()
+		if not value.is_empty():
+			return value
+	return ""
+
