+func _request_send_route_plugin_snapshot(force: bool = false) -> void:
+	var now := Time.get_ticks_msec()
+	if not force:
+		if _send_route_plugin_snapshot_in_flight and now - _send_route_plugin_snapshot_last_msec < _SEND_ROUTE_PLUGIN_SNAPSHOT_IN_FLIGHT_WINDOW_MSEC:
