+		return
+	_send_route_plugin_entries_by_track = entries_by_track
+	_send_route_plugin_entries_signature = JSON.stringify(entries_by_track)
+	var kid := str(_bound_kernel_track_id).strip_edges()
+	if kid.is_empty():
+		return
+	_reload_bound_track_with_send_routes()
+
