[configuration]
entry_symbol = "vit_extension_library_init"
compatibility_minimum = "4.2"

[libraries]
windows.debug.x86_64 = "res://extension/bin/vit_extension.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://extension/bin/vit_extension.windows.template_release.x86_64.dll"
macos.debug.arm64 = "res://extension/bin/libvit_extension.macos.template_debug.arm64.dylib"
macos.release.arm64 = "res://extension/bin/libvit_extension.macos.template_release.arm64.dylib"
